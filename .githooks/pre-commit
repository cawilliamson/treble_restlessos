#!/usr/bin/env bash
#
# pre-commit hook: validate AOSP patch files before commit
#
# blocks commits that:
#   - miss the mandatory '-- ' mbox footer
#   - have bare filenames in 'diff --git a/' that live deeper in src/
#   - fail to apply cleanly against synced src/ repos (if available)
#
# install via: git config core.hooksPath .githooks
#

set -eo pipefail

PAT=""
EXIT=0

# ----- colour helpers ---------------------------------------------------------
R() { printf '\033[0;31m%s\033[0m\n' "$1"; }
G() { printf '\033[0;32m%s\033[0m\n' "$1"; }
Y() { printf '\033[0;33m%s\033[0m\n' "$1"; }

# ----- helper: map patch-dir name -> src repo path -------------------------
map_repo() {
    local name="$1"
    local path
    path=$(tr '_' '/' <<<"$name" | sed -e 's;platform/;;g')
    case "$path" in
        build)                path="build/make" ;;
        testing)              path="platform_testing" ;;
        treble/app)           path="treble_app" ;;
        vendor/hardware/overlay) path="vendor/hardware_overlay" ;;
        vendor/partner/gms)   path="vendor/partner_gms" ;;
    esac
    printf '%s' "$path"
}

# ----- get list of staged patch files ----------------------------------------
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.patch$' || true)
[ -z "$STAGED" ] && exit 0

# ----- 1. mbox footer check --------------------------------------------------
while IFS= read -r f; do
    if ! tail -c 20 "$f" | grep -q -- '^-- $'; then
        R "[BLOCKED] missing '-- ' mbox footer: $f"
        R '            fix: ensure patch ends with a line containing exactly "-- "'
        EXIT=1
    fi
    # also check for trailing newline after footer (git format-patch produces this)
    if [ "$(tail -c1 "$f" | wc -l)" -eq 0 ]; then
        R "[BLOCKED] patch file missing trailing newline: $f"
        EXIT=1
    fi
done <<< "$STAGED"

# ----- 2. diff-path sanity check ---------------------------------------------
while IFS= read -r f; do
    # extract project dir from path like patches/trebledroid/platform_system_vold/0001-foo.patch
    project_dir=$(dirname "$f" | sed 's|patches/[^/]*/||')
    src_path=$(map_repo "$project_dir")
    src_dir="src/$src_path"

    [ -d "$src_dir" ] || continue

    grep '^diff --git a/' "$f" | sed 's|^diff --git a/||; s/ b$/\n/; s/ b/ \n/' | awk '{print $1}' | while IFS= read -r file; do
        # bare filename?
        if [[ "$file" != */* ]]; then
            # does it NOT exist at root but DOES exist deeper?
            if [ ! -e "$src_dir/$file" ]; then
                if find "$src_dir" -name "$file" -type f -print -quit | grep -q .; then
                    Y "[WARN]  $f"
                    Y "        bare filename in diff --git a/$file"
                    Y "        file exists deeper in $src_dir/ but not at root"
                    Y "        this usually means the patch was generated from"
                    Y "        the wrong directory and will fail during build"
                fi
            fi
        fi
    done
    
    # check for suspicious bare filenames that don't exist anywhere
    grep '^diff --git a/' "$f" | sed 's|^diff --git a/||; s/ b$/\n/; s/ b/ \n/' | awk '{print $1}' | while IFS= read -r file; do
        if [[ "$file" != */* ]]; then
            if [ ! -e "$src_dir/$file" ] && ! find "$src_dir" -name "$file" -type f -print -quit | grep -q .; then
                R "[BLOCKED] $f"
                R "        diff --git a/$file references a file that does not exist"
                R "        anywhere in $src_dir (even recursively)"
                EXIT=1
            fi
        fi
    done
done <<< "$STAGED"

# ----- 3. smoke-test apply against synced src/ repos --------------------------
# only run if src/ looks synced (has at least one repo with a .git dir)
if [ -d "src" ] && find src -maxdepth 2 -name ".git" -type d | head -1 | grep -q .; then
    while IFS= read -r f; do
        project_dir=$(dirname "$f" | sed 's|patches/[^/]*/||')
        src_path=$(map_repo "$project_dir")
        src_dir="src/$src_path"
        [ -d "$src_dir/.git" ] || continue

        # determine base commit (first commit in shallow clone)
        base=$(cd "$src_dir" && git rev-list --max-parents=0 HEAD | tail -1)
        [ -z "$base" ] && continue

        (cd "$src_dir" && git reset --hard "$base" >/dev/null 2>&1) || continue

        if ! (cd "$src_dir" && git apply --check "$PWD/../../$f" </dev/null 2>/dev/null); then
            R "[BLOCKED] patch context does not apply cleanly against upstream"
            R "          $f -> $src_dir"
            R "          regenerate with git format-patch after resetting"
            R "          to upstream base and applying all preceding patches"
            EXIT=1
        fi
    done <<< "$STAGED"
fi

if [ "$EXIT" -ne 0 ]; then
    echo
    R "commit aborted due to patch validation errors."
    R "fix the issues above and retry."
    exit 1
fi

exit 0
