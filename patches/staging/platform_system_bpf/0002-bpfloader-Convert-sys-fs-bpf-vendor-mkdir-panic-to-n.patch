From f76d869c8301e7fabc65257387d470ce4fc59ff5 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 12 Mar 2026 23:49:06 +0000
Subject: [PATCH 2/2] bpfloader: Convert /sys/fs/bpf/vendor mkdir panic to
 non-fatal error

On devices without BPF filesystem support, /sys/fs/bpf/ may not be
mounted, causing create_dir to fail. Previously this triggered a
panic!() which terminates the process despite the custom panic hook
only logging the error.

Convert to error!() + early return, consistent with the existing
no-bpf-usecase patch philosophy. The vendorBpfLoader() call is
skipped since it would also fail without bpffs.

Change-Id: Ie1a2566602056d578c1188fab405455cfd9eb042
---
 loader/bpfloader.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index 50be931..172169c 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -679,7 +679,8 @@ fn main() {
     info!("Loading legacy BPF progs");
 
     if let Err(e) = create_dir(Path::new("/sys/fs/bpf/vendor")) {
-        panic!("Error during mkdir /sys/fs/bpf/vendor: {e}");
+        error!("Failed to mkdir /sys/fs/bpf/vendor: {e} -- BPF fs may not be mounted, skipping vendor BPF loading");
+        return;
     };
 
     // SAFETY: Linking in the existing legacy vendor bpfloader functionality.
