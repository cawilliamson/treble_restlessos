 CONFIG_IKCONFIG=y
 CONFIG_IKCONFIG_PROC=y
@@ -237,7 +236,6 @@ CONFIG_TASKSTATS=y
 CONFIG_TASK_IO_ACCOUNTING=y
 CONFIG_TASK_XACCT=y
 CONFIG_TIMERFD=y
-CONFIG_TRACE_GPU_MEM=y
 CONFIG_TTY=y
 CONFIG_TUN=y
 CONFIG_UHID=y
