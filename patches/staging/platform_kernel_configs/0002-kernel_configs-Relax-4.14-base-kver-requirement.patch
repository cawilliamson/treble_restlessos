 s/android-4.14/android-base-conditional.xml | 26 +--------------------
 s/android-4.14/android-base.config          |  2 --
 2 files changed, 1 insertion(+), 27 deletions(-)

diff --git a/s/android-4.14/android-base-conditional.xml b/s/android-4.14/android-base-conditional.xml
index f3fceb5..5812269 100644
