From c441caaa305b9f87342e6d0e484c4c866f8b4867 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 7 Mar 2026 20:21:04 +0000
Subject: [PATCH 5/9] Add safe lmkd defaults and heap floor for GSI builds

Disable critical_upgrade and enable kill_heaviest_task for more
predictable memory management across diverse hardware.

Also set a minimum dalvik.vm.heapgrowthlimit of 256m. Some vendor
build.prop files ship an aggressive 16m limit tuned for their stock ROM.
Android 16's system_server requires significantly more than 16m to
initialise; without this override rw-system.sh crashes early (empty vndk
var arithmetic) and the vendor value is never corrected, causing
system_server to OOM-loop and the device to be stuck on bootsplash.
---
 system.prop | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/system.prop b/system.prop
index f3c0c45..4649f0d 100644
--- a/system.prop
+++ b/system.prop
@@ -49,3 +49,15 @@ bluetooth.profile.sap.server.enabled?=true
 
 # Samsung vendors default to a Samsung-specific gadget for MTP. Set this to use AOSP's functionfs MTP
 vendor.usb.use_ffs_mtp=1
+
+# lmkd tuning: safe defaults for GSI across diverse hardware
+# Disable critical_upgrade to prevent overly aggressive kills on devices
+# where memory pressure detection may not work correctly (e.g., older kernels)
+ro.lmk.critical_upgrade=false
+# Kill heaviest task first for more predictable memory management
+ro.lmk.kill_heaviest_task=true
+
+# Heap floor: vendor build.prop values as low as 16m are seen in the wild.
+# Android 16 system_server needs ~200m+ to initialise; override with a safe
+# minimum while preserving larger vendor values via the ? default operator.
+dalvik.vm.heapgrowthlimit?=256m
+dalvik.vm.heapsize?=512m
-- 
