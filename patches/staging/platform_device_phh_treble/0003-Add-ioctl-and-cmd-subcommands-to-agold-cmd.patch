From 407ce81996730e85137b56b11fc095e800e00567 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 27 Feb 2026 11:23:55 +0000
Subject: [PATCH] Add ioctl, cmd, and proinfo subcommands to agold-cmd

Extend agold-cmd with ioctl, cmd, and proinfo subcommands for
controlling Unihertz 8849 hardware and reading factory calibration
from the proinfo partition.

The proinfo subcommand reads raw bytes at a given offset/length from
/dev/block/by-name/proinfo, strips null bytes, and prints the result.
This allows system_app to read factory calibration without needing
direct block device access (which requires vendor SELinux types).

Include agold-cmd in PRODUCT_PACKAGES so it ships in the GSI image.
---
 base.mk            |  3 ++-
 cmds/agold-cmd.cpp | 58 ++++++++++++++++++++++++++++++++++++++--------
 2 files changed, 50 insertions(+), 11 deletions(-)

diff --git a/base.mk b/base.mk
index a29e402..9314eba 100644
--- a/base.mk
+++ b/base.mk
@@ -147,7 +147,8 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     lightsctl \
     lightsctl-aidl \
-    uevent
+    uevent \
+    agold-cmd
 
 PRODUCT_COPY_FILES += \
     device/phh/treble/files/adbd.rc:system/etc/init/adbd.rc
diff --git a/cmds/agold-cmd.cpp b/cmds/agold-cmd.cpp
index 9943557..40a9c48 100644
--- a/cmds/agold-cmd.cpp
+++ b/cmds/agold-cmd.cpp
@@ -1,22 +1,60 @@
 #include <iostream>
+#include <fstream>
 #include <vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.h>
+#include <vendor/mediatek/hardware/agolddaemon/BnAgoldDaemonCallback.h>
 #include <binder/IServiceManager.h>
+#include <utils/String8.h>
 
 using ::vendor::mediatek::hardware::agolddaemon::IAgoldDaemon;
+using ::vendor::mediatek::hardware::agolddaemon::BnAgoldDaemonCallback;
 using ::android::sp;
 
-int main(int argc, char **argv) {
+class AgoldDaemonCallback : public BnAgoldDaemonCallback {
+    public:
+        ::android::binder::Status onResult(const ::android::String16& result) override {
+            std::cout << "Result: " << ::android::String8(result).c_str() << std::endl;
+            return ::android::binder::Status::ok();
+        }
+};
+
+int main(int argc [[maybe_unused]], char **argv) {
 	auto svc = android::checkVintfService<IAgoldDaemon>();
-    android::String16 a;
-    svc->getNotGsi(&a);
-    std::cout << "notgsi is " << a << std::endl;
-    if (argc >= 2) {
-        android::String16 b(argv[1]);
-        svc->setNotGsi(b);
-    }
-    svc->getNotGsi(&a);
-    std::cout << "notgsi is " << a << std::endl;
+    int32_t ret = 0;
 
+    // Always set NotGsi and camera package name on startup
+    svc->setNotGsi(android::String16("NotGsi"));
     svc->setCameraClientPackageName(android::String16("com.mediatek.camera"));
 
+    if (argc < 2) {
+        return 0;
+    }
+
+    if (std::string(argv[1]) == "ioctl") {
+        svc->SendMessageToIoctl(atoi(argv[2]), atoi(argv[3]), atoi(argv[4]), atoi(argv[5]), &ret);
+    } else if (std::string(argv[1]) == "cmd") {
+        sp<AgoldDaemonCallback> cb = new AgoldDaemonCallback();
+        svc->cmd(android::String16(argv[2]), cb);
+    } else if (std::string(argv[1]) == "proinfo" && argc >= 4) {
+        // Read raw bytes from proinfo partition.
+        // Usage: agold-cmd proinfo <offset> <length>
+        long offset = atol(argv[2]);
+        int length = atoi(argv[3]);
+        std::ifstream f("/dev/block/by-name/proinfo", std::ios::binary);
+        if (f.good()) {
+            f.seekg(offset);
+            std::string buf(length, '\0');
+            f.read(&buf[0], length);
+            // Strip null bytes and print
+            std::string out;
+            for (char c : buf) {
+                if (c != '\0') out += c;
+            }
+            printf("%s\n", out.c_str());
+            return 0;
+        } else {
+            fprintf(stderr, "Failed to open proinfo\n");
+            return 1;
+        }
+    }
+    printf("Returned %d\n", ret);
 }
-- 
