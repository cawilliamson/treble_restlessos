--- /dev/null
+++ b/app/src/main/java/me/phh/treble/app/ProjectorSettings.kt
@@ -0,0 +1,59 @@
+package me.phh.treble.app
+
+import android.os.Bundle
+import android.os.ServiceManager
+import android.util.Log
+import vendor.mediatek.hardware.agolddaemon.IAgoldDaemon
+import java.io.File
+
+object ProjectorSettings : Settings {
+    val projectorEnabled = "projector_enabled"
+    val projectorMode = "projector_mode"
+    val displayEnabled = "projector_display_enabled"
+    val brightness = "projector_brightness"
+    val keystone = "projector_keystone"
+    val focusCalibration = "projector_focus_calibration"
+    val focusAdjust = "projector_focus_adjust"
+    val fanSpeed = "projector_fan_speed"
+
+    override fun enabled(): Boolean {
+        try {
+            val binder = ServiceManager.checkService(IAgoldDaemon.DESCRIPTOR + "/default")
+            if (binder == null) return false
+            return File("/sys/bus/spi/drivers/fpga_spi/projector_sys_status").exists()
+        } catch (t: Throwable) {
+            Log.d("PHH", "Projector detection failed", t)
+            return false
+        }
+    }
+}
+
+class ProjectorSettingsFragment : SettingsFragment() {
+    override val preferencesResId = R.xml.pref_projector
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        super.onCreatePreferences(savedInstanceState, rootKey)
+
+        // Show temperature as a read-only summary
+        val tempPref = findPreference<androidx.preference.Preference>("projector_temp_display")
+        try {
+            val temp = File("/sys/bus/spi/drivers/fpga_spi/projector_temp").readText().trim()
+            tempPref?.summary = "${temp}\u00B0C"
+        } catch (t: Throwable) {
+            tempPref?.isVisible = false
+        }
+
+        // Show laser distance as a read-only summary, hide if hardware absent
+        val laserPref = findPreference<androidx.preference.Preference>("projector_laser_display")
+        if (!File("/sys/nds03_ctrl/nds03_read").exists()) {
+            laserPref?.isVisible = false
+        } else {
+            try {
+                val distance = File("/sys/nds03_ctrl/nds03_read").readText().trim()
+                laserPref?.summary = "${distance} mm"
+            } catch (t: Throwable) {
+                laserPref?.isVisible = false
+            }
+        }
+    }
+}
