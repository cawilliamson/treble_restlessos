diff --git a/app/src/main/res/xml/pref_projector.xml b/app/src/main/res/xml/pref_projector.xml
new file mode 100644
index 0000000..0644451
--- /dev/null
+++ b/app/src/main/res/xml/pref_projector.xml
@@ -0,0 +1,70 @@
+<?xml version="1.0" encoding="utf-8"?>
+<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:android="http://schemas.android.com/apk/res/android">
+    <PreferenceCategory android:title="Projector">
+        <CheckBoxPreference
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:defaultValue="false"
+            android:key="projector_enabled"
+            android:title="Enable projector"
+            app:summary="Turn on the built-in projector" />
+        <ListPreference
+            android:defaultValue="3"
+            android:entries="@array/pref_projector_mode"
+            android:entryValues="@array/pref_projector_mode_values"
+            android:key="projector_mode"
+            android:title="Projection mode"
+            app:summary="Orientation and aspect ratio" />
+        <CheckBoxPreference
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:defaultValue="true"
+            android:key="projector_display_enabled"
+            android:title="Display"
+            app:summary="Keep the phone display on while projecting" />
+    </PreferenceCategory>
+    <PreferenceCategory android:title="Image">
+        <EditTextPreference
+            android:defaultValue="128"
+            android:key="projector_brightness"
+            android:title="Brightness"
+            app:summary="Projector brightness (1-255)" />
+        <EditTextPreference
+            android:defaultValue="0"
+            android:key="projector_keystone"
+            android:title="Keystone correction"
+            app:summary="Adjust keystone pitch" />
+    </PreferenceCategory>
+    <PreferenceCategory android:title="Focus">
+        <EditTextPreference
+            android:defaultValue="550,720,711,696,685,672,663,649,638,626,614,599,587,561,548,538,538"
+            android:key="projector_focus_calibration"
+            android:title="Auto focus calibration"
+            app:summary="Comma-separated calibration values for auto focus motor" />
+        <EditTextPreference
+            android:defaultValue="0"
+            android:key="projector_focus_adjust"
+            android:title="Manual focus adjustment"
+            app:summary="Relative focus motor step (e.g. +10 or -10)" />
+    </PreferenceCategory>
+    <PreferenceCategory android:title="Hardware">
+        <EditTextPreference
+            android:defaultValue="50"
+            android:key="projector_fan_speed"
+            android:title="Fan speed"
+            app:summary="Fan speed (0-100)" />
+        <Preference
+            android:key="projector_temp_display"
+            android:title="Projector temperature"
+            android:selectable="false"
+            app:summary="Reading..." />
+    </PreferenceCategory>
+    <PreferenceCategory android:title="Laser ranging">
+        <Preference
+            android:key="projector_laser_display"
+            android:title="Distance measurement"
+            android:selectable="false"
+            app:summary="Reading..." />
+    </PreferenceCategory>
+</PreferenceScreen>
