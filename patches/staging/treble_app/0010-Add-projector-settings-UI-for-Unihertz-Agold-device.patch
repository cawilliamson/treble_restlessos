diff --git a/app/src/main/java/me/phh/treble/app/Projector.kt b/app/src/main/java/me/phh/treble/app/Projector.kt
new file mode 100644
index 0000000..5cca21c
--- /dev/null
+++ b/app/src/main/java/me/phh/treble/app/Projector.kt
@@ -0,0 +1,114 @@
+package me.phh.treble.app
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.ServiceManager
+import android.preference.PreferenceManager
+import android.util.Log
+import vendor.mediatek.hardware.agolddaemon.IAgoldDaemon
+import java.io.File
+
+object Projector : EntryStartup {
+    private const val SYSFS_BASE = "/sys/bus/spi/drivers/fpga_spi"
+    private const val DEFAULT_CALIBRATION = "550,720,711,696,685,672,663,649,638,626,614,599,587,561,548,538,538"
+
+    fun writeToFileNofail(path: String, content: String) {
+        try {
+            File(path).printWriter().use { it.println(content) }
+        } catch (t: Throwable) {
+            Log.d("PHH", "Failed writing to $path", t)
+        }
+    }
+
+    private fun getAgoldService(): IAgoldDaemon? {
+        return try {
+            val binder = android.os.Binder.allowBlocking(
+                ServiceManager.waitForDeclaredService(IAgoldDaemon.DESCRIPTOR + "/default"))
+            IAgoldDaemon.Stub.asInterface(binder)
+        } catch (t: Throwable) {
+            Log.d("PHH", "Failed to get Agold service", t)
+            null
+        }
+    }
+
+    private fun sendIoctl(a: Int, b: Int, c: Int, d: Int): Int {
+        val svc = getAgoldService() ?: return -1
+        return try {
+            svc.SendMessageToIoctl(a, b, c, d)
+        } catch (t: Throwable) {
+            Log.d("PHH", "SendMessageToIoctl($a, $b, $c, $d) failed", t)
+            -1
+        }
+    }
+
+    private fun sendCalibration(sp: SharedPreferences) {
+        val calibration = sp.getString(ProjectorSettings.focusCalibration, DEFAULT_CALIBRATION) ?: DEFAULT_CALIBRATION
+        val svc = getAgoldService() ?: return
+        try {
+            svc.cmd(calibration, null)
+            Log.d("PHH", "Projector focus calibration sent: $calibration")
+        } catch (t: Throwable) {
+            Log.d("PHH", "Focus calibration failed", t)
+        }
+    }
+
+    val spListener = SharedPreferences.OnSharedPreferenceChangeListener { sp, key ->
+        when (key) {
+            ProjectorSettings.projectorEnabled -> {
+                val enabled = sp.getBoolean(key, false)
+                if (enabled) {
+                    // Send focus calibration before enabling projector
+                    sendCalibration(sp)
+                    val mode = sp.getString(ProjectorSettings.projectorMode, "3") ?: "3"
+                    sendIoctl(500, 0, mode.toInt(), 0)
+                } else {
+                    sendIoctl(500, 0, 0, 0)
+                }
+            }
+            ProjectorSettings.projectorMode -> {
+                val enabled = sp.getBoolean(ProjectorSettings.projectorEnabled, false)
+                if (enabled) {
+                    val mode = sp.getString(key, "3") ?: "3"
+                    sendIoctl(500, 0, mode.toInt(), 0)
+                }
+            }
+            ProjectorSettings.displayEnabled -> {
+                val enabled = sp.getBoolean(key, true)
+                if (enabled) {
+                    sendIoctl(500, 0, 0, 3)
+                } else {
+                    sendIoctl(500, 0, 0, 4)
+                }
+            }
+            ProjectorSettings.brightness -> {
+                val value = sp.getString(key, "128") ?: "128"
+                writeToFileNofail("$SYSFS_BASE/projector_rgb_current", value)
+            }
+            ProjectorSettings.keystone -> {
+                val value = sp.getString(key, "0") ?: "0"
+                writeToFileNofail("$SYSFS_BASE/projector_pitch_set", value)
+            }
+            ProjectorSettings.focusCalibration -> {
+                sendCalibration(sp)
+            }
+            ProjectorSettings.focusAdjust -> {
+                val value = sp.getString(key, "0") ?: "0"
+                writeToFileNofail("$SYSFS_BASE/motor_turn_mode_step", value)
+            }
+            ProjectorSettings.fanSpeed -> {
+                val value = sp.getString(key, "50") ?: "50"
+                writeToFileNofail("$SYSFS_BASE/projector_fan_en", value)
+            }
+        }
+    }
+
+    override fun startup(ctxt: Context) {
+        if (!ProjectorSettings.enabled()) return
+
+        val sp = PreferenceManager.getDefaultSharedPreferences(ctxt)
+        sp.registerOnSharedPreferenceChangeListener(spListener)
+
+        // Refresh fan speed on boot (don't auto-enable projector on boot)
+        spListener.onSharedPreferenceChanged(sp, ProjectorSettings.fanSpeed)
+    }
+}
diff --git a/app/src/main/java/me/phh/treble/app/ProjectorSettings.kt b/app/src/main/java/me/phh/treble/app/ProjectorSettings.kt
new file mode 100644
