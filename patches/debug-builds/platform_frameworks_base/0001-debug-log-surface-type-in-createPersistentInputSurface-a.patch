From 1b720d5d4b31b12e9630951f832f1c0c849b1e6b Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 21 Jun 2026 06:04:20 +0100
Subject: [PATCH] debug: log surface type in createPersistentInputSurface and
 setInputSurface
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

diagnostic patch for issue #33. logs the full chain:
- Java: createPersistentInputSurface return value (class, isPersistent, hashCode)
- Java: setInputSurface surface argument (class, isPersistent, hashCode)
- JNI: each null-check failure point in native_createPersistentInputSurface

comparing hashCodes tells us whether the surface passed to setInputSurface
is the same object returned by createPersistentInputSurface, or if it was
replaced by something else (e.g. the camera framework providing a regular
Surface to the CameraX SurfaceInput before getSurface runs).

debug-builds only — do not ship.
---
 media/java/android/media/MediaCodec.java | 11 ++++++++++-
 media/jni/android_media_MediaCodec.cpp   |  5 +++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/media/java/android/media/MediaCodec.java b/media/java/android/media/MediaCodec.java
index fc4dbb22d..42871c0cd 100644
--- a/media/java/android/media/MediaCodec.java
+++ b/media/java/android/media/MediaCodec.java
@@ -2704,7 +2704,12 @@ final public class MediaCodec {
      */
     @NonNull
     public static Surface createPersistentInputSurface() {
-        return native_createPersistentInputSurface();
+        Surface s = native_createPersistentInputSurface();
+        Log.w(TAG, "createPersistentInputSurface: returned=" + s
+                + " class=" + (s != null ? s.getClass().getName() : "null")
+                + " isPersistent=" + (s instanceof PersistentSurface)
+                + " hashCode=" + (s != null ? s.hashCode() : -1));
+        return s;
     }
 
     static class PersistentSurface extends Surface {
@@ -2731,6 +2736,10 @@ final public class MediaCodec {
      *           {@link #createPersistentInputSurface}.
      */
     public void setInputSurface(@NonNull Surface surface) {
+        Log.w(TAG, "setInputSurface: surface=" + surface
+                + " class=" + (surface != null ? surface.getClass().getName() : "null")
+                + " isPersistent=" + (surface instanceof PersistentSurface)
+                + " hashCode=" + (surface != null ? surface.hashCode() : -1));
         if (!(surface instanceof PersistentSurface)) {
             throw new IllegalArgumentException("not a PersistentSurface");
         }
diff --git a/media/jni/android_media_MediaCodec.cpp b/media/jni/android_media_MediaCodec.cpp
index 58113da5e..81253f16f 100644
--- a/media/jni/android_media_MediaCodec.cpp
+++ b/media/jni/android_media_MediaCodec.cpp
@@ -1934,14 +1934,19 @@ static jobject android_media_MediaCodec_createPersistentInputSurface(
         MediaCodec::CreatePersistentInputSurface();
 
     if (persistentSurface == NULL) {
+        ALOGE("createPersistentInputSurface JNI: CreatePersistentInputSurface returned NULL");
         return NULL;
     }
+    ALOGE("createPersistentInputSurface JNI: got PersistentSurface type=%d surface=%p",
+          persistentSurface->getType(), persistentSurface->getSurface().get());
 
     sp<Surface> surface = mediaflagtools::surfaceTypeToSurface(
         persistentSurface->getSurface(), true);
     if (surface == NULL) {
+        ALOGE("createPersistentInputSurface JNI: surfaceTypeToSurface returned NULL");
         return NULL;
     }
+    ALOGE("createPersistentInputSurface JNI: surface converted OK surface=%p", surface.get());
 
     jobject object = env->NewObject(
             gPersistentSurfaceClassInfo.clazz,
-- 
2.54.0

