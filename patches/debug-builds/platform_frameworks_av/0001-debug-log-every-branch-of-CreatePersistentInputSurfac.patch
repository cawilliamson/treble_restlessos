From 2b35ecb4380cd6dbc0f56c4a59ee60e169167e05 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 21 Jun 2026 06:10:44 +0100
Subject: [PATCH] debug: log every branch of CreatePersistentInputSurface /
 CreateInputSurface

log each step of the persistent input surface creation chain:
- CCodec::CreateInputSurface: Codec2Client result, AIDL initCheck, final
- MediaCodec::CreatePersistentInputSurface: CCodec result, OMX fallback

debug-builds only.
---
 media/codec2/sfplugin/CCodec.cpp    | 8 ++++++--
 media/libstagefright/MediaCodec.cpp | 5 ++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/media/codec2/sfplugin/CCodec.cpp b/media/codec2/sfplugin/CCodec.cpp
index 292e9ab..1dce224 100644
--- a/media/codec2/sfplugin/CCodec.cpp
+++ b/media/codec2/sfplugin/CCodec.cpp
@@ -3435,21 +3435,24 @@ PersistentSurface *CCodec::CreateInputSurface(const std::shared_ptr<Codec2Client
         }
     }
     if (inputSurface) {
+        ALOGE("CCodec::CreateInputSurface: Codec2Client returned non-null");
         ::ndk::SpAIBinder interface = inputSurface->getHalInterface();
         ANativeWindow *window = inputSurface->getNativeWindow();
         return new PersistentSurface(PersistentSurface::TYPE_INPUTSURFACE,
                 mediaflagtools::nativeWindowToSurfaceType(window),
                 interface);
     }
+    ALOGE("CCodec::CreateInputSurface: Codec2Client returned null, c2inputsurface=%d",
+          property_get_int32("debug.stagefright.c2inputsurface", 0));
     if (property_get_int32("debug.stagefright.c2inputsurface", 0) == -1) {
         sp<IGraphicBufferProducer> gbp;
         sp<AidlGraphicBufferSource> gbs = new AidlGraphicBufferSource();
         status_t err = gbs->initCheck();
         if (err != OK) {
-            ALOGE("Failed to create persistent input surface: error %d", err);
+            ALOGE("CCodec::CreateInputSurface: AIDL GraphicBufferSource initCheck failed: error %d", err);
             return nullptr;
         }
-        ALOGD("aidl based PersistentSurface created");
+        ALOGE("CCodec::CreateInputSurface: AIDL GraphicBufferSource initCheck OK, creating PersistentSurface");
         std::shared_ptr<WAidlGraphicBufferSource> wrapper =
                 ::ndk::SharedRefBase::make<WAidlGraphicBufferSource>(gbs);
 
@@ -3459,6 +3462,7 @@ PersistentSurface *CCodec::CreateInputSurface(const std::shared_ptr<Codec2Client
               mediaflagtools::igbpToSurfaceType(gbs->getIGraphicBufferProducer()),
               wrapper->asBinder());
     } else {
+        ALOGE("CCodec::CreateInputSurface: c2inputsurface != -1, returning null");
         return nullptr;
     }
 }
diff --git a/media/libstagefright/MediaCodec.cpp b/media/libstagefright/MediaCodec.cpp
index ccd7790..dd7d72a 100644
--- a/media/libstagefright/MediaCodec.cpp
+++ b/media/libstagefright/MediaCodec.cpp
@@ -1344,8 +1344,10 @@ sp<MediaCodec> MediaCodec::CreateByComponentName(
 sp<PersistentSurface> MediaCodec::CreatePersistentInputSurface() {
     sp<PersistentSurface> pluginSurface = CCodec::CreateInputSurface();
     if (pluginSurface != nullptr) {
+        ALOGE("CreatePersistentInputSurface: CCodec returned non-null type=%d", pluginSurface->getType());
         return pluginSurface;
     }
+    ALOGE("CreatePersistentInputSurface: CCodec returned null, trying OMX fallback");
 
     OMXClient client;
     if (client.connect() != OK) {
@@ -1360,9 +1362,10 @@ sp<PersistentSurface> MediaCodec::CreatePersistentInputSurface() {
 
     status_t err = omx->createInputSurface(&surface, &bufferSource);
     if (err != OK) {
-        ALOGE("Failed to create persistent input surface.");
+        ALOGE("Failed to create persistent input surface. err=%d", err);
         return NULL;
     }
+    ALOGE("CreatePersistentInputSurface: OMX fallback succeeded");
 
     return new PersistentSurface(surface, bufferSource);
 }
-- 
