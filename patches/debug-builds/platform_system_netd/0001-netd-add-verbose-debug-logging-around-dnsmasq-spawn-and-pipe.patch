From d9b578d1ebf17aa252028bbc5e7ef2de3d0f0068 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 24 May 2026 17:34:25 +0100
Subject: [PATCH] netd: add verbose debug logging around dnsmasq spawn and pipe
 communication

Log dnsmasq pid after posix_spawn, track mDaemonFd value, and
log exact write errno when pipe communication fails. This helps
diagnose why dnsmasq exits immediately after spawn on some devices.

This is debug-builds only.

Issue: #14
---
 server/TetherController.cpp | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/server/TetherController.cpp b/server/TetherController.cpp
index 2ee70af..320797f 100644
--- a/server/TetherController.cpp
+++ b/server/TetherController.cpp
@@ -137,13 +137,22 @@ const std::string GET_TETHER_STATS_COMMAND = StringPrintf(
 int TetherController::DnsmasqState::sendCmd(int daemonFd, const std::string& cmd) {
     if (cmd.empty()) return 0;
 
-    gLog.log("Sending update msg to dnsmasq [%s]", cmd.c_str());
+    // Check if dnsmasq is still alive before sending
+    if (daemonFd == -1) {
+        ALOGE("DNSMASQ_DEBUG: sendCmd called with fd=-1, dnsmasq never started");
+        return -1;
+    }
+
+    gLog.log("Sending update msg to dnsmasq [%s] on fd=%d", cmd.c_str(), daemonFd);
     // Send the trailing \0 as well.
-    if (write(daemonFd, cmd.c_str(), cmd.size() + 1) < 0) {
-        gLog.error("Failed to send update command to dnsmasq (%s)", strerror(errno));
+    ssize_t written = write(daemonFd, cmd.c_str(), cmd.size() + 1);
+    if (written < 0) {
+        gLog.error("Failed to send update command to dnsmasq (fd=%d errno=%d %s)", daemonFd, errno, strerror(errno));
+        ALOGE("DNSMASQ_DEBUG: write to dnsmasq pipe FAILED: fd=%d errno=%d %s", daemonFd, errno, strerror(errno));
         errno = EREMOTEIO;
         return -1;
     }
+    gLog.log("DNSMASQ_DEBUG: wrote %zd bytes to dnsmasq on fd=%d", written, daemonFd);
     return 0;
 }
 
@@ -304,7 +313,9 @@ int TetherController::startTethering(bool usingLegacyDnsProxy, int num_addrs, ch
         return -res;
     }
     mDaemonPid = pid;
+    ALOGE("DNSMASQ_DEBUG: spawned dnsmasq pid=%d", (int)pid);
     mDaemonFd = pipeWrite.release();
+    ALOGE("DNSMASQ_DEBUG: mDaemonFd set to %d", mDaemonFd);
     configureForTethering(true);
     mIsTetheringStarted = true;
     applyDnsInterfaces();
-- 
