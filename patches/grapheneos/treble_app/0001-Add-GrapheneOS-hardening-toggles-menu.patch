index 0000000..ce79f0a
--- /dev/null
+++ b/app/src/main/java/me/phh/treble/app/GrapheneOSSettings.kt
@@ -0,0 +1,12 @@
+package me.phh.treble.app
+
+object GrapheneOSSettings : Settings {
+    val mteVendor = "key_grapheneos_mte_vendor"
+    val stackHardening = "key_grapheneos_stack_hardening"
+
+    override fun enabled() = true
+}
+
+class GrapheneOSSettingsFragment : SettingsFragment() {
+    override val preferencesResId = R.xml.pref_grapheneos
+}
