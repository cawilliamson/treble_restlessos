From d3ad588f2eca79120e0705379abf3054b9df27bb Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 12 Jun 2026 11:17:16 +0100
Subject: [PATCH] securize: add property handler for persist.sys.phh.securize

the treble_app toggle sets persist.sys.phh.securize which triggers
this handler to create or remove /metadata/securize_disable. the
actual prop spoofing (fingerprint override, build tags, vbmeta state)
is done by rw-system.sh and phh-on-boot.sh at boot time, so no
reboot is needed when toggling the switch.

this handler is release-builds only -- debug builds don't securize.
---
 phh-prop-handler.sh | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/phh-prop-handler.sh b/phh-prop-handler.sh
index d036f24..be44a1b 100644
--- a/phh-prop-handler.sh
+++ b/phh-prop-handler.sh
@@ -281,3 +281,15 @@ if [ "$1" == "persist.bluetooth.system_audio_hal.enabled" ]; then
     restartAudio
     exit
 fi
+
+if [ "$1" == "persist.sys.phh.securize" ]; then
+    if [[ "$prop_value" != "0" && "$prop_value" != "1" ]]; then
+        exit 1
+    fi
+    if [[ "$prop_value" == "0" ]]; then
+        touch /metadata/securize_disable
+    else
+        rm -f /metadata/securize_disable
+    fi
+    exit
+fi
-- 
