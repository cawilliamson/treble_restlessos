diff --git a/phh-device-props.sh b/phh-device-props.sh
new file mode 100755
index 0000000..e833066
--- /dev/null
+++ b/phh-device-props.sh
@@ -0,0 +1,80 @@
+#!/system/bin/sh
+
+# runs on early-fs: vendor tee daemons read the device name once when they
+# start on fs, and microtrust tees reject tas when it is the gsi's
+
+[ -f /metadata/securize_disable ] && exit 0
+
+# the device's own product partition first, then odm and vendor
+device_prop() {
+    # xiaomi's shared vendor/product images keep the real device in odm
+    case "$(getprop ro.product.vendor.manufacturer)" in
+        [Xx]iaomi)
+            value="$(getprop ro.product.odm."$1")"
+            if [ "$value" ]; then
+                echo "$value"
+                return
+            fi
+            ;;
+    esac
+    if [ "$product_build_prop" ]; then
+        for key in ro.product.product."$1" ro.product."$1"; do
+            value="$(grep "^$key=" "$product_build_prop" | head -n 1 | cut -d = -f 2-)"
+            if [ "$value" ]; then
+                echo "$value"
+                return
+            fi
+        done
+    fi
+    for partition in ro.product.odm ro.product.vendor ro.vendor.product; do
+        value="$(getprop "$partition.$1")"
+        if [ "$value" ]; then
+            echo "$value"
+            return
+        fi
+    done
+}
+
+copy_device_prop() {
+    value="$(device_prop "$1")"
+    [ "$value" ] || return
+    shift
+    for target in "$@"; do
+        resetprop_phh "$target" "$value"
+    done
+}
+
+# /product can be the GSI's own, read the device's product partition directly
+product_build_prop=
+slot="$(getprop ro.boot.slot_suffix)"
+for dev in /dev/block/mapper/product"$slot" /dev/block/mapper/product \
+        /dev/block/by-name/product"$slot" /dev/block/by-name/product; do
+    [ -b "$dev" ] || continue
+    mkdir -p /mnt/phh/product_part
+    if mount -o ro "$dev" /mnt/phh/product_part; then
+        for f in /mnt/phh/product_part/etc/build.prop /mnt/phh/product_part/build.prop; do
+            if [ -f "$f" ]; then
+                cp "$f" /mnt/phh/product_build.prop
+                product_build_prop=/mnt/phh/product_build.prop
+                break
+            fi
+        done
+        umount /mnt/phh/product_part
+    fi
+    rmdir /mnt/phh/product_part
+    break
+done
+
+copy_device_prop device \
+    ro.product.device ro.product.system.device ro.product.system_ext.device ro.product.product.device \
+    ro.build.device ro.build.product
+copy_device_prop name \
+    ro.product.name ro.product.system.name ro.product.system_ext.name ro.product.product.name
+copy_device_prop brand \
+    ro.product.brand ro.product.system.brand ro.product.system_ext.brand ro.product.product.brand \
+    ro.system.product.brand
+copy_device_prop model \
+    ro.product.model ro.product.system.model ro.product.system_ext.model ro.product.product.model
+copy_device_prop manufacturer \
+    ro.product.manufacturer ro.product.system.manufacturer ro.product.system_ext.manufacturer ro.product.product.manufacturer \
+    ro.system.product.manufacturer
