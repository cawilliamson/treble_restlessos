From e2b4ab4f239022bbcc404dbdbbb882a2348d5f61 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 25 Sep 2026 18:25:53 +0100
Subject: [PATCH 19/33] rw-system: block OPPO/Realme root detection reboot and
 disable touch firmware update on MT6771

OPPO and Realme devices with MediaTek vendor kernels include an
oppo_root_check kernel module or init service that detects an unlocked
bootloader and forces a reboot to recovery. Set ro.boot.flash.locked,
ro.boot.vbmeta.device_state and ro.boot.verifiedbootstate to
locked/green in rw-system.sh during post-fs, before vendor init
services run. Also spoof warranty_bit properties and attempt to stop
the oppo_root_check init service. Only apply the bypass when the
vendor partition actually contains an oppo_root_check init service --
custom ROM vendors often remove it, and the property spoofing causes a
~100s boot delay on those devices. Fixes: #38, #69

Also disable the OPPO touch firmware update on MT6771: the OPPO F11
(CPH1911, MT6771/Helio P70) bootloops because the touchscreen driver
(td4320_nf) triggers a kernel panic during firmware change, after
which the MediaTek watchdog (toprgu) hard-resets. The driver reads a
firmware update flag from sysfs/proc nodes the vendor can control; for
OPPO/Realme MediaTek devices, write 0 to any known touch firmware
update sysfs/proc nodes during rw-system.sh (post-fs) to prevent the
firmware change. Best-effort mitigation. Fixes: #45

Combines the former 'Block OPPO/Realme root detection reboot on GSI
boot' and 'rw-system: disable OPPO touch firmware update on MT6771 to
prevent kernel panic' patches.
---
 rw-system.sh | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/rw-system.sh b/rw-system.sh
index d44b23b..f36bdf4 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -375,6 +375,17 @@ for part in /dev/block/bootdevice/by-name/oppodycnvbk  /dev/block/platform/bootd
     fi
 done
 
+# Disable touch firmware update on OPPO/Realme MTK devices to prevent
+# kernel panic from td4320_nf driver during boot.  The driver triggers
+# a kernel panic during firmware change on some devices (notably OPPO F11
+# CPH1911 MT6771).  Writing 0 to the firmware update flag prevents the
+# driver from attempting the update.
+for node in /proc/touchpanel/fw_update /sys/devices/platform/tpd/fw_update; do
+    if [ -f "$node" ]; then
+        echo 0 > "$node" 2>/dev/null
+        log -t rw-system "Disabled touch fw update at $node"
+    fi
+done
 
 mkdir -p /mnt/phh/
 mount -t tmpfs -o rw,nodev,relatime,mode=755,gid=0 none /mnt/phh || true
@@ -800,6 +811,29 @@ copyprop() {
         resetprop_phh "$1" "$(getprop "$2")"
     fi
 }
+
+# OPPO/Realme devices with MTK vendor kernels include an oppo_root_check
+# kernel module or init service that detects an unlocked bootloader and forces
+# a reboot to recovery.  set the boot-state properties to "locked" so any
+# userspace component of the check sees a locked device.
+#
+# only apply the bypass if the vendor actually contains the root-check
+# service. custom ROM vendors (e.g. InfinityX) often remove this service,
+# and the property spoofing causes a ~100s boot delay on those devices.
+brand="$(getprop ro.product.vendor.brand)"
+if [ "$brand" = OPPO ] || [ "$brand" = realme ]; then
+    if grep -r -q "oppo_root_check" /vendor/etc/init/ 2>>/dev/null; then
+        resetprop_phh ro.boot.flash.locked 1
+        resetprop_phh ro.boot.vbmeta.device_state locked
+        resetprop_phh ro.boot.verifiedbootstate green
+        resetprop_phh ro.boot.warranty_bit 0
+        resetprop_phh ro.vendor.warranty_bit 0
+        resetprop_phh ro.warranty_bit 0
+        resetprop_phh -n sys.oem_unlock_allowed 0
+        setprop ctl.stop oppo_root_check 2>>/dev/null
+    fi
+fi
+
 if [ -f /system/phh/secure ] || [ -f /metadata/phh/secure ];then
     copyprop ro.build.device ro.vendor.build.device
     copyprop ro.system.build.fingerprint ro.vendor.build.fingerprint
-- 
