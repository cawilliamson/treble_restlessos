From: Pierre-Hugues Husson <phh@phh.me>
Date: Sun, 5 Apr 2020 16:32:46 +0200
Subject: [PATCH 11/55] Always allow overriding the number of work profiles

Change-Id: I6eb09aa71663c6fbe7563e3038bffcabdba0ff6a
---
 .../core/java/com/android/server/pm/UserTypeFactory.java     | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/services/core/java/com/android/server/pm/UserTypeFactory.java b/services/core/java/com/android/server/pm/UserTypeFactory.java
index 1941d2a2a..7465c4613 100644
--- a/services/core/java/com/android/server/pm/UserTypeFactory.java
+++ b/services/core/java/com/android/server/pm/UserTypeFactory.java
@@ -615,11 +615,10 @@ public final class UserTypeFactory {
     /** Returns the number of managed profiles allowed, virtually always 1. */
     private static int getMaxManagedProfiles() {
         final int normalValue = 1;
-        if (!Build.IS_DEBUGGABLE) {
-            return normalValue;
-        } else {
+        if (userTypeDetails.isManagedProfile()) {
             return SystemProperties.getInt("persist.sys.max_profiles", normalValue);
         }
+        return normalValue;
     }

     /**
