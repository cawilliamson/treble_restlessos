From d1ccda3cd00dcbc3e2b1e71012886e03f64a6b50 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 21 Jun 2026 23:58:54 +0100
Subject: [PATCH 11/11] treble_app: run EntryService as a freezer-exempt foreground
 service

device-specific sensor listeners (e.g. motorola chop-chop flashlight,
handwave/pocket doze) are registered from the treble_app process. as a
plain service the process becomes cached once onStartCommand returns,
so the android app freezer suspends it while the screen is off -- and
the gestures stop working until the user opens treble settings again
(which unfreezes the process). android:persistent only exempts user 0,
and the app runs under the booted user (e.g. user 10), so it is still
subject to the freezer.

promote EntryService to a foreground service with a low-importance
ongoing notification so the process stays unfrozen and the listeners
keep firing when locked/backgrounded. requires startForegroundServiceAsUser
at the boot receiver.

declare foregroundServiceType="connectedDevice" and the
FOREGROUND_SERVICE_CONNECTED_DEVICE + CHANGE_WIFI_STATE permissions.
android 16 enforces the foreground service type requirement for the
system shared uid (the FGS_TYPE_NONE compat change is evaluated against
the platform targetSdk, not the app's own targetSdk 33), so a typeless
startForeground throws MissingForegroundServiceTypeException and crashes
the app in a loop. connectedDevice is an sdk-33-valid type whose policy
is never disabled, and the platform-signed system uid satisfies its
anyOf permission gate via the auto-granted CHANGE_WIFI_STATE normal
permission.

the persistent foreground-service notification is hidden at the system
level by the companion frameworks/base patch (rom 0008), which forces the
notification record importance to NONE for me.phh.treble.app -- the
notification is still posted so the fgs stays foreground, it is just not
displayed.
---
 app/src/main/AndroidManifest.xml              | 13 ++++----
 .../java/me/phh/treble/app/EntryService.kt    | 30 ++++++++++++++++++-
 2 files changed, 37 insertions(+), 6 deletions(-)

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index d1e06c9..cf72b3d 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -6,13 +6,16 @@
     android:sharedUserId="android.uid.system">
 
 
-    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
-    <uses-permission android:name="android.permission.DIAGNOSTIC" />
     <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
-    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
+    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
+    <uses-permission android:name="android.permission.DIAGNOSTIC" />
+    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
+    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
     <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
+    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
+    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
     <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
-
+    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
     <uses-permission android:name="android.permission.VIBRATE" />
 
     <application
@@ -28,7 +31,7 @@
         <uses-library android:name="vendor.qti.hardware.radio.am.V1_0" android:required="false"/>
         <uses-library android:name="vendor.qti.qcril.am.V1_0" android:required="false"/>
 
-        <service android:name=".EntryService" />
+        <service android:name=".EntryService" android:foregroundServiceType="connectedDevice" />
         <service android:name=".NubiaAutoFanControlService" />
 
         <service
diff --git a/app/src/main/java/me/phh/treble/app/EntryService.kt b/app/src/main/java/me/phh/treble/app/EntryService.kt
index f6c501b..5546482 100644
--- a/app/src/main/java/me/phh/treble/app/EntryService.kt
+++ b/app/src/main/java/me/phh/treble/app/EntryService.kt
@@ -1,5 +1,8 @@
 package me.phh.treble.app
 
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
 import android.app.Service
 import android.content.BroadcastReceiver
 import android.content.Context
@@ -20,6 +23,8 @@ import kotlin.concurrent.thread
 class EntryService: Service() {
     companion object {
         var service: EntryService? = null
+        private const val CHANNEL_ID = "phh_treble_entry"
+        private const val NOTIF_ID = 1
     }
     override fun onBind(intent: Intent): IBinder? {
         return null
@@ -33,8 +38,31 @@ class EntryService: Service() {
         }
     }
 
+    // run as a freezer-exempt foreground service so that device-specific
+    // sensor listeners (e.g. motorola chop-chop flashlight, handwave/pocket
+    // doze) keep firing while the screen is off and the app is backgrounded.
+    // without this the android app freezer suspends the whole process and the
+    // gestures stop working until the user opens treble settings again.
+    private fun startForegroundNotif() {
+        val nm = getSystemService(NotificationManager::class.java)
+        if (nm.getNotificationChannel(CHANNEL_ID) == null) {
+            nm.createNotificationChannel(NotificationChannel(
+                CHANNEL_ID,
+                getString(R.string.app_name),
+                NotificationManager.IMPORTANCE_LOW
+            ))
+        }
+        val notif = Notification.Builder(this, CHANNEL_ID)
+            .setContentTitle(getString(R.string.app_name))
+            .setSmallIcon(R.drawable.ic_settings)
+            .setOngoing(true)
+            .build()
+        startForeground(NOTIF_ID, notif)
+    }
+
     override fun onCreate() {
         service = this
+        startForegroundNotif()
 
         thread {
             tryC { Tools.startup(this) }
@@ -88,7 +116,7 @@ class Starter: BroadcastReceiver() {
             Intent.ACTION_BOOT_COMPLETED,
             Intent.ACTION_MY_PACKAGE_REPLACED,
             Intent.ACTION_LOCKED_BOOT_COMPLETED -> {
-                context.startServiceAsUser(Intent(context, EntryService::class.java), UserHandle.SYSTEM)
+                context.startForegroundServiceAsUser(Intent(context, EntryService::class.java), UserHandle.SYSTEM)
             }
         }
     }
