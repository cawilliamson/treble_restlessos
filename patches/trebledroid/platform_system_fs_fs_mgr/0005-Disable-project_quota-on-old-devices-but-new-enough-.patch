From 511fe6b64d2a20562f6993af06684800e1d65912 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Fri, 6 Oct 2023 19:01:27 -0400
Subject: [PATCH 5/6] Disable project_quota on old devices but new enough to
 have encryption (they do keep quota support)

---
 fs_mgr.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/fs_mgr.cpp b/fs_mgr.cpp
index 1ea3896..305627b 100644
--- a/fs_mgr.cpp
+++ b/fs_mgr.cpp
@@ -447,6 +447,14 @@ static void tune_quota(const std::string& blk_device, const FstabEntry& entry,
         want_quota = false;
     }

+    struct utsname uts;
+    unsigned int major, minor;
+
+    if ((uname(&uts) == 0) && (sscanf(uts.release, "%u.%u", &major, &minor) == 2)) {
+        if(major < 4) want_projid = false;
+        if(major == 4 && minor < 9) want_projid = false;
+    }
+
     if (!tune2fs_available()) {
         LERROR << "Unable to " << (want_quota ? "enable" : "disable") << " quotas on " << blk_device
                << " because " TUNE2FS_BIN " is missing";
-- 
2.55.0
