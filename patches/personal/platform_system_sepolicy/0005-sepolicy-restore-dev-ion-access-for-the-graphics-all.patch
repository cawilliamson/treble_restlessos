From 6d7faeaed457d1489c6e7f445d3da7a60c08ff9d Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 2 Oct 2026 10:00:06 +0100
Subject: [PATCH 5/6] sepolicy: restore /dev/ion access for the graphics stack

aosp's dma-buf migration dropped the ion rules and the /dev/ion label
from platform policy, but legacy vendor graphics stacks still allocate
through /dev/ion.  on a gsi the allocator then fails to open the node
with an EPERM that never shows as an avc, buffer allocation fails, and
renderengine aborts on the resulting non-gpu-writable buffer -- a 5
second surfaceflinger crash loop that blocks boot.

label the node, allow the allocator attribute rw access, and grant the
same to surfaceflinger: sphal gpu drivers that run inside the compositor
process (qcom adreno pre-dma-buf blobs) allocate gpu memory via ion
during driver init, and its failure makes eglInitialize return
EGL_BAD_ALLOC, which renderengine treats as fatal (observed as a
surfaceflinger SIGABRT crash loop on msm8996).

verified: applies cleanly under both release-builds and debug-builds
sequences.
---
 private/file_contexts             | 1 +
 private/hal_graphics_allocator.te | 5 +++++
 private/surfaceflinger.te         | 6 ++++++
 3 files changed, 12 insertions(+)

diff --git a/private/file_contexts b/private/file_contexts
index d9987aa66..b3194488e 100644
--- a/private/file_contexts
+++ b/private/file_contexts
@@ -134,6 +134,7 @@
 /dev/hwbinder		u:object_r:hwbinder_device:s0
 /dev/input(/.*)?	u:object_r:input_device:s0
 /dev/iio:device[0-9]+   u:object_r:iio_device:s0
+/dev/ion		u:object_r:ion_device:s0
 /dev/keychord   u:object_r:keychord_device:s0
 /dev/loop-control	u:object_r:loop_control_device:s0
 /dev/modem.*		u:object_r:radio_device:s0
diff --git a/private/hal_graphics_allocator.te b/private/hal_graphics_allocator.te
index 72a3a97f5..25fde66e3 100644
--- a/private/hal_graphics_allocator.te
+++ b/private/hal_graphics_allocator.te
@@ -9,6 +9,11 @@ allow hal_graphics_allocator_client same_process_hal_file:file { execute read op
 # GPU device access
 allow hal_graphics_allocator dmabuf_system_heap_device:chr_file r_file_perms;
 
+# legacy vendor grallocs (e.g. mtk) still allocate via /dev/ion; the dma-buf
+# migration removed the allocator rules for it, breaking buffer allocation
+# (and in turn booting) on such vendors
+allow hal_graphics_allocator ion_device:chr_file rw_file_perms;
+
 # Access the secure heap
 allow hal_graphics_allocator dmabuf_system_secure_heap_device:chr_file r_file_perms;
 
diff --git a/private/surfaceflinger.te b/private/surfaceflinger.te
index 3ddad9ec5..70b3e793f 100644
--- a/private/surfaceflinger.te
+++ b/private/surfaceflinger.te
@@ -50,6 +50,12 @@ allow surfaceflinger video_device:chr_file rw_file_perms;
 # Access the secure heap.
 allow surfaceflinger dmabuf_system_secure_heap_device:chr_file r_file_perms;
 
+# legacy gpu drivers loaded in-process via sphal (e.g. qcom adreno pre-dma-buf
+# blobs) allocate gpu memory through /dev/ion during driver init; without this
+# the allocation fails silently and eglInitialize returns EGL_BAD_ALLOC, which
+# renderengine treats as fatal and crashes surfaceflinger in a loop
+allow surfaceflinger ion_device:chr_file rw_file_perms;
+
 # Create and use netlink kobject uevent sockets.
 allow surfaceflinger self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
 
-- 
