From d8caecdfaaee68fdadd228e35ff6dffa1e0557e5 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 27 Nov 2026 20:06:36 +0300
Subject: [PATCH 4/4] PhoneFactory: give the phone process a hwbinder
 threadpool

app processes only get the single hwbinder thread started by getService.
on samsung hidl radio the main thread holds the RIL lock in getService
while rild waits on a callback into the phone process, and that callback
thread blocks on the same lock, so com.android.phone anrs on every boot.
configure four hwbinder threads before the radio proxies are created.
---
 src/java/com/android/internal/telephony/PhoneFactory.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/java/com/android/internal/telephony/PhoneFactory.java b/src/java/com/android/internal/telephony/PhoneFactory.java
index 918dcab..5e8239e 100644
--- a/src/java/com/android/internal/telephony/PhoneFactory.java
+++ b/src/java/com/android/internal/telephony/PhoneFactory.java
@@ -31,6 +31,7 @@ import android.content.SharedPreferences;
 import android.content.pm.PackageManager;
 import android.net.LocalServerSocket;
 import android.os.Build;
+import android.os.HwBinder;
 import android.os.Looper;
 import android.preference.PreferenceManager;
 import android.provider.Settings;
@@ -126,6 +127,9 @@ public class PhoneFactory {
         synchronized (sLockProxyPhones) {
             if (!sMadeDefaults) {
                 sContext = context;
+                // a single hwbinder thread deadlocks when the radio hal calls back
+                // while it is blocked on the RIL lock held by the main thread
+                HwBinder.configureRpcThreadpool(4, false);
                 int retryCount = 0;
                 for(;;) {
                     boolean hasException = false;
