From 22caa8c0569f0de5614393484a93e0bdba3fb16d Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 4 Oct 2026 20:51:23 +0100
Subject: [PATCH 4/4] disable require_gralloc4_or_newer for the gsi

the cp2a release config enables libui's require_gralloc4_or_newer,
which drops gralloc 2/3 fallback from graphicbuffermapper entirely.
legacy samsung vendors (e.g. crownqlte, gralloc 2.x only -- the vendor
hwcomposer itself falls back to mapper 2.0) then abort surfaceflinger
with 'gralloc-mapper is missing' on the first buffer allocation, which
bootloops the device before system_server comes up.

gsi builds must keep the full mapper negotiation, so disable the flag
in the cp2a config.  devices with gralloc 4/5 are unaffected -- the
negotiation still prefers the newest version first.
---
 .../require_gralloc4_or_newer_flag_values.textproto             | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/aconfig/cp2a/com.android.graphics.libui.flags/require_gralloc4_or_newer_flag_values.textproto b/aconfig/cp2a/com.android.graphics.libui.flags/require_gralloc4_or_newer_flag_values.textproto
index 234da30..f98b200 100644
--- a/aconfig/cp2a/com.android.graphics.libui.flags/require_gralloc4_or_newer_flag_values.textproto
+++ b/aconfig/cp2a/com.android.graphics.libui.flags/require_gralloc4_or_newer_flag_values.textproto
@@ -1,6 +1,6 @@
 flag_value {
   package: "com.android.graphics.libui.flags"
   name: "require_gralloc4_or_newer"
-  state: ENABLED
+  state: DISABLED
   permission: READ_ONLY
 }
