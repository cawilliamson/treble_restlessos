 api/Android.bp                                               | 1 -
 api/api.go                                                   | 3 ++-
 boot/Android.bp                                              | 4 ----
 core/java/android/app/SystemServiceRegistry.java             | 2 --
 services/core/Android.bp                                     | 1 -
 .../java/com/android/server/pm/PackageManagerNative.java     | 5 -----
 7 files changed, 2 insertions(+), 15 deletions(-)

