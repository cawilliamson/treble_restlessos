From 488a370bf5993e0724773bcd2b3efa815251ff9d Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 18 Oct 2026 02:38:59 +0300
Subject: [PATCH 28/39] contextualsearch: enable circle to search through the
 google app

---
 core/res/res/values/config.xml     | 2 +-
 data/etc/com.android.launcher3.xml | 1 +
 data/etc/framework-sysconfig.xml   | 2 ++
 3 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index 0ed95ca0d..19ee6077b 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -7742,7 +7742,7 @@
     <bool name="config_watchlistUseFileHashesCache">false</bool>

     <!-- Name of the package responsible to handle Contextual Search. -->
-    <string name="config_defaultContextualSearchPackageName" translatable="false" />
+    <string name="config_defaultContextualSearchPackageName" translatable="false">com.google.android.googlequicksearchbox</string>

     <!-- The key containing the entrypoint for Contextual Search. -->
     <string name="config_defaultContextualSearchKey" translatable="false" />
diff --git a/data/etc/com.android.launcher3.xml b/data/etc/com.android.launcher3.xml
index 9594194dd..c6fe9786a 100644
--- a/data/etc/com.android.launcher3.xml
+++ b/data/etc/com.android.launcher3.xml
@@ -29,6 +29,7 @@
         <permission name="android.permission.ACCESS_HIDDEN_PROFILES_FULL"/>
         <permission name="android.permission.READ_REMOTE_TASKS"/>
         <permission name="android.permission.REQUEST_TASK_HANDOFF"/>
+        <permission name="android.permission.ACCESS_CONTEXTUAL_SEARCH"/>
         <!-- Permissions for showing personal context results in cue bar -->
         <permission name="android.permission.PERSONAL_CONTEXT_PUBLISH_HINTS"/>
         <permission name="android.permission.PERSONAL_CONTEXT_RECEIVE_INSIGHTS"/>
diff --git a/data/etc/framework-sysconfig.xml b/data/etc/framework-sysconfig.xml
index 2162ec421..6334c2a6e 100644
--- a/data/etc/framework-sysconfig.xml
+++ b/data/etc/framework-sysconfig.xml
@@ -51,6 +51,8 @@
     <backup-transport-whitelisted-service
         service="com.android.encryptedlocaltransport/.EncryptedLocalTransportService" />

+    <feature name="com.google.android.feature.CONTEXTUAL_SEARCH" />
+
     <!-- Whitelist Shell to use the bugreport API -->
     <bugreport-whitelisted package="com.android.shell" />

-- 
2.56.0

