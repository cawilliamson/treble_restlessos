Date: Tue, 27 Oct 2026 16:35:30 +0300
Subject: [PATCH 33/39] ConsumerIrService: restore the hidl ir hal fallback

---
 .../com/android/server/ConsumerIrService.java | 26 ++++-
 .../server/utils/LazyJniRegistrar.java        |  3 +
 services/core/jni/Android.bp                  |  2 +
 .../com_android_server_ConsumerIrService.cpp  | 97 +++++++++++++++++++
 ..._android_server_utils_LazyJniRegistrar.cpp |  6 ++
 5 files changed, 132 insertions(+), 2 deletions(-)
 create mode 100644 services/core/jni/com_android_server_ConsumerIrService.cpp

diff --git a/services/core/java/com/android/server/ConsumerIrService.java b/services/core/java/com/android/server/ConsumerIrService.java
index d68c938ed..030265567 100644
--- a/services/core/java/com/android/server/ConsumerIrService.java
+++ b/services/core/java/com/android/server/ConsumerIrService.java
@@ -30,11 +30,21 @@ import android.os.RemoteException;
 import android.os.ServiceManager;
 import android.util.Slog;

+import com.android.server.utils.LazyJniRegistrar;
+
 public class ConsumerIrService extends IConsumerIrService.Stub {
     private static final String TAG = "ConsumerIrService";

     private static final int MAX_XMIT_TIME = 2000000; /* in microseconds */

+    private static native boolean getHidlHalService();
+    private static native int halTransmit(int carrierFrequency, int[] pattern);
+    private static native int[] halGetCarrierFrequencies();
+
+    static {
+        LazyJniRegistrar.registerConsumerIrService();
+    }
+
     private final Context mContext;
     private final PowerManager.WakeLock mWakeLock;
     private final boolean mHasNativeHal;
@@ -62,7 +72,12 @@ public class ConsumerIrService extends IConsumerIrService.Stub {
         final String fqName = IConsumerIr.DESCRIPTOR + "/default";
         mAidlService = IConsumerIr.Stub.asInterface(
                         ServiceManager.waitForDeclaredService(fqName));
-        return mAidlService != null;
+        if (mAidlService != null) {
+            return true;
+        }
+
+        // Fall back to the HIDL HAL service
+        return getHidlHalService();
     }

     private void throwIfNoIrEmitter() {
@@ -100,6 +115,12 @@ public class ConsumerIrService extends IConsumerIrService.Stub {
                 } catch (RemoteException ignore) {
                     Slog.e(TAG, "Error transmitting frequency: " + carrierFrequency);
                 }
+            } else {
+                int err = halTransmit(carrierFrequency, pattern);
+
+                if (err < 0) {
+                    Slog.e(TAG, "Error transmitting: " + err);
+                }
             }
         }
     }
@@ -127,8 +148,9 @@ public class ConsumerIrService extends IConsumerIrService.Stub {
                 } catch (RemoteException ignore) {
                     return null;
                 }
+            } else {
+                return halGetCarrierFrequencies();
             }
         }
-        return null;
     }
 }
diff --git a/services/core/java/com/android/server/utils/LazyJniRegistrar.java b/services/core/java/com/android/server/utils/LazyJniRegistrar.java
