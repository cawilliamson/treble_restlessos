From 0737c259615c01b1144e88a649e833bc3ba0c51e Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:55:53 +0300
Subject: [PATCH 37/41] fingerprint: handle hidl hal death on the sensor
 handler

serviceDied runs on a hwbinder thread and resets the scheduler while the
sensor handler may still be reading the pending operation queue, which
crashes system_server with a NoSuchElementException in
checkCurrentUserAndStartNextOperation. post the death handling to the
sensor handler like the aidl path does, and peek the next operation once
instead of calling getFirst repeatedly.
---
 .../server/biometrics/sensors/BiometricScheduler.java  | 10 +++++++---
 .../fingerprint/hidl/HidlToAidlSensorAdapter.java      | 10 ++++++----
 2 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/services/core/java/com/android/server/biometrics/sensors/BiometricScheduler.java b/services/core/java/com/android/server/biometrics/sensors/BiometricScheduler.java
index 1d4e8b8c1..b410b4714 100644
--- a/services/core/java/com/android/server/biometrics/sensors/BiometricScheduler.java
+++ b/services/core/java/com/android/server/biometrics/sensors/BiometricScheduler.java
@@ -312,12 +312,16 @@ public class BiometricScheduler<T, U> {
             return;
         }

+        final BiometricSchedulerOperation nextOperation = mPendingOperations.peekFirst();
+        if (nextOperation == null) {
+            return;
+        }
         final int currentUserId = mCurrentUserRetriever.get();
-        final int nextUserId = mPendingOperations.getFirst().getTargetUserId();
+        final int nextUserId = nextOperation.getTargetUserId();
         final boolean shouldStartNextOperationIfMarkedCancelling =
-                mPendingOperations.getFirst().isMarkedCanceling();
+                nextOperation.isMarkedCanceling();

-        if (nextUserId == currentUserId || mPendingOperations.getFirst().isStartUserOperation()
+        if (nextUserId == currentUserId || nextOperation.isStartUserOperation()
                 || shouldStartNextOperationIfMarkedCancelling) {
             startNextOperationIfIdle();
         } else if (currentUserId == UserHandle.USER_NULL && mUserSwitchProvider != null) {
diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/hidl/HidlToAidlSensorAdapter.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/hidl/HidlToAidlSensorAdapter.java
index 98fc293d4..afa85aaff 100644
--- a/services/core/java/com/android/server/biometrics/sensors/fingerprint/hidl/HidlToAidlSensorAdapter.java
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/hidl/HidlToAidlSensorAdapter.java
@@ -125,10 +125,12 @@ public class HidlToAidlSensorAdapter extends Sensor implements IHwBinder.DeathRe
     @Override
     public void serviceDied(long cookie) {
         Slog.d(TAG, "Fingerprint HAL died.");
-        mSession = null;
-        mDaemon = null;
-        mCurrentUserId = UserHandle.USER_NULL;
-        onBinderDied();
+        getHandler().post(() -> {
+            mSession = null;
+            mDaemon = null;
+            mCurrentUserId = UserHandle.USER_NULL;
+            onBinderDied();
+        });
     }

     @Override
-- 
