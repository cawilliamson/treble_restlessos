From faff8e14c774acbaf74986b8d60004d2d23a6b92 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:08:17 +0300
Subject: [PATCH 34/41] vibrator: connect to the miui vibratorfeature hal on
 the vintf path

---
 .../android/server/vibrator/VintfHalVibrator.java    | 12 +++++++++++-
 .../server/vibrator/VintfHalVibratorManager.java     |  9 +++++++++
 ..._android_server_vibrator_VibratorManagerService.h | 12 ++++++++++--
 3 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/services/core/java/com/android/server/vibrator/VintfHalVibrator.java b/services/core/java/com/android/server/vibrator/VintfHalVibrator.java
index a8d9224..c749044 100644
--- a/services/core/java/com/android/server/vibrator/VintfHalVibrator.java
+++ b/services/core/java/com/android/server/vibrator/VintfHalVibrator.java
@@ -97,11 +97,21 @@ class VintfHalVibrator {

     /** {@link VintfSupplier} for default {@link IVibrator} service. */
     static final class DefaultVibratorSupplier extends VintfSupplier<IVibrator> {
+        private final String mInstance;
+
+        DefaultVibratorSupplier() {
+            this("default");
+        }
+
+        DefaultVibratorSupplier(String instance) {
+            mInstance = instance;
+        }
+
         @Nullable
         @Override
         IBinder connectToService() {
             return Binder.allowBlocking(ServiceManager.waitForDeclaredService(
-                    IVibrator.DESCRIPTOR + "/default"));
+                    IVibrator.DESCRIPTOR + "/" + mInstance));
         }

         @NonNull
diff --git a/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java b/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java
index 6350d05..d0cdc39 100644
--- a/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java
+++ b/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java
@@ -70,6 +70,15 @@ class VintfHalVibratorManager {
                             handler, nativeHandler),
                     nativeHandler);
         }
+        // MIUI devices register their vibrator HAL as "vibratorfeature" instead of "default"
+        if (ServiceManager.isDeclared(IVibrator.DESCRIPTOR + "/vibratorfeature")) {
+            Slog.v(TAG, "Loading vibratorfeature IVibrator service.");
+            return new LegacyHalVibratorManager(
+                    new DefaultHalVibrator(DEFAULT_VIBRATOR_ID,
+                            new DefaultVibratorSupplier("vibratorfeature"), handler,
+                            nativeHandler),
+                    nativeHandler);
+        }
         Slog.v(TAG, "No default services declared for IVibratorManager or IVibrator."
                 + " Vibrator manager service will proceed without vibrator hardware.");
         return new LegacyHalVibratorManager();
diff --git a/services/core/jni/com_android_server_vibrator_VibratorManagerService.h b/services/core/jni/com_android_server_vibrator_VibratorManagerService.h
index b97a79c..49b016f 100644
--- a/services/core/jni/com_android_server_vibrator_VibratorManagerService.h
+++ b/services/core/jni/com_android_server_vibrator_VibratorManagerService.h
@@ -29,6 +29,8 @@

 #include <condition_variable>
 #include <mutex>
+#include <string>
+#include <utility>
 #include <vector>

 #include "core_jni_helpers.h"
@@ -174,12 +176,14 @@ private:
 template <typename I>
 class DefaultProvider : public HalProvider<I> {
 public:
-    DefaultProvider() = default;
+    explicit DefaultProvider(std::string instance = "default") : mInstance(std::move(instance)) {}
     virtual ~DefaultProvider() = default;

 private:
+    const std::string mInstance;
+
     std::shared_ptr<I> loadHal() override {
-        auto halName = std::string(I::descriptor) + "/default";
+        auto halName = std::string(I::descriptor) + "/" + mInstance;
         auto hal = I::fromBinder(ndk::SpAIBinder(AServiceManager_checkService(halName.c_str())));
         if (hal == nullptr) {
             ALOGE("%s: Error connecting to %s", halName.c_str(), __func__);
@@ -194,6 +198,10 @@ std::unique_ptr<HalProvider<I>> defaultProviderForDeclaredService() {
     if (AServiceManager_isDeclared((std::string(I::descriptor) + "/default").c_str())) {
         return std::make_unique<DefaultProvider<I>>();
     }
+    // MIUI devices register their vibrator HAL as "vibratorfeature" instead of "default"
+    if (AServiceManager_isDeclared((std::string(I::descriptor) + "/vibratorfeature").c_str())) {
+        return std::make_unique<DefaultProvider<I>>("vibratorfeature");
+    }
     return nullptr;
 }

-- 
