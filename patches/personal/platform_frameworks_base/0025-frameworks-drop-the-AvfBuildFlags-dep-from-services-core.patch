From 4571a60ec0ab7009bbb3ba61567981c7c4c546a1 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 29 Sep 2026 11:57:44 +0100
Subject: [PATCH 25/34] frameworks: drop the AvfBuildFlags dep from services.core

the virtualization sources are excluded from the gsi manifest sync, so
the AvfBuildFlags module defined there does not exist and soong analysis
of services.core.unboosted fails on the undefined dependency.
---
 services/core/Android.bp | 1 -
 1 file changed, 1 deletion(-)

diff --git a/services/core/Android.bp b/services/core/Android.bp
index 007eed63f..baa6a9132 100644
--- a/services/core/Android.bp
+++ b/services/core/Android.bp
@@ -288,7 +288,6 @@ java_library_static {
         "vendor.samsung.hardware.biometrics.fingerprint-V1-java",
         "vendor.samsung.hardware.light-V1-java",
         "aconfig_adbdauth_flags_java_lib",
-        "AvfBuildFlags",
         "textclassifier_flags_lib",
         "lights_flags_lib",
         "android.bpfprogs.flags-aconfig-java",
-- 
2.55.0

