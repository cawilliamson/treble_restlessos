From e03826bd0fcc98b3e87ea8f4aab4e4c3eb978018 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 2 Nov 2026 01:52:53 +0300
Subject: [PATCH 43/43] keyguard: restart fingerprint auth on wake for legacy
 hals

keyguard starts fingerprint auth while the screen goes off and keeps
that session running through suspend. the sony fpc hal on pie vendors
never rearms the sensor after the device suspends mid-session, so the
sensor stays dead until the bouncer cancels and restarts auth. when
persist.sys.phh.fingerprint.restart_on_wake is set, cancel the running
session on wake and let the existing restart path start a fresh one.
---
 .../src/com/android/keyguard/KeyguardUpdateMonitor.java    | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java b/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
index 98978028b..47fa5235d 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardUpdateMonitor.java
@@ -94,6 +94,7 @@ import android.os.Looper;
 import android.os.Message;
 import android.os.PowerManager;
 import android.os.RemoteException;
+import android.os.SystemProperties;
 import android.os.Trace;
 import android.os.UserHandle;
 import android.os.UserManager;
@@ -2227,6 +2228,12 @@ public class KeyguardUpdateMonitor implements TrustManager.TrustListener, CoreSt
         Trace.beginSection("KeyguardUpdateMonitor#handleStartedWakingUp");
         Assert.isMainThread();
 
+        // some legacy hals stop arming the sensor once the device suspends mid-session
+        if (mFingerprintRunningState == BIOMETRIC_STATE_RUNNING
+                && SystemProperties.getBoolean("persist.sys.phh.fingerprint.restart_on_wake",
+                        false)) {
+            stopListeningForFingerprint();
+        }
         updateFingerprintListeningState(BIOMETRIC_ACTION_UPDATE);
         requestActiveUnlockFromWakeReason(pmWakeReason, true);
 
