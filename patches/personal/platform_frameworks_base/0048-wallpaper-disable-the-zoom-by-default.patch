From 279748afedaae83cd926c39aa46463d5fcc535c9 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 20 Nov 2026 03:29:02 +0300
Subject: [PATCH 48/50] wallpaper: disable the zoom by default

the launcher and the shade zoom the wallpaper up to 1.10x on app
transitions and while the shade is open. on legacy hwcomposers that
cannot scale an afbc layer past their limit this forces every frame
of the transition to client composition. set the max scale to 1 so
the wallpaper is never zoomed.
---
 core/res/res/values/config.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index c53d2c81f..97b5af417 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -6506,7 +6506,7 @@
     <item name="config_wallpaperMinScale" format="float" type="dimen">1</item>
 
     <!-- The max scale for the wallpaper when it's zoomed in -->
-    <item name="config_wallpaperMaxScale" format="float" type="dimen">1.10</item>
+    <item name="config_wallpaperMaxScale" format="float" type="dimen">1</item>
 
     <!-- If true, the wallpaper will scale regardless of the value of shouldZoomOutWallpaper() -->
     <bool name="config_alwaysScaleWallpaper">false</bool>
