+package com.android.server;
+
+import android.os.FileUtils;
+import android.os.SystemProperties;
+import android.util.Slog;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.io.IOException;
+
+/**
+ * Keeps the samsung battery cycle counter that the stock framework maintains.
+ *
+ * The kernel only holds what userspace writes to battery_cycle and stays at -1 otherwise,
+ * which also disables its battery aging steps. The counter lives in efs as the sum of
+ * discharged percentage points, 100 points per cycle.
+ */
+final class SamsungBatteryCycle {
+    private static final String TAG = "SamsungBatteryCycle";
+
+    private static final String EFS_DISCHARGE_LEVEL = "/efs/FactoryApp/batt_discharge_level";
+    private static final String SYSFS_BATTERY_CYCLE = "/sys/class/power_supply/battery/battery_cycle";
+    private static final String SYSFS_MISC_EVENT = "/sys/class/power_supply/battery/batt_misc_event";
+
+    /** Battery changed extra with the kernel wear verdict: 1 good, 2 normal, 3 aged, 15 bad. */
+    static final String EXTRA_WEAR_HEALTH = "samsung_battery_wear_health";
+
+    private static final int MISC_EVENT_HEALTH_MASK = 0x000F0000;
+    private static final int MISC_EVENT_HEALTH_SHIFT = 16;
+
+    // stock flushes to efs every 10 points and on shutdown
+    private static final int FLUSH_THRESHOLD = 10;
+    // stock adds 1000000 to mark its life extender mode, anything above is not a real count
+    private static final long MAX_DISCHARGE_LEVEL = 1000000;
+
+    private long mDischargeLevel;
+    private int mPendingLevel;
+    private int mLastBatteryLevel = -1;
+    private int mWearHealth;
+
+    private SamsungBatteryCycle(long dischargeLevel) {
+        mDischargeLevel = dischargeLevel;
+    }
+
+    static SamsungBatteryCycle create() {
+        if (!"samsung".equalsIgnoreCase(SystemProperties.get("ro.product.vendor.manufacturer"))
+                || !new File(EFS_DISCHARGE_LEVEL).exists()
+                || !new File(SYSFS_BATTERY_CYCLE).exists()) {
+            return null;
+        }
+        final long level;
+        try {
+            level = Long.parseLong(FileUtils.readTextFile(
+                    new File(EFS_DISCHARGE_LEVEL), 32, null).trim());
+        } catch (IOException | NumberFormatException e) {
+            Slog.w(TAG, "Cannot read " + EFS_DISCHARGE_LEVEL, e);
+            return null;
+        }
+        if (level < 0 || level >= MAX_DISCHARGE_LEVEL) {
+            Slog.w(TAG, "Ignoring discharge level " + level);
+            return null;
+        }
+        final SamsungBatteryCycle cycle = new SamsungBatteryCycle(level);
+        cycle.writeCycle();
+        return cycle;
+    }
+
+    int getCycleCount() {
+        return (int) (mDischargeLevel / 100);
+    }
+
+    int getWearHealth() {
+        return mWearHealth;
+    }
+
+    void onBatteryLevel(int level) {
+        final int last = mLastBatteryLevel;
+        mLastBatteryLevel = level;
+        if (last < 0 || level >= last) {
+            return;
+        }
+        mPendingLevel += last - level;
+        if (mPendingLevel >= FLUSH_THRESHOLD) {
+            flush();
+        }
+    }
+
+    void flush() {
+        if (mPendingLevel == 0) {
+            return;
+        }
+        final int before = getCycleCount();
+        mDischargeLevel += mPendingLevel;
+        mPendingLevel = 0;
+        write(EFS_DISCHARGE_LEVEL, Long.toString(mDischargeLevel));
+        if (getCycleCount() != before) {
+            writeCycle();
+        }
+    }
+
+    private void writeCycle() {
+        write(SYSFS_BATTERY_CYCLE, Long.toString(mDischargeLevel / 100));
+        // the kernel reevaluates the wear verdict synchronously on the cycle write
+        try {
+            final int event = Integer.parseInt(FileUtils.readTextFile(
+                    new File(SYSFS_MISC_EVENT), 32, null).trim());
+            mWearHealth = (event & MISC_EVENT_HEALTH_MASK) >> MISC_EVENT_HEALTH_SHIFT;
+        } catch (IOException | NumberFormatException e) {
+            Slog.w(TAG, "Cannot read " + SYSFS_MISC_EVENT, e);
+        }
+    }
+
+    private static void write(String path, String value) {
+        try (FileWriter writer = new FileWriter(path)) {
+            writer.write(value);
+        } catch (IOException e) {
+            Slog.w(TAG, "Cannot write " + path, e);
+        }
+    }
+}
