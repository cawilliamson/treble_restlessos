From aafb4822c3eb7a29c4851004d6a6139ec0237aea Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 2 Oct 2026 21:16:15 +0300
Subject: [PATCH 29/33] inputmethod: add a setting to hide the ime back button in the
 ime navigation bar

---
 .../inputmethodservice/NavigationBarController.java   | 11 ++++++++++-
 .../navigationbar/NavigationBarView.java              | 11 ++++++++++-
 core/java/android/provider/Settings.java              |  9 +++++++++
 .../inputmethod/InputMethodNavButtonFlags.java        |  6 ++++++
 .../provider/settings/backup/SecureSettings.java      |  1 +
 .../settings/validators/SecureSettingsValidators.java |  1 +
 .../server/inputmethod/InputMethodManagerService.java | 11 +++++++++--
 .../server/inputmethod/InputMethodSettings.java       |  4 ++++
 8 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/core/java/android/inputmethodservice/NavigationBarController.java b/core/java/android/inputmethodservice/NavigationBarController.java
index caf8ca94..83e9d3da 100644
--- a/core/java/android/inputmethodservice/NavigationBarController.java
+++ b/core/java/android/inputmethodservice/NavigationBarController.java
@@ -86,6 +86,9 @@ final class NavigationBarController implements Window.DecorCallback,
      */
     private boolean mImeSwitcherButtonEnabled;
 
+    /** Whether the IME back (dismiss) button is hidden on the IME Navigation bar. */
+    private boolean mImeBackButtonHidden;
+
     /** Whether a custom IME Switcher button should be visible. */
     private boolean mCustomImeSwitcherButtonRequestedVisible;
 
@@ -166,6 +169,7 @@ final class NavigationBarController implements Window.DecorCallback,
                 // TODO(b/213337792): Set NAVBAR_IME_VISIBLE only when necessary.
                 final int flags = NAVBAR_BACK_DISMISS_IME | NAVBAR_IME_VISIBLE | (
                         showImeSwitcherButtonInNavBar() ? NAVBAR_IME_SWITCHER_BUTTON_VISIBLE : 0);
+                navigationBarView.setBackButtonHidden(mImeBackButtonHidden);
                 navigationBarView.setNavbarFlags(flags);
                 navigationBarView.prepareNavButtons(this);
             }
@@ -413,12 +417,15 @@ final class NavigationBarController implements Window.DecorCallback,
         }
 
         final boolean prevShowImeSwitcherButtonInNavBar = showImeSwitcherButtonInNavBar();
+        final boolean prevImeBackButtonHidden = mImeBackButtonHidden;
         mImeDrawsImeNavBar =
                 (navButtonFlags & InputMethodNavButtonFlags.IME_DRAWS_IME_NAV_BAR) != 0;
         mShowImeSwitcherButton =
                 (navButtonFlags & InputMethodNavButtonFlags.SHOW_IME_SWITCHER_BUTTON) != 0;
         mImeSwitcherButtonEnabled =
                 (navButtonFlags & InputMethodNavButtonFlags.IME_SWITCHER_BUTTON_ENABLED) != 0;
+        mImeBackButtonHidden =
+                (navButtonFlags & InputMethodNavButtonFlags.IME_BACK_BUTTON_HIDDEN) != 0;
 
         mService.mWindow.getWindow().getDecorView().getWindowInsetsController()
                 .setImeCaptionBarInsetsHeight(getImeCaptionBarHeight(mImeDrawsImeNavBar));
@@ -426,10 +433,12 @@ final class NavigationBarController implements Window.DecorCallback,
         if (mImeDrawsImeNavBar) {
             installNavigationBarFrameIfNecessary();
             if (mNavigationBarFrame != null
-                    && showImeSwitcherButtonInNavBar() != prevShowImeSwitcherButtonInNavBar) {
+                    && (showImeSwitcherButtonInNavBar() != prevShowImeSwitcherButtonInNavBar
+                    || mImeBackButtonHidden != prevImeBackButtonHidden)) {
                 final NavigationBarView navigationBarView = mNavigationBarFrame
                         .findViewByPredicate(NavigationBarView.class::isInstance);
                 if (navigationBarView != null) {
+                    navigationBarView.setBackButtonHidden(mImeBackButtonHidden);
                     // TODO(b/213337792): Support InputMethodService#setBackDisposition().
                     // TODO(b/213337792): Set NAVBAR_IME_VISIBLE only when necessary.
                     final int flags = NAVBAR_BACK_DISMISS_IME | NAVBAR_IME_VISIBLE | (
diff --git a/core/java/android/inputmethodservice/navigationbar/NavigationBarView.java b/core/java/android/inputmethodservice/navigationbar/NavigationBarView.java
index 32b9dc2f..f268f7bb 100644
--- a/core/java/android/inputmethodservice/navigationbar/NavigationBarView.java
+++ b/core/java/android/inputmethodservice/navigationbar/NavigationBarView.java
@@ -67,6 +67,7 @@ public final class NavigationBarView extends FrameLayout {
     int mDisabledFlags = 0;
     @NavbarFlags
     private int mNavbarFlags;
+    private boolean mBackButtonHidden;
     private final int mNavBarMode = NAV_BAR_MODE_GESTURAL;
 
     private KeyButtonDrawable mBackIcon;
@@ -275,6 +276,14 @@ public final class NavigationBarView extends FrameLayout {
         super.setLayoutDirection(layoutDirection);
     }
 
+    public void setBackButtonHidden(boolean hidden) {
+        if (hidden == mBackButtonHidden) {
+            return;
+        }
+        mBackButtonHidden = hidden;
+        updateNavButtonIcons();
+    }
+
     /**
      * Sets the navigation bar state flags.
      *
@@ -316,7 +325,7 @@ public final class NavigationBarView extends FrameLayout {
         getImeSwitchButton()
                 .setVisibility(isImeSwitcherButtonVisible ? View.VISIBLE : View.INVISIBLE);
 
-        getBackButton().setVisibility(View.VISIBLE);
+        getBackButton().setVisibility(mBackButtonHidden ? View.INVISIBLE : View.VISIBLE);
         getHomeHandle().setVisibility(View.INVISIBLE);
 
         // We used to be reporting the touch regions via notifyActiveTouchRegions() here.
diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 4c940ca0..372671f4 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -8519,6 +8519,15 @@ public final class Settings {
         public static final String IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED =
                 "ime_switcher_in_navbar_enabled";
 
+        /**
+         * Toggle for showing the IME back (dismiss) button in the IME navigation bar.
+         *
+         * @hide
+         */
+        @Readable
+        public static final String IME_BACK_BUTTON_IN_NAVBAR_ENABLED =
+                "ime_back_in_navbar_enabled";
+
         /**
          * Default value for {@link #STYLUS_HANDWRITING_ENABLED}.
          *
diff --git a/core/java/com/android/internal/inputmethod/InputMethodNavButtonFlags.java b/core/java/com/android/internal/inputmethod/InputMethodNavButtonFlags.java
index f32c135a..fe1ed2ae 100644
--- a/core/java/com/android/internal/inputmethod/InputMethodNavButtonFlags.java
+++ b/core/java/com/android/internal/inputmethod/InputMethodNavButtonFlags.java
@@ -32,6 +32,7 @@ import java.lang.annotation.Retention;
         InputMethodNavButtonFlags.IME_DRAWS_IME_NAV_BAR,
         InputMethodNavButtonFlags.SHOW_IME_SWITCHER_BUTTON,
         InputMethodNavButtonFlags.IME_SWITCHER_BUTTON_ENABLED,
+        InputMethodNavButtonFlags.IME_BACK_BUTTON_HIDDEN,
 })
 public @interface InputMethodNavButtonFlags {
 
@@ -54,4 +55,9 @@ public @interface InputMethodNavButtonFlags {
      * from {@link #SHOW_IME_SWITCHER_BUTTON}.
      */
     int IME_SWITCHER_BUTTON_ENABLED = 1 << 2;
+
+    /**
+     * When set, the IME back (dismiss) button is not shown on the IME Navigation bar.
+     */
+    int IME_BACK_BUTTON_HIDDEN = 1 << 3;
 }
diff --git a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
index ce19d079..926c88c3 100644
--- a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
+++ b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
@@ -347,6 +347,7 @@ public class SecureSettings {
         Settings.Secure.PERSONAL_CONTEXT_MODE_ENABLED_DEFAULT,
         Settings.Secure.LIGHT_ANIMATION_FAVORITE_CALLS_ENABLED,
         Settings.Secure.IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED,
+        Settings.Secure.IME_BACK_BUTTON_IN_NAVBAR_ENABLED,
         Settings.Secure.RAISE_TRIGGER_DEFAULT_ASSISTANT,
     };
 }
diff --git a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
index 73dfc3ea..ee041a79 100644
--- a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
+++ b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
@@ -550,6 +550,7 @@ public class SecureSettingsValidators {
         VALIDATORS.put(Secure.IS_WALLET_SERVICE_AVAILABLE, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.LIGHT_ANIMATION_FAVORITE_CALLS_ENABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED, BOOLEAN_VALIDATOR);
+        VALIDATORS.put(Secure.IME_BACK_BUTTON_IN_NAVBAR_ENABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.RAISE_TRIGGER_DEFAULT_ASSISTANT,
                 COLON_SEPARATED_COMPONENT_LIST_VALIDATOR);
     }
diff --git a/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java b/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
index 76bbdd30..6297beff 100644
--- a/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
+++ b/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
@@ -815,7 +815,8 @@ public final class InputMethodManagerService implements IInputMethodManagerImpl.
                 updateInputMethodsFromSettingsLocked(enabledChanged, userId);
                 break;
             }
-            case Settings.Secure.IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED: {
+            case Settings.Secure.IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED:
+            case Settings.Secure.IME_BACK_BUTTON_IN_NAVBAR_ENABLED: {
                 final var userData = getUserData(userId);
                 updateSystemUiLocked(userId);
                 sendOnNavButtonFlagsChangedLocked(userData);
@@ -1686,6 +1687,7 @@ public final class InputMethodManagerService implements IInputMethodManagerImpl.
                                 Settings.Secure.SELECTED_INPUT_METHOD_SUBTYPE,
                                 Settings.Secure.STYLUS_HANDWRITING_ENABLED,
                                 Settings.Secure.IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED,
+                                Settings.Secure.IME_BACK_BUTTON_IN_NAVBAR_ENABLED,
                         }, (key, flags, userId) -> {
                             synchronized (ImfLock.class) {
                                 onSecureSettingsChangedLocked(key, userId);
@@ -2876,11 +2878,16 @@ public final class InputMethodManagerService implements IInputMethodManagerImpl.
         final boolean isImeSwitcherButtonInNavbarEnabled =
                 !Flags.imeSwitcherButtonInNavbarSetting() || InputMethodSettingsRepository.get(
                         userId).isImeSwitcherButtonInNavBarEnabled();
+        final boolean isImeBackButtonInNavbarEnabled =
+                InputMethodSettingsRepository.get(userId).isImeBackButtonInNavBarEnabled();
         return (imeDrawsImeNavBar ? InputMethodNavButtonFlags.IME_DRAWS_IME_NAV_BAR : 0)
                 | (showImeSwitcherButton ? InputMethodNavButtonFlags.SHOW_IME_SWITCHER_BUTTON : 0)
                 | (isImeSwitcherButtonInNavbarEnabled
                 ? InputMethodNavButtonFlags.IME_SWITCHER_BUTTON_ENABLED
-                : 0);
+                : 0)
+                | (isImeBackButtonInNavbarEnabled
+                ? 0
+                : InputMethodNavButtonFlags.IME_BACK_BUTTON_HIDDEN);
     }
 
     /**
diff --git a/services/core/java/com/android/server/inputmethod/InputMethodSettings.java b/services/core/java/com/android/server/inputmethod/InputMethodSettings.java
index 339645d6..13bcdbba 100644
--- a/services/core/java/com/android/server/inputmethod/InputMethodSettings.java
+++ b/services/core/java/com/android/server/inputmethod/InputMethodSettings.java
@@ -664,6 +664,10 @@ final class InputMethodSettings {
         return getInt(Settings.Secure.IME_SWITCHER_BUTTON_IN_NAVBAR_ENABLED, 1) == 1;
     }
 
+    boolean isImeBackButtonInNavBarEnabled() {
+        return getInt(Settings.Secure.IME_BACK_BUTTON_IN_NAVBAR_ENABLED, 1) == 1;
+    }
+
     void dump(final Printer pw, final String prefix) {
         pw.println(prefix + "mUserId=" + mUserId);
     }
