From ab495d432ef0651f85cd518c6e4981cd64956781 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:56:39 +0300
Subject: [PATCH 30/42] settings: add a secure setting to let tethering use vpn
 upstreams

---
 core/java/android/provider/Settings.java                 | 9 +++++++++
 .../android/provider/settings/backup/SecureSettings.java | 1 +
 .../settings/validators/SecureSettingsValidators.java    | 1 +
 3 files changed, 11 insertions(+)

diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index ef2fc878c..c18ae72cc 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -8974,6 +8974,15 @@ public final class Settings {
         @Readable
         public static final String ALWAYS_ON_VPN_LOCKDOWN = "always_on_vpn_lockdown";

+        /**
+         * Whether tethering is allowed to use the VPN as its upstream (0 = false, 1 = true).
+         * The key is mirrored in Tethering.java and UpstreamNetworkMonitor.java.
+         *
+         * @hide
+         */
+        @Readable
+        public static final String TETHERING_ALLOW_VPN_UPSTREAMS = "tethering_allow_vpn_upstreams";
+
         /**
          * Comma separated list of packages that are allowed to access the network when VPN is in
          * lockdown mode but not running.
diff --git a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
index 926c88c31..5c6a49d98 100644
--- a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
+++ b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
@@ -309,6 +309,7 @@ public class SecureSettings {
         Settings.Secure.ON_DEVICE_INFERENCE_UNBIND_TIMEOUT_MS,
         Settings.Secure.ON_DEVICE_INTELLIGENCE_IDLE_TIMEOUT_MS,
         Settings.Secure.FIRST_ON_DEVICE_MODELS_DOWNLOADED_TIME,
+        Settings.Secure.TETHERING_ALLOW_VPN_UPSTREAMS,
         Settings.Secure.CONTENT_SAFETY_IDLE_TIMEOUT_MS,
         Settings.Secure.CONTENT_SAFETY_UNBIND_TIMEOUT_MS,
         Settings.Secure.CONTENT_SAFETY_SANDBOXED_UNBIND_TIMEOUT_MS,
diff --git a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
index ee041a797..19b5fb47b 100644
--- a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
+++ b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
@@ -497,6 +497,7 @@ public class SecureSettingsValidators {
         VALIDATORS.put(Secure.ON_DEVICE_INTELLIGENCE_UNBIND_TIMEOUT_MS, ANY_LONG_VALIDATOR);
         VALIDATORS.put(Secure.ON_DEVICE_INTELLIGENCE_IDLE_TIMEOUT_MS, NONE_NEGATIVE_LONG_VALIDATOR);
         VALIDATORS.put(Secure.FIRST_ON_DEVICE_MODELS_DOWNLOADED_TIME, NONE_NEGATIVE_LONG_VALIDATOR);
+        VALIDATORS.put(Secure.TETHERING_ALLOW_VPN_UPSTREAMS, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.CONTENT_SAFETY_SANDBOXED_IDLE_TIMEOUT_MS,
                 NONE_NEGATIVE_LONG_VALIDATOR);
         VALIDATORS.put(Secure.CONTENT_SAFETY_IDLE_TIMEOUT_MS, NONE_NEGATIVE_LONG_VALIDATOR);
-- 
