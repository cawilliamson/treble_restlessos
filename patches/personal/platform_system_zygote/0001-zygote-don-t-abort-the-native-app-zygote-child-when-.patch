From 2bfa5618b413106220a0f778f6ca2839bc168631 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 18 Oct 2026 02:19:44 +0300
Subject: [PATCH 1/1] zygote: don't abort the native app zygote child when
 cgroup setup fails on legacy kernels

---
 zygote/src/species/android_native.rs | 20 +++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/zygote/src/species/android_native.rs b/zygote/src/species/android_native.rs
index 42b747e..8ea9010 100644
--- a/zygote/src/species/android_native.rs
+++ b/zygote/src/species/android_native.rs
@@ -317,12 +317,13 @@ impl Species for App {
         }
 
         // Create a cgroup for the process
-        if sys::getuid() == 0 {
-            cgroup::create(
+        if sys::getuid() == 0
+            && let Err(err) = cgroup::create(
                 spawn_params.uid.expect("No UID specified").try_into().expect("Invalid UID"),
                 sys::getpid(),
             )
-            .expect("Unable to create cgroup for process");
+        {
+            log::error!("Unable to create cgroup for process: {err:?}");
         }
 
         let policy = if let SpawnPayload::AndroidNative { top_app, .. } = spawn_payload {
@@ -335,14 +336,15 @@ impl Species for App {
             SchedPolicy::Default
         };
 
-        // Set the cpuset policy and panic on failure
-        if cpusets_enabled() {
-            sys::android::set_cpuset_policy(0, policy).expect("Failed to set cpuset policy");
+        if cpusets_enabled() && let Err(err) = sys::android::set_cpuset_policy(0, policy) {
+            log::error!("Failed to set cpuset policy: {err:?}");
         }
 
-        // Set the scheduling policy and panic on failure.  Must be called
-        // before losing the permission to set scheduler policy.
-        sys::android::set_sched_policy(0, policy).expect("Failed to set scheduler policy");
+        // Set the scheduling policy.  Must be called before losing the
+        // permission to set scheduler policy.
+        if let Err(err) = sys::android::set_sched_policy(0, policy) {
+            log::error!("Failed to set scheduler policy: {err:?}");
+        }
 
         // We are going to lose the permission to set scheduler policy during
         // the specialization, so make sure that we don't cache the fd of
