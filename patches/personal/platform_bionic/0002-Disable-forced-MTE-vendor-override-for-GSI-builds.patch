From 35d4eed2ed0212f8bbf54c7f8993b3f399520813 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 20 Feb 2026 20:34:26 +0000
Subject: [PATCH 2/3] Disable pointer tagging for vendor processes on GSI builds

GrapheneOS forces M_HEAP_TAGGING_LEVEL_ASYNC on all vendor processes
as a security hardening measure. On devices without hardware MTE this
falls back to TBI (Top Byte Ignore), which stores random tags in the
top byte of heap pointers. Vendor kernel drivers that validate pointer
ranges in their copy_from_user/copy_to_user paths (notably
TrustKernel's tkcore TEE driver) reject these tagged pointers with
EINVAL, causing intermittent failures - e.g. fingerprint sensor
calibration fails on some cold boots because
tee_context_copy_from_client cannot handle the tagged addresses.

On a GSI, vendor binaries come from the device vendor and are not
built with tagged pointer awareness. Replace the forced ASYNC
override with M_HEAP_TAGGING_LEVEL_NONE for all vendor processes,
which skips the PR_TAGGED_ADDR_ENABLE prctl entirely and leaves
pointers completely untagged.

Also add "none" as a recognized memtag property value (alongside
"sync", "async", "off") for per-process override via
persist.arm64.memtag.process.<name>, and teach __libc_init_mte to
skip all tagging setup when the level is NONE.
---
 libc/bionic/libc_init_mte.cpp | 44 ++++++++++++++++-------------------
 1 file changed, 20 insertions(+), 24 deletions(-)

diff --git a/libc/bionic/libc_init_mte.cpp b/libc/bionic/libc_init_mte.cpp
index 98d3c3b..3bd6d24 100644
--- a/libc/bionic/libc_init_mte.cpp
+++ b/libc/bionic/libc_init_mte.cpp
@@ -131,29 +131,14 @@ static bool get_environment_memtag_setting(HeapTaggingLevel* level) {
 
   const bool is_vendor_prog = starts_with(progname, "/vendor/") || starts_with(progname, "/apex/com.google.");
   const bool is_debug_build = is_debuggable_build();
+
+  // On GSI builds, vendor binaries are not built with tagged pointer awareness
+  // and vendor kernel drivers (TEE, fingerprint SPI, etc.) often cannot handle
+  // tagged pointers in their copy_from_user paths. Disable all pointer tagging
+  // for vendor processes to avoid intermittent EINVAL failures.
   if (is_vendor_prog) {
-    char device_name[PROP_VALUE_MAX];
-    get_property_value("ro.product.name", device_name, sizeof(device_name));
-    bool apply_override =
-        strcmp(progname, "/apex/com.google.pixel.camera.hal/bin/hw/android.hardware.camera.provider@2.7-service-google") != 0
-        && (
-            (
-                 strcmp(device_name, "tokay") != 0
-                 && strcmp(device_name, "caiman") != 0
-                 && strcmp(device_name, "komodo") != 0
-                 && strcmp(device_name, "comet") != 0
-                 && strcmp(device_name, "frankel") != 0
-                 && strcmp(device_name, "blazer") != 0
-                 && strcmp(device_name, "mustang") != 0
-                 && strcmp(device_name, "rango") != 0
-            ) || strcmp(progname, "/vendor/bin/shared_modem_platform") != 0
-        )
-    ;
-    if (apply_override) {
-        *level = M_HEAP_TAGGING_LEVEL_ASYNC;
-    } else if (!is_debug_build) {
-        return true;
-     }
+    *level = M_HEAP_TAGGING_LEVEL_NONE;
+    return true;
   }
 
   if (!is_debug_build) {
@@ -174,7 +159,7 @@ static bool get_environment_memtag_setting(HeapTaggingLevel* level) {
 
   if (!get_config_from_env_or_sysprops("MEMTAG_OPTIONS", sys_prop_names, arraysize(sys_prop_names),
                                        options_str, sizeof(options_str))) {
-    return is_vendor_prog;
+    return false;
   }
 
   if (strcmp("sync", options_str) == 0) {
@@ -183,10 +168,12 @@ static bool get_environment_memtag_setting(HeapTaggingLevel* level) {
     *level = M_HEAP_TAGGING_LEVEL_ASYNC;
   } else if (strcmp("off", options_str) == 0) {
     *level = M_HEAP_TAGGING_LEVEL_TBI;
+  } else if (strcmp("none", options_str) == 0) {
+    *level = M_HEAP_TAGGING_LEVEL_NONE;
   } else {
     async_safe_format_log(
         ANDROID_LOG_ERROR, "libc",
-        "unrecognized memtag level: \"%s\" (options are \"sync\", \"async\", or \"off\").",
+        "unrecognized memtag level: \"%s\" (options are \"sync\", \"async\", \"off\", or \"none\").",
         options_str);
     return false;
   }
@@ -305,6 +292,15 @@ __attribute__((no_sanitize("hwaddress", "memtag"))) void __libc_init_mte(
                             DescribeTaggingLevel(level));
     }
   }
+  // "none" means fully disable all pointer tagging (no MTE, no TBI). This is
+  // needed for processes that communicate with kernel drivers (e.g. TEE drivers)
+  // that cannot handle tagged pointers in their copy_from_user/copy_to_user paths.
+  if (level == M_HEAP_TAGGING_LEVEL_NONE) {
+    __libc_shared_globals()->initial_heap_tagging_level = M_HEAP_TAGGING_LEVEL_NONE;
+    __libc_shared_globals()->heap_tagging_upgrade_timer_sec = 0;
+    return;
+  }
+
   if (level == M_HEAP_TAGGING_LEVEL_SYNC || level == M_HEAP_TAGGING_LEVEL_ASYNC) {
     unsigned long prctl_arg = PR_TAGGED_ADDR_ENABLE | PR_MTE_TAG_SET_NONZERO;
     prctl_arg |= (level == M_HEAP_TAGGING_LEVEL_SYNC) ? PR_MTE_TCF_SYNC : PR_MTE_TCF_ASYNC;
-- 
