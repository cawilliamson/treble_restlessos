From 3fc328352921baa6ee376c106b9bad54eb8ff0b1 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 20 Nov 2026 01:21:33 +0300
Subject: [PATCH 5/5] overlay: add the huawei ppa-lx2 framework overlay

the kirin 710a ppa-lx2 reports ro.hw.oemName as PPAH* and has a
notch and 35dp status bar that the generic huawei overlays do not
cover. add a framework overlay with the display cutout, status bar
height, brightness limits and two physical sim slots, and a
systemui overlay with the 30dp status bar side padding stock emui
uses so the clock no longer sits on the screen edge.
---
 Huawei/kirin710/PPAH/Android.mk            |  8 ++++++++
 Huawei/kirin710/PPAH/AndroidManifest.xml   | 10 ++++++++++
 Huawei/kirin710/PPAH/res/values/config.xml | 11 +++++++++++
 Huawei/kirin710/PPAH-SystemUI/Android.mk          |  8 ++++++++
 Huawei/kirin710/PPAH-SystemUI/AndroidManifest.xml | 10 ++++++++++
 Huawei/kirin710/PPAH-SystemUI/res/values/dimens.xml |  5 +++++
 overlay.mk                                 |  2 ++
 7 files changed, 54 insertions(+)
 create mode 100644 Huawei/kirin710/PPAH/Android.mk
 create mode 100644 Huawei/kirin710/PPAH/AndroidManifest.xml
 create mode 100644 Huawei/kirin710/PPAH-SystemUI/Android.mk
 create mode 100644 Huawei/kirin710/PPAH-SystemUI/AndroidManifest.xml
 create mode 100644 Huawei/kirin710/PPAH-SystemUI/res/values/dimens.xml
 create mode 100644 Huawei/kirin710/PPAH/res/values/config.xml

diff --git a/Huawei/kirin710/PPAH/Android.mk b/Huawei/kirin710/PPAH/Android.mk
new file mode 100644
index 0000000..1168d81
--- /dev/null
+++ b/Huawei/kirin710/PPAH/Android.mk
@@ -0,0 +1,8 @@
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_PACKAGE_NAME := treble-overlay-huawei-PPAH
+LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/overlay
+LOCAL_IS_RUNTIME_RESOURCE_OVERLAY := true
+LOCAL_PRIVATE_PLATFORM_APIS := true
+include $(BUILD_PACKAGE)
\ No newline at end of file
diff --git a/Huawei/kirin710/PPAH/AndroidManifest.xml b/Huawei/kirin710/PPAH/AndroidManifest.xml
new file mode 100644
index 0000000..f51461e
--- /dev/null
+++ b/Huawei/kirin710/PPAH/AndroidManifest.xml
@@ -0,0 +1,10 @@
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+        package="com.langsdorff.overlay.ppah"
+        android:versionCode="1"
+        android:versionName="1.0">
+        <overlay android:targetPackage="android"
+                android:requiredSystemPropertyName="ro.hw.oemName"
+                android:requiredSystemPropertyValue="+PPAH*"
+                android:priority="33"
+                android:isStatic="true" />
+</manifest>
