+    <dimen name="status_bar_height">35dp</dimen>
+    <integer name="config_screenBrightnessDim">6</integer>
+    <integer name="config_screenBrightnessSettingMinimum">4</integer>
+    <integer name="config_num_physical_slots">2</integer>
+</resources>
