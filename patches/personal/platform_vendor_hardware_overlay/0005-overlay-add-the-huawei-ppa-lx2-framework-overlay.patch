+++ b/Huawei/kirin710/PPAH/res/values/config.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="config_mainBuiltInDisplayCutout" translatable="false">M-40,105l80,0l0,-105l-80,0z</string>
+    <bool name="config_fillMainBuiltInDisplayCutout">false</bool>
+    <dimen name="status_bar_height_portrait">35dp</dimen>
