diff --git a/Samsung/A14-SystemUI/Android.mk b/Samsung/A14-SystemUI/Android.mk
new file mode 100644
index 0000000..c529ea7
--- /dev/null
+++ b/Samsung/A14-SystemUI/Android.mk
@@ -0,0 +1,8 @@
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_PACKAGE_NAME := treble-overlay-samsung-a14-systemui
+LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/overlay
+LOCAL_IS_RUNTIME_RESOURCE_OVERLAY := true
+LOCAL_PRIVATE_PLATFORM_APIS := true
+include $(BUILD_PACKAGE)
diff --git a/Samsung/A14-SystemUI/AndroidManifest.xml b/Samsung/A14-SystemUI/AndroidManifest.xml
new file mode 100644
index 0000000..bd91503
--- /dev/null
+++ b/Samsung/A14-SystemUI/AndroidManifest.xml
@@ -0,0 +1,10 @@
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+        package="me.phh.treble.overlay.samsung.a14.systemui"
+        android:versionCode="1"
+        android:versionName="1.0">
+        <overlay android:targetPackage="com.android.systemui"
+                android:requiredSystemPropertyName="ro.vendor.build.fingerprint"
+                android:requiredSystemPropertyValue="+*samsung/a14*"
+                android:priority="985"
+                android:isStatic="true" />
+</manifest>
