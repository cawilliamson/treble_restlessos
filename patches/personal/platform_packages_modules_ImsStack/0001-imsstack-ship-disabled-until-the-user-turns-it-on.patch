From eb3249fd96f8226ba7d85df8c1ef6131820f8d80 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:23:27 +0300
Subject: [PATCH 1/1] imsstack: ship disabled until the user turns it on

the gsi carries imsstack for every device, but most of them either have
their own ims apk or a modem that keeps the ims pdn to itself. imsstack
is persistent, so an enabled copy starts on every boot whether telephony
binds it or not. mark the application disabled in the manifest and let
the treble app enable it on request.
---
 java/AndroidManifest.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/java/AndroidManifest.xml b/java/AndroidManifest.xml
index 3e0b6f6..847b543 100644
--- a/java/AndroidManifest.xml
+++ b/java/AndroidManifest.xml
@@ -58,6 +58,7 @@
     <!--  Application -->
     <application
         android:label="@string/app_name"
+        android:enabled="false"
         android:persistent="true"
         android:process="com.android.imsstack"
         android:name="com.android.imsstack.ImsStackApp"
