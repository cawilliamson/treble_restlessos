From fe37f397e858311b6175fdc12b0d70d02b8d132c Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Wed, 18 Mar 2026 12:18:21 +0000
Subject: [PATCH 4/4] libprocessgroup: fall back to v1 memcg for lmkd compatibility
 on GSI

lmkd requires the memory cgroup controller in the v1 hierarchy when
using its vmpressure-based kill strategy. This is triggered in two
distinct cases seen on GSI builds with vendor kernels:

1. Kernel lacks CONFIG_PSI: lmkd cannot open /proc/pressure/memory,
   its PSI monitoring path fails, and the vmpressure fallback then also
   fails because it hard-requires a v1 memcg hierarchy.

2. Vendor sets ro.lmk.use_minfree_levels=true: lmkd defaults
   use_new_strategy=false and gates itself to the old kill strategy,
   which requires v1 memcg regardless of whether PSI is available.
   Vendor build.prop loads after system build.prop in PropertyLoadBoot
   Defaults(), so a ro.lmk.use_new_strategy=true override in system.prop
   is silently clobbered if the vendor also sets this property.

In both cases the result is the same: lmkd exits immediately, Activity
Manager spins in a connect-retry loop, cascading ANRs fire in SystemUI
and com.android.phone, and the device is stuck behind FallbackHome with
'Settings has stopped'.

Fix this at the CgroupSetup() layer, which runs as PID 1 before early-
init and before lmkd starts, and crucially after PropertyLoadBootDefaults
has committed all vendor properties. When the memory controller is
declared as v2 and either PSI is absent or use_minfree_levels=true, fall
back to mounting memory as a v1 cgroup at /dev/memcg. lmkd's
memcg_version() then returns kV1 and init_mp_common() succeeds.

Devices with PSI and without use_minfree_levels are unaffected.
---
 libprocessgroup/setup/cgroup_map_write.cpp | 34 ++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/libprocessgroup/setup/cgroup_map_write.cpp b/libprocessgroup/setup/cgroup_map_write.cpp
index 458e4cd..e0a5093 100644
--- a/libprocessgroup/setup/cgroup_map_write.cpp
+++ b/libprocessgroup/setup/cgroup_map_write.cpp
@@ -28,6 +28,7 @@
 #include <unistd.h>
 
 #include <android-base/logging.h>
+#include <android-base/properties.h>
 #include <processgroup/cgroup_descriptor.h>
 #include <processgroup/processgroup.h>
 #include <processgroup/setup.h>
@@ -290,6 +291,39 @@ bool CgroupSetup() {
             return true;
         }
 
+        // lmkd requires the memory controller in the v1 hierarchy when using its
+        // vmpressure-based kill strategy. This happens in two cases:
+        //
+        //   1. The kernel lacks CONFIG_PSI: lmkd cannot open /proc/pressure/memory
+        //      and its PSI path fails entirely.
+        //
+        //   2. The vendor has set ro.lmk.use_minfree_levels=true: lmkd then
+        //      defaults use_new_strategy=false and gates itself to the old kill
+        //      strategy, which hard-requires v1 memcg regardless of PSI support.
+        //      Vendor build.prop is loaded after system build.prop, so a
+        //      ro.lmk.use_new_strategy=true override in system.prop is silently
+        //      clobbered by any vendor value.
+        //
+        // In either case, if the memory controller is currently declared as v2 we
+        // fall back to mounting it as a v1 cgroup at /dev/memcg. Devices where
+        // PSI is available and the vendor has not forced use_minfree_levels are
+        // unaffected: the condition below evaluates false and the v2 path is taken.
+        if (name == "memory" && descriptor.controller()->version() == 2) {
+            const bool psi_available = access("/proc/pressure/memory", F_OK) == 0;
+            const bool minfree_levels =
+                    android::base::GetBoolProperty("ro.lmk.use_minfree_levels", false);
+            if (!psi_available || minfree_levels) {
+                LOG(WARNING) << "Mounting memory cgroup as v1 at /dev/memcg: "
+                             << (psi_available ? "vendor ro.lmk.use_minfree_levels=true forces "
+                                                 "old kill strategy"
+                                               : "kernel lacks PSI support");
+                descriptor = CgroupDescriptor(
+                        1, name, "/dev/memcg", descriptor.mode(), descriptor.uid(),
+                        descriptor.gid(), descriptor.controller()->flags() &
+                        ~CGROUPRC_CONTROLLER_FLAG_NEEDS_ACTIVATION, UINT32_MAX);
+            }
+        }
+
         if (!SetupCgroup(descriptor)) {
             // issue a warning and proceed with the next cgroup
             LOG(WARNING) << "Failed to setup " << name << " cgroup";
-- 
