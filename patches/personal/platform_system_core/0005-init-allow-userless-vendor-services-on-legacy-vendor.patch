From ad8c4c126d83150c79d415a9e0e862cfae4d87e0 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 20 Nov 2026 01:23:19 +0300
Subject: [PATCH 5/5] init: allow userless vendor services on legacy vendors

init rejects services without a user line, so wpa_supplicant and
oeminfo_nvm from pre-S vendors are dropped and the device boots
without wifi or modem nvram. ro.vendor.api_level is derived by init
and is not reliable here, so detect legacy vendors by a numeric
ro.vndk.version below 31, keep the warning and run them as root.
---
 init/service_parser.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/init/service_parser.cpp b/init/service_parser.cpp
index 54bed4a..f611930 100644
--- a/init/service_parser.cpp
+++ b/init/service_parser.cpp
@@ -683,8 +683,10 @@ Result<void> ServiceParser::EndSection() {
     }
 
     if (service_->proc_attr_.parsed_uid == std::nullopt) {
-        if (kAlwaysErrorUserRoot ||
-            android::base::GetIntProperty("ro.vendor.api_level", 0) > 202404) {
+        int vndk_version = android::base::GetIntProperty("ro.vndk.version", 0);
+        bool legacy_vendor = vndk_version > 0 && vndk_version < __ANDROID_API_S__;
+        if (!legacy_vendor && (kAlwaysErrorUserRoot ||
+                               android::base::GetIntProperty("ro.vendor.api_level", 0) > 202404)) {
             return Error() << "No user specified for service '" << service_->name()
                            << "', so it would have been root.";
         } else {
