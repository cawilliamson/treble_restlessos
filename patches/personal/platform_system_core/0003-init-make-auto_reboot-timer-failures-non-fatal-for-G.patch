From d858131039d38c0324f418ac750b30924ed6b8b7 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 17 Mar 2026 17:12:08 +0000
Subject: [PATCH 3/5] init: make auto_reboot timer failures non-fatal for GSI

GrapheneOS's auto-reboot feature uses CLOCK_BOOTTIME_ALARM which requires
CAP_WAKE_ALARM. On some vendor kernels shipped with GKI devices, timer_create
with CLOCK_BOOTTIME_ALARM fails even for root processes, causing LOG(FATAL) to
abort the property service thread and triggering an immediate reboot loop.

Since the auto-reboot feature is not critical for GSI boot, downgrade both
timer_create and timer_settime failures from FATAL to ERROR so the property
service survives and the device can boot normally.
---
 init/property_service.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/init/property_service.cpp b/init/property_service.cpp
index 2ed1578..c96334b 100644
--- a/init/property_service.cpp
+++ b/init/property_service.cpp
@@ -549,7 +549,10 @@ static void auto_reboot_timer_init() {
     sev.sigev_notify_function = auto_reboot_timer_callback;
 
     if (int r = timer_create(CLOCK_BOOTTIME_ALARM, &sev, &auto_reboot_timer); r != 0) {
-        LOG(FATAL) << "auto_reboot: timer_create failed: " << strerror(errno);
+        // On GSI builds, CLOCK_BOOTTIME_ALARM may be unavailable on some vendor
+        // kernels. Downgrade to ERROR so the property service thread survives.
+        LOG(ERROR) << "auto_reboot: timer_create failed: " << strerror(errno)
+                   << " -- auto-reboot feature will be disabled";
     }
 }
 
@@ -564,7 +567,7 @@ static void auto_reboot_timer_set(time_t duration_sec) {
     struct itimerspec ts_prev = {};
     int flags = 0;
     if (int r = timer_settime(auto_reboot_timer, flags, &ts_dur, &ts_prev); r != 0) {
-        LOG(FATAL) << "auto_reboot: timer_settime failed: " << strerror(errno);
+        LOG(ERROR) << "auto_reboot: timer_settime failed: " << strerror(errno);
     }
     if (duration_sec > 0) {
         LOG(INFO) << "auto_reboot: started timer for " << duration_sec << " seconds";
-- 
