From 1641be4087abda274043b15e9157357362831891 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 17 Feb 2026 09:53:26 +0000
Subject: [PATCH] Add Vanadium to HighPriorityMisc WebView providers overlay

The HighPriorityMisc overlay (priority 8998) overrides the lower-priority
device/phh/treble overlay's config_webview_packages.xml at runtime.
Without Vanadium listed here, the framework cannot find a valid WebView
provider on GrapheneOS GSI builds that ship Vanadium (app.vanadium.webview)
instead of Chrome or AOSP WebView.

Add Vanadium as the first entry so the framework recognizes it as the
preferred WebView implementation.

Change-Id: I0000000000000000000000000000000000000011
---
 HighPriorityMisc/res/xml/config_webview_packages.xml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/HighPriorityMisc/res/xml/config_webview_packages.xml b/HighPriorityMisc/res/xml/config_webview_packages.xml
index 8007e93..9fc5467 100644
--- a/HighPriorityMisc/res/xml/config_webview_packages.xml
+++ b/HighPriorityMisc/res/xml/config_webview_packages.xml
@@ -18,6 +18,10 @@
 <!-- Signature checks are ignored if the package is preinstalled or if this is a userdebug or eng
     build. If no signature is provided, the package can provide a WebView implementation only on userdebug/eng builds or if it's preinstalled -->
 <webviewproviders>
+
+    <webviewprovider description="Vanadium" packageName="app.vanadium.webview" availableByDefault="true">
+    </webviewprovider>
+
     <webviewprovider description="Google WebView" packageName="com.google.android.webview" availableByDefault="true" isFallback="true">
         <!-- This provider is marked as a fallback to enable the one-time migration from older OS versions' configurations.
              It will be automatically re-enabled for all users on first boot only, in case it was previously disabled for
-- 
2.52.0

