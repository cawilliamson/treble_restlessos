diff --git a/app/src/main/res/xml/pref_grapheneos.xml b/app/src/main/res/xml/pref_grapheneos.xml
new file mode 100644
index 0000000..edf55fe
--- /dev/null
+++ b/app/src/main/res/xml/pref_grapheneos.xml
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
+    <PreferenceCategory android:title="GrapheneOS hardening"
+        android:summary="These features are disabled by default for maximum vendor compatibility. Enable them individually to improve security, but be aware they may cause issues on some devices. All toggles require a reboot to take effect.">
+        <SwitchPreference
+            android:defaultValue="false"
+            android:key="key_grapheneos_mte_vendor"
+            android:title="Memory tagging for vendor processes"
+            android:summary="Adds random tags to heap pointers in vendor HAL processes (MTE/TBI). Helps detect memory corruption exploits like use-after-free and buffer overflows.\n\nLikely to break: Fingerprint sensors, DRM/Widevine, and other features that use TEE (Trusted Execution Environment) drivers. Vendor kernel drivers that pass pointers via ioctl may reject tagged addresses with EINVAL errors.\n\nReboot required." />
+        <SwitchPreference
+            android:defaultValue="false"
+            android:key="key_grapheneos_stack_hardening"
+            android:title="Hardened thread stacks"
+            android:summary="Increases thread stack size from 1MB to 8MB and inserts randomly-sized unmapped guard regions between the stack and thread-local storage. Makes stack clash attacks and address prediction significantly harder.\n\nLikely to break: TEE drivers (fingerprint, KeyMint, Gatekeeper) and other vendor kernel drivers that assume contiguous thread memory layouts. Can cause intermittent failures that vary per boot due to the randomized guard gaps.\n\nReboot required." />
+        <SwitchPreference
+            android:defaultValue="false"
+            android:key="key_grapheneos_disable_jit"
+            android:title="Disable JIT compilation"
+            android:summary="Disables the Android Runtime JIT compiler and uses full ahead-of-time (AOT) compilation instead. Removes JIT as an attack surface for code injection exploits.\n\nLikely to break: Nothing. May slightly increase app install times and memory usage. Apps that rely on dynamic code generation patterns may run slower.\n\nReboot required." />
+    </PreferenceCategory>
+</PreferenceScreen>
