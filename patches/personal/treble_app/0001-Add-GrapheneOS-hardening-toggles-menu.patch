@@ -0,0 +1,37 @@
+package me.phh.treble.app
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.SystemProperties
+import android.util.Log
+import androidx.preference.PreferenceManager
+
+object GrapheneOS : EntryStartup {
+    val spListener = SharedPreferences.OnSharedPreferenceChangeListener { sp, key ->
+        when (key) {
+            GrapheneOSSettings.mteVendor -> {
+                val value = sp.getBoolean(key, false)
+                Misc.safeSetprop("persist.sys.phh.gos.mte_vendor", if (value) "true" else "false")
+            }
+            GrapheneOSSettings.stackHardening -> {
+                val value = sp.getBoolean(key, false)
+                Misc.safeSetprop("persist.sys.phh.gos.stack_hardening", if (value) "true" else "false")
+            }
+            GrapheneOSSettings.disableJit -> {
+                val value = sp.getBoolean(key, false)
+                Misc.safeSetprop("persist.sys.phh.gos.disable_jit", if (value) "true" else "false")
+            }
+        }
+    }
+
+    override fun startup(ctxt: Context) {
+        if (!GrapheneOSSettings.enabled()) return
+        val sp = PreferenceManager.getDefaultSharedPreferences(ctxt)
+        sp.registerOnSharedPreferenceChangeListener(spListener)
+
+        // Re-apply on boot
+        spListener.onSharedPreferenceChanged(sp, GrapheneOSSettings.mteVendor)
+        spListener.onSharedPreferenceChanged(sp, GrapheneOSSettings.stackHardening)
+        spListener.onSharedPreferenceChanged(sp, GrapheneOSSettings.disableJit)
+    }
+}
