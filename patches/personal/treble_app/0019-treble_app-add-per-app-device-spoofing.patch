+package me.phh.treble.app
+
+import android.app.AlertDialog
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.os.Bundle
+import android.os.SystemProperties
+import android.text.InputType
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.Toast
+import androidx.preference.Preference
+import androidx.preference.PreferenceCategory
+import androidx.preference.PreferenceManager
+
+object SpoofSettings : Settings {
+    val add = "key_spoof_add"
+    val apps = "key_spoof_apps"
+    val packages = "key_spoof_packages"
+
+    // non ro properties cannot hold more than this
+    val maxValueLength = 91
+
+    val fields = listOf(
+        "manufacturer" to "Manufacturer",
+        "brand" to "Brand",
+        "model" to "Model",
+        "device" to "Device",
+        "product" to "Product",
+        "fingerprint" to "Fingerprint",
+        "release" to "Android version",
+    )
+
+    val pixelPreset = mapOf(
+        "manufacturer" to "Google",
+        "brand" to "google",
+        "model" to "Pixel 9 Pro",
+        "device" to "caiman",
+    )
+
+    override fun enabled() = true
+
+    fun lastSegment(pkg: String) = pkg.substringAfterLast('.')
+
+    fun prop(pkg: String, field: String) = "persist.sys.spoof.${lastSegment(pkg)}.$field"
+}
+
+class SpoofSettingsFragment : SettingsFragment() {
+    override val preferencesResId = R.xml.pref_spoof
+
+    private fun saved(ctxt: Context) = PreferenceManager.getDefaultSharedPreferences(ctxt)
+        .getStringSet(SpoofSettings.packages, emptySet())!!.toSet()
+
+    private fun store(ctxt: Context, packages: Set<String>) {
+        PreferenceManager.getDefaultSharedPreferences(ctxt).edit()
+            .putStringSet(SpoofSettings.packages, packages).apply()
+    }
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        super.onCreatePreferences(savedInstanceState, rootKey)
+        findPreference<Preference>(SpoofSettings.add)!!.setOnPreferenceClickListener {
+            pickApp()
+            true
+        }
+        refresh()
+    }
+
+    private fun label(ctxt: Context, pkg: String) = try {
+        ctxt.packageManager.getApplicationInfo(pkg, 0).loadLabel(ctxt.packageManager).toString()
+    } catch (e: Exception) {
+        pkg
+    }
+
+    private fun refresh() {
+        val ctxt = requireContext()
+        val category = findPreference<PreferenceCategory>(SpoofSettings.apps)!!
+        category.removeAll()
+        saved(ctxt).sortedBy { label(ctxt, it).lowercase() }.forEach { pkg ->
+            category.addPreference(Preference(ctxt).apply {
+                title = label(ctxt, pkg)
+                summary = pkg
+                isIconSpaceReserved = false
+                setOnPreferenceClickListener {
+                    edit(pkg)
+                    true
+                }
+            })
+        }
+    }
+
+    private fun pickApp() {
+        val ctxt = requireContext()
+        val pm = ctxt.packageManager
+        val current = saved(ctxt)
+        val candidates = Tools.getInstalledPackages(pm)
+            .filter { it.packageName !in current }
+            .filter {
+                val flags = it.applicationInfo?.flags ?: 0
+                flags and ApplicationInfo.FLAG_SYSTEM == 0 || pm.getLaunchIntentForPackage(it.packageName) != null
+            }
+            .map { it.packageName to label(ctxt, it.packageName) }
+            .sortedBy { it.second.lowercase() }
+        AlertDialog.Builder(ctxt)
+            .setTitle("Add app")
+            .setItems(candidates.map { it.second }.toTypedArray()) { _, which ->
+                val pkg = candidates[which].first
+                val clash = current.find { SpoofSettings.lastSegment(it) == SpoofSettings.lastSegment(pkg) }
+                if (clash != null) {
+                    Toast.makeText(ctxt, "Shares its spoof properties with $clash", Toast.LENGTH_LONG).show()
+                } else {
+                    edit(pkg)
+                }
+            }
+            .show()
+    }
+
+    private fun edit(pkg: String) {
+        val ctxt = requireContext()
+        val inputs = SpoofSettings.fields.associate { (field, name) ->
+            field to EditText(ctxt).apply {
+                hint = name
+                inputType = InputType.TYPE_CLASS_TEXT
+                setSingleLine()
+                setText(SystemProperties.get(SpoofSettings.prop(pkg, field)))
+            }
+        }
+        val form = LinearLayout(ctxt).apply {
+            orientation = LinearLayout.VERTICAL
+            val padding = (20 * resources.displayMetrics.density).toInt()
+            setPadding(padding, padding / 2, padding, 0)
+            addView(Button(ctxt).apply {
+                text = "Use Pixel preset"
+                setOnClickListener {
+                    SpoofSettings.pixelPreset.forEach { (field, value) -> inputs[field]?.setText(value) }
+                }
+            }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+            inputs.values.forEach { addView(it) }
+        }
+        val dialog = AlertDialog.Builder(ctxt)
+            .setTitle(label(ctxt, pkg))
+            .setView(ScrollView(ctxt).apply { addView(form) })
+            .setPositiveButton("Save", null)
+            .setNegativeButton("Cancel", null)
+            .setNeutralButton("Remove") { _, _ ->
+                SpoofSettings.fields.forEach { (field, _) -> Misc.safeSetprop(SpoofSettings.prop(pkg, field), "") }
+                store(ctxt, saved(ctxt) - pkg)
+                refresh()
+            }
+            .create()
+        dialog.setOnShowListener {
+            // set here so a value that is too long keeps the dialog open
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val values = inputs.mapValues { it.value.text.toString().trim() }
+                if (values.values.any { it.length > SpoofSettings.maxValueLength }) {
+                    Toast.makeText(ctxt, "Values are limited to ${SpoofSettings.maxValueLength} characters", Toast.LENGTH_LONG).show()
+                    return@setOnClickListener
+                }
+                values.forEach { (field, value) -> Misc.safeSetprop(SpoofSettings.prop(pkg, field), value) }
+                store(ctxt, saved(ctxt) + pkg)
+                refresh()
+                dialog.dismiss()
+            }
+        }
+        dialog.show()
+    }
+}
