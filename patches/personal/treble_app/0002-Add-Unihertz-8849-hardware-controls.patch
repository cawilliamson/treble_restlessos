+package me.phh.treble.app
+
+import android.os.Bundle
+import android.os.ServiceManager
+import android.util.Log
+import vendor.mediatek.hardware.agolddaemon.IAgoldDaemon
+import java.io.File
+import java.io.IOException
+
+object Tank8849Settings : Settings {
+    val warningLight = "tank8849_warning_light"
+    val campingLight = "tank8849_camping_light"
+    val projectorEnabled = "tank8849_projector_enabled"
+    val projectorMode = "tank8849_projector_mode"
+    val displayEnabled = "tank8849_display_enabled"
+    val brightness = "tank8849_brightness"
+    val keystone = "tank8849_keystone"
+    val autoFocus = "tank8849_auto_focus"
+    val focusCalibration = "tank8849_focus_calibration"
+    val focusAdjust = "tank8849_focus_adjust"
+    val fanSpeed = "tank8849_fan_speed"
+
+    override fun enabled(): Boolean {
+        try {
+            val binder = ServiceManager.checkService(IAgoldDaemon.DESCRIPTOR + "/default")
+            if (binder == null) return false
+            return File("/sys/bus/spi/drivers/fpga_spi/projector_sys_status").exists()
+        } catch (t: Throwable) {
+            Log.d("PHH", "Tank8849 detection failed", t)
+            return false
+        }
+    }
+}
+
+class Tank8849SettingsFragment : SettingsFragment() {
+    override val preferencesResId = R.xml.pref_tank8849
+
+    private fun readSysFile(path: String): String {
+        // Direct file reads are blocked by SELinux for system_app.
+        // Use the Agold daemon's readSysFile method instead, falling
+        // back to shell cat if the daemon is unavailable.
+        try {
+            val binder = ServiceManager.checkService(IAgoldDaemon.DESCRIPTOR + "/default")
+            if (binder != null) {
+                val svc = IAgoldDaemon.Stub.asInterface(binder)
+                val result = svc.readSysFile(path)
+                if (result != null) return result.trim()
+            }
+        } catch (t: Throwable) {
+            Log.d("PHH", "readSysFile via daemon failed for $path", t)
+        }
+        // Fallback: try shell
+        try {
+            val proc = Runtime.getRuntime().exec(arrayOf("cat", path))
+            val result = proc.inputStream.bufferedReader().readText().trim()
+            proc.waitFor()
+            return result
+        } catch (t: Throwable) {
+            Log.d("PHH", "readSysFile via shell failed for $path", t)
+        }
+        return ""
+    }
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        super.onCreatePreferences(savedInstanceState, rootKey)
+
+        // Calibrate focus button: toggle a boolean pref to trigger the spListener
+        val afPref = findPreference<androidx.preference.Preference>("tank8849_auto_focus")
+        afPref?.setOnPreferenceClickListener {
+            val sp = preferenceManager.sharedPreferences ?: return@setOnPreferenceClickListener false
+            val current = sp.getBoolean(Tank8849Settings.autoFocus, false)
+            sp.edit().putBoolean(Tank8849Settings.autoFocus, !current).apply()
+            true
+        }
+
+        // Show temperature as a read-only summary
+        val tempPref = findPreference<androidx.preference.Preference>("tank8849_temp_display")
+        try {
+            val temp = readSysFile("/sys/bus/spi/drivers/fpga_spi/projector_temp")
+            if (temp.isNotEmpty() && temp != "N/A") {
+                tempPref?.summary = "${temp}\u00B0C"
+            } else {
+                tempPref?.summary = "Projector off"
+            }
+        } catch (t: Throwable) {
+            tempPref?.summary = "Unavailable"
+        }
+
+        // Show laser distance as a read-only summary
+        val laserPref = findPreference<androidx.preference.Preference>("tank8849_laser_display")
+        try {
+            val distance = readSysFile("/sys/nds03_ctrl/nds03_read")
+            if (distance.isNotEmpty()) {
+                laserPref?.summary = "${distance} mm"
+            } else {
+                laserPref?.summary = "Unavailable"
+            }
+        } catch (t: Throwable) {
+            laserPref?.summary = "Unavailable"
+        }
+    }
+}
