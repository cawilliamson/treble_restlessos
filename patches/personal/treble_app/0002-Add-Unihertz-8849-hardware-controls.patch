 create mode 100644 app/src/main/java/me/phh/treble/app/Unihertz8849Settings.kt
 create mode 100644 app/src/main/res/values/arrays_unihertz8849.xml
 create mode 100644 app/src/main/res/xml/pref_unihertz8849.xml

