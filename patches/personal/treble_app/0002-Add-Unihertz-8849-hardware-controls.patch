 ....mediatek.hardware.agolddaemon-V1-java.jar | Bin 14002 -> 10444 bytes
 .../java/me/phh/treble/app/EntryService.kt    |   1 +
 .../me/phh/treble/app/SettingsActivity.kt     |   3 +
 .../java/me/phh/treble/app/Unihertz8849.kt    | 715 ++++++++++++++++++
 .../me/phh/treble/app/Unihertz8849Settings.kt | 109 +++
 .../main/res/values/arrays_unihertz8849.xml   |  55 ++
 app/src/main/res/xml/pref_headers.xml         |   3 +
 app/src/main/res/xml/pref_unihertz8849.xml    |  64 ++
 8 files changed, 950 insertions(+)
