+package me.phh.treble.app
+
+import android.content.ContentResolver
+import android.content.Context
+import android.content.SharedPreferences
+import android.graphics.Point
+import android.hardware.Sensor
+import android.hardware.SensorEvent
+import android.hardware.SensorEventListener
+import android.hardware.SensorManager
+import android.os.PowerManager
+import android.os.ServiceManager
+import android.os.SystemClock
+import android.preference.PreferenceManager
+import android.provider.Settings
+import android.util.Log
+import android.view.Display
+import android.view.IWindowManager
+import vendor.mediatek.hardware.agolddaemon.IAgoldDaemon
+import java.io.File
+import kotlin.concurrent.thread
+import kotlin.math.abs
+
+/**
+ * Unihertz 8849 (Tank) hardware controls.
+ *
+ * Controls the built-in projector, warning/camping lights, and provides
+ * auto-keystone correction via accelerometer.
+ *
+ * The projector enable/disable sequence matches the stock Unihertz ROM's
+ * ProjectorController.powerOnOffForPrejectorOn/Off() for the
+ * PROJECT_NEW_FIRMWARE=true, ElephantProduct configuration.
+ *
+ * Auto-keystone is a faithful replica of stock calculateOrientation():
+ * accumulate 10 accelerometer samples over ~2s, compute pitch correction,
+ * write to projector_pitch_setting sysfs, repeat every 3s.
+ *
+ * Factory calibration data is read from the proinfo partition at boot:
+ * - Focus table at offset 0x1000cc (17 CSV values, prefix 550)
+ * - Other calibration at offset 0x10014c (3 CSV values: awb,hori,vert)
+ */
+object Tank8849 : EntryStartup {
+    private const val TAG = "PHH"
+    private const val SYSFS_BASE = "/sys/bus/spi/drivers/fpga_spi"
+    private const val DEFAULT_CALIBRATION = "550,720,711,696,685,672,663,649,638,626,614,599,587,561,548,538,538"
+    private const val PROINFO_FOCUS_OFFSET = 1048780   // 0x1000cc
+    private const val PROINFO_FOCUS_LENGTH = 128
+    private const val PROINFO_OTHER_OFFSET = 1048908   // 0x10014c
+    private const val PROINFO_OTHER_LENGTH = 128
+
+    // Keystone constants from stock calculateOrientation()
+    private const val KEYSTONE_SAMPLE_COUNT = 10
+    private const val KEYSTONE_CYCLE_MS = 3000L         // BackupAgentTimeoutParameters.DEFAULT_QUOTA_EXCEEDED_TIMEOUT_MILLIS
+    private const val KEYSTONE_CHANGE_THRESHOLD = 3.0f
+    private const val PITCH_MIN = -40
+    private const val PITCH_MAX = 25
+
+    private var powerManager: PowerManager? = null
+    private var contentResolver: ContentResolver? = null
+    private var sensorManager: SensorManager? = null
+    private var accelerometer: Sensor? = null
+    private var keystoneListener: SensorEventListener? = null
+
+    // Keystone accumulator state (mirrors stock ProjectorController fields)
+    private var mX = 0f
+    private var mY = 0f
+    private var mZ = 0f
+    private var mRaiseAngle = 0f
+    private var mNewGrivatyVal = 0f
+    private var mOldGrivatyVal = 0f
+    private var mCount = KEYSTONE_SAMPLE_COUNT
+    private var mCountStartTime = 0L
+    private var mKeystoneChange = 1000  // sentinel: no value written yet
+
+    // ─── Utility ────────────────────────────────────────────────────────
+
+    fun writeToFileNofail(path: String, content: String) {
+        try {
+            val proc = Runtime.getRuntime().exec(arrayOf("sh", "-c", "echo '$content' > $path"))
+            proc.waitFor()
+        } catch (t: Throwable) {
+            Log.d(TAG, "Failed writing to $path", t)
+        }
+    }
+
+    private fun readFileNofail(path: String, default: String = ""): String {
+        try {
+            val svc = getAgoldService()
+            if (svc != null) {
+                val result = svc.readSysFile(path)
+                if (result != null) return result.trim()
+            }
+        } catch (_: Throwable) {}
+        try {
+            val proc = Runtime.getRuntime().exec(arrayOf("cat", path))
+            val result = proc.inputStream.bufferedReader().readText().trim()
+            proc.waitFor()
+            if (result.isNotEmpty()) return result
+        } catch (_: Throwable) {}
+        return default
+    }
+
+    private fun getAgoldService(): IAgoldDaemon? {
+        return try {
+            val binder = android.os.Binder.allowBlocking(
+                ServiceManager.waitForDeclaredService(IAgoldDaemon.DESCRIPTOR + "/default"))
+            IAgoldDaemon.Stub.asInterface(binder)
+        } catch (t: Throwable) {
+            Log.d(TAG, "Failed to get Agold service", t)
+            null
+        }
+    }
+
+    private fun sendIoctl(a: Int, b: Int, c: Int, d: Int): Int {
+        val svc = getAgoldService() ?: return -1
+        return try {
+            svc.SendMessageToIoctl(a, b, c, d)
+        } catch (t: Throwable) {
+            Log.d(TAG, "SendMessageToIoctl($a, $b, $c, $d) failed", t)
+            -1
+        }
+    }
+
+    private fun sendCalibration(sp: SharedPreferences) {
+        val calibration = sp.getString(Tank8849Settings.focusCalibration, DEFAULT_CALIBRATION) ?: DEFAULT_CALIBRATION
+        val svc = getAgoldService() ?: return
+        try {
+            svc.cmd(calibration, null)
+            Log.d(TAG, "Tank8849 focus calibration sent: $calibration")
+        } catch (t: Throwable) {
+            Log.d(TAG, "Focus calibration failed", t)
+        }
+    }
+
+    // ─── proinfo calibration ────────────────────────────────────────────
+
+    /**
+     * Read factory focus calibration from the proinfo partition.
+     * Returns the 17-value CSV string (e.g. "550,554,541,...,348") or null.
+     */
+    private fun readProinfoFocusCalibration(): String? {
+        try {
+            val proc = Runtime.getRuntime().exec(arrayOf(
+                "dd", "if=/dev/block/by-name/proinfo",
+                "bs=1", "skip=$PROINFO_FOCUS_OFFSET", "count=$PROINFO_FOCUS_LENGTH"
+            ))
+            val raw = proc.inputStream.bufferedReader().readText()
+                .replace("\u0000", "").trim()
+            proc.waitFor()
+            if (raw.startsWith("550,")) {
+                Log.d(TAG, "Tank8849 proinfo focus calibration: $raw")
+                return raw
+            }
+        } catch (t: Throwable) {
+            Log.d(TAG, "Failed to read proinfo focus calibration", t)
+        }
+        return null
+    }
+
+    /**
+     * Read factory "other" calibration from proinfo (awb,scan_hori,scan_vert).
+     * Returns the 3-value CSV string or null.
+     */
+    private fun readProinfoOtherCalibration(): String? {
+        try {
+            val proc = Runtime.getRuntime().exec(arrayOf(
+                "dd", "if=/dev/block/by-name/proinfo",
+                "bs=1", "skip=$PROINFO_OTHER_OFFSET", "count=$PROINFO_OTHER_LENGTH"
+            ))
+            val raw = proc.inputStream.bufferedReader().readText()
+                .replace("\u0000", "").trim()
+            proc.waitFor()
+            val parts = raw.split(",")
+            if (parts.size >= 3 && parts.all { it.matches(Regex("\\d+")) }) {
+                Log.d(TAG, "Tank8849 proinfo other calibration: $raw")
+                return raw
+            }
+        } catch (t: Throwable) {
+            Log.d(TAG, "Failed to read proinfo other calibration", t)
+        }
+        return null
+    }
+
+    /**
+     * Load factory calibration from proinfo into SharedPreferences if not already set.
+     * Called once at startup.
+     */
+    private fun loadFactoryCalibration(sp: SharedPreferences) {
+        // Focus calibration
+        val currentCal = sp.getString(Tank8849Settings.focusCalibration, null)
+        if (currentCal == null || currentCal == DEFAULT_CALIBRATION) {
+            val factoryCal = readProinfoFocusCalibration()
+            if (factoryCal != null) {
+                sp.edit().putString(Tank8849Settings.focusCalibration, factoryCal).apply()
+                Log.d(TAG, "Tank8849: loaded factory focus calibration from proinfo")
+            }
+        }
+
+        // Other calibration (AWB + H3 scan offsets)
+        val currentOther = sp.getString(Tank8849Settings.otherCalibration, null)
+        if (currentOther == null) {
+            val factoryOther = readProinfoOtherCalibration()
+            if (factoryOther != null) {
+                sp.edit().putString(Tank8849Settings.otherCalibration, factoryOther).apply()
+                Log.d(TAG, "Tank8849: loaded factory other calibration from proinfo")
+            }
+        }
+    }
+
+    // ─── Display management ─────────────────────────────────────────────
+
+    /**
+     * Wait for projector_sys_status to reach the target value.
+     * Re-sends sleep/wake on each poll iteration matching stock checkLcmStatus().
+     */
+    private fun waitForSysStatus(target: Int, timeoutMs: Long = 8000): Boolean {
+        val pm = powerManager ?: return false
+        val start = SystemClock.elapsedRealtime()
+        while (SystemClock.elapsedRealtime() - start < timeoutMs) {
+            val status = readFileNofail("$SYSFS_BASE/projector_sys_status", "-1")
+            if (status == target.toString()) return true
+            // Re-send sleep/wake on each poll, matching stock behavior
+            if (target == 0) {
+                pm.goToSleep(SystemClock.uptimeMillis())
+            } else {
+                pm.wakeUp(SystemClock.uptimeMillis())
+            }
+            Thread.sleep(200)
+        }
+        Log.w(TAG, "Timed out waiting for projector_sys_status == $target")
+        return false
+    }
+
+    private fun getWindowManager(): IWindowManager? {
+        return try {
+            IWindowManager.Stub.asInterface(ServiceManager.getService("window"))
+        } catch (t: Throwable) {
+            Log.e(TAG, "Tank8849: failed to get IWindowManager", t)
+            null
+        }
+    }
+
+    private fun shrinkDisplayForProjector() {
+        try {
+            val wm = getWindowManager() ?: return
+            val size = Point()
+            wm.getInitialDisplaySize(Display.DEFAULT_DISPLAY, size)
+            val width = size.x
+            val height16x9 = width * 16 / 9
+            Log.d(TAG, "Tank8849: shrinking display from ${size.x}x${size.y} to ${width}x${height16x9}")
+            wm.setForcedDisplaySize(Display.DEFAULT_DISPLAY, width, height16x9)
+        } catch (t: Throwable) {
+            Log.e(TAG, "Tank8849: failed to shrink display", t)
+        }
+    }
+
+    private fun restoreDisplay() {
+        try {
+            val wm = getWindowManager() ?: return
+            Log.d(TAG, "Tank8849: restoring display to original size")
+            wm.clearForcedDisplaySize(Display.DEFAULT_DISPLAY)
+        } catch (t: Throwable) {
+            Log.e(TAG, "Tank8849: failed to restore display", t)
+        }
+    }
+
+    /**
+     * Temporarily disable Always-on Display. Returns true if AoD was enabled.
+     * GrapheneOS enables AoD by default; stock Unihertz ROM does not.
+     * AoD prevents the display from fully sleeping (stays in Doze state).
+     */
+    private fun disableAoD(): Boolean {
+        val cr = contentResolver ?: return false
+        val wasEnabled = try {
+            Settings.Secure.getInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 0) != 0
+        } catch (_: Throwable) { false }
+
+        if (wasEnabled) {
+            try {
+                Settings.Secure.putInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 0)
+                Thread.sleep(200)
+            } catch (t: Throwable) {
+                Log.w(TAG, "Failed to disable AoD", t)
+            }
+        }
+        return wasEnabled
+    }
+
+    private fun restoreAoD(wasEnabled: Boolean) {
+        if (!wasEnabled) return
+        val cr = contentResolver ?: return
+        try {
+            Settings.Secure.putInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 1)
+        } catch (t: Throwable) {
+            Log.w(TAG, "Failed to restore AoD", t)
+        }
+    }
+
+    // ─── Projector enable/disable ───────────────────────────────────────
+
+    /**
+     * Enable the projector. Matches stock powerOnOffForPrejectorOn() sequence
+     * for PROJECT_NEW_FIRMWARE=true, ElephantProduct device.
+     */
+    private fun enableProjector(sp: SharedPreferences) {
+        thread {
+            val mode = sp.getString(Tank8849Settings.projectorMode, "3") ?: "3"
+            val pm = powerManager ?: return@thread
+
+            // Step 1: Shrink display to 16:9 FIRST (stock does changeScreenSize(1) first)
+            Log.d(TAG, "Tank8849 enable: shrinking display to 16:9")
+            shrinkDisplayForProjector()
+
+            // Step 2: Disable AoD
+            val aodWasEnabled = disableAoD()
+
+            // Step 3: Pre-load focus calibration (motor_routine_thread needs it before projector on)
+            Log.d(TAG, "Tank8849 enable: pre-loading focus calibration")
+            sendCalibration(sp)
+
+            // Step 4: Sleep display and wait for sys_status == 0
+            Log.d(TAG, "Tank8849 enable: sleeping display")
+            pm.goToSleep(SystemClock.uptimeMillis())
+            if (!waitForSysStatus(0)) {
+                Log.e(TAG, "Tank8849 enable: display failed to sleep, aborting")
+                restoreAoD(aodWasEnabled)
+                restoreDisplay()
+                return@thread
+            }
+
+            // Step 5: Disable phone display
+            Log.d(TAG, "Tank8849 enable: ioctl 500 0 0 4")
+            sendIoctl(500, 0, 0, 4)
+
+            // Step 6: Hardware init (may not be supported on all firmware)
+            Log.d(TAG, "Tank8849 enable: ioctl 500 0 0 6")
+            val initResult = sendIoctl(500, 0, 0, 6)
+            if (initResult == -1) {
+                Log.d(TAG, "Tank8849 enable: ioctl 500 0 0 6 not supported, continuing")
+            }
+
+            // Step 7: Wake display and wait for sys_status == 1
+            Log.d(TAG, "Tank8849 enable: waking display")
+            pm.wakeUp(SystemClock.uptimeMillis())
+            if (!waitForSysStatus(1)) {
+                Log.e(TAG, "Tank8849 enable: display failed to wake, aborting")
+                restoreAoD(aodWasEnabled)
+                restoreDisplay()
+                return@thread
+            }
+
+            // Step 8: Set projector mode
+            Log.d(TAG, "Tank8849 enable: ioctl 500 0 $mode 0")
+            sendIoctl(500, 0, mode.toInt(), 0)
+            Thread.sleep(100)
+
+            // Step 9: Re-enable phone display
+            Log.d(TAG, "Tank8849 enable: ioctl 500 0 0 3")
+            sendIoctl(500, 0, 0, 3)
+
+            // Step 10: Restore AoD
+            restoreAoD(aodWasEnabled)
+
+            // Step 11: Apply "other" calibration (AWB + H3 scan offsets from proinfo)
+            val otherCal = sp.getString(Tank8849Settings.otherCalibration, null)
+            if (otherCal != null) {
+                val parts = otherCal.split(",")
+                if (parts.size >= 3) {
+                    Log.d(TAG, "Tank8849 enable: applying other calibration: $otherCal")
+                    writeToFileNofail("$SYSFS_BASE/dlpc3421_awb_cali", parts[0])
+                    writeToFileNofail("$SYSFS_BASE/fpga_h3_scan_hori", parts[1])
+                    writeToFileNofail("$SYSFS_BASE/fpga_h3_scan_vert", parts[2])
+                }
+            }
+
+            // Step 12: Re-send focus calibration (reinforcement after mode set)
+            Log.d(TAG, "Tank8849 enable: re-sending focus calibration")
+            sendCalibration(sp)
+
+            // Step 13: Set initial pitch to 0 (no keystone correction when flat)
+            writeToFileNofail("$SYSFS_BASE/projector_pitch_setting", "0")
+
+            // Step 14: Set fan speed
+            val fanSpeed = sp.getString(Tank8849Settings.fanSpeed, "50") ?: "50"
+            writeToFileNofail("$SYSFS_BASE/projector_fan_en", fanSpeed)
+
+            // Step 15: Set brightness
+            val brightness = sp.getString(Tank8849Settings.brightness, "128") ?: "128"
+            writeToFileNofail("$SYSFS_BASE/projector_rgb_current", brightness)
+
+            // Step 16: Start auto-keystone if enabled
+            val autoKeystone = sp.getBoolean(Tank8849Settings.autoKeystone, true)
+            if (autoKeystone) {
+                startAutoKeystone()
+            }
+
+            Log.d(TAG, "Tank8849 enable: done")
+        }
+    }
+
+    /**
+     * Disable the projector. Matches stock powerOnOffForPrejectorOff() sequence
+     * for PROJECT_NEW_FIRMWARE=true, ElephantProduct device.
+     */
+    private fun disableProjector() {
+        thread {
+            // Stop auto-keystone first
+            stopAutoKeystone()
+
+            // Step 1: Disable phone display
+            Log.d(TAG, "Tank8849 disable: ioctl 500 0 0 4")
+            sendIoctl(500, 0, 0, 4)
+            Thread.sleep(500)
+
+            // Step 2: Turn off projector LED
+            Log.d(TAG, "Tank8849 disable: ioctl 500 0 0 1")
+            sendIoctl(500, 0, 0, 1)
+
+            // Step 3: Set mode off
+            Log.d(TAG, "Tank8849 disable: ioctl 500 0 0 0")
+            sendIoctl(500, 0, 0, 0)
+
+            // Step 4: Re-enable phone display
+            Log.d(TAG, "Tank8849 disable: ioctl 500 0 0 3")
+            sendIoctl(500, 0, 0, 3)
+            Thread.sleep(50)
+
+            // Step 5: Sleep/wake cycle for display reset
+            val aodWasEnabled = disableAoD()
+            val pm = powerManager
+            if (pm != null) {
+                pm.goToSleep(SystemClock.uptimeMillis())
+                waitForSysStatus(0)
+                pm.wakeUp(SystemClock.uptimeMillis())
+                waitForSysStatus(1)
+            }
+            restoreAoD(aodWasEnabled)
+            Thread.sleep(100)
+
+            // Step 6: Restore display
+            restoreDisplay()
+
+            Log.d(TAG, "Tank8849 disable: done")
+        }
+    }
+
+    // ─── Auto-keystone ──────────────────────────────────────────────────
+
+    /**
+     * Start auto-keystone correction via accelerometer.
+     * Exact replica of stock ProjectorController.computeKeystoneFromSensor()
+     * and calculateOrientation().
+     */
+    private fun startAutoKeystone() {
+        if (keystoneListener != null) return  // already running
+        val sm = sensorManager ?: return
+        val accel = accelerometer ?: return
+
+        // Reset accumulator state
+        mX = 0f; mY = 0f; mZ = 0f
+        mRaiseAngle = 0f
+        mNewGrivatyVal = 0f
+        mOldGrivatyVal = 0f
+        mCount = KEYSTONE_SAMPLE_COUNT
+        mCountStartTime = 0L
+        mKeystoneChange = 1000
+
+        val listener = object : SensorEventListener {
+            override fun onSensorChanged(event: SensorEvent) {
+                calculateOrientation(event)
+            }
+            override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
+        }
+        keystoneListener = listener
+
+        // Stock uses SENSOR_DELAY_NORMAL (3) = ~200ms between samples
+        sm.registerListener(listener, accel, SensorManager.SENSOR_DELAY_NORMAL)
+        Log.d(TAG, "Tank8849: auto-keystone started")
+    }
+
+    private fun stopAutoKeystone() {
+        val listener = keystoneListener ?: return
+        sensorManager?.unregisterListener(listener)
+        keystoneListener = null
+
+        // Reset pitch to 0 on stop
+        writeToFileNofail("$SYSFS_BASE/projector_pitch_setting", "0")
+        Log.d(TAG, "Tank8849: auto-keystone stopped, pitch reset to 0")
+    }
+
+    /**
+     * Stock calculateOrientation() algorithm, exact replica.
+     *
+     * Accumulation phase (mCount > 0):
+     *   Sum raw X, Y, Z values over 10 samples (~2 seconds at 200ms)
+     *   mRaiseAngle = accumulated Y sum (non-tablet mode)
+     *
+     * Compute phase (mCount == 0):
+     *   If |mRaiseAngle| >= 75: use Z; else use mRaiseAngle
+     *   Scale by 1.68, clamp -100..+100
+     *   ElephantProduct: negate and scale by 0.4
+     *   If change > 3: write pitch to sysfs
+     *
+     * Idle phase (mCount < 0):
+     *   Do nothing until 3-second timer resets cycle.
+     */
+    private fun calculateOrientation(event: SensorEvent) {
+        if (mCountStartTime == 0L) {
+            mCountStartTime = SystemClock.elapsedRealtime()
+        }
+
+        val values = event.values
+
+        if (mCount > 0) {
+            // Accumulate phase: sum raw values (NOT average)
+            mX += values[0]
+            mY += values[1]
+            mZ += values[2]
+            mCount--
+
+            // Non-tablet: raise angle = accumulated Y
+            mRaiseAngle = mY
+
+        } else if (mCount == 0) {
+            // Compute phase
+            var gval: Float
+            var raise = mRaiseAngle
+
+            if (raise >= 75.0f) {
+                gval = mZ
+            } else if (raise < -75.0f) {
+                gval = -mZ
+            } else {
+                if (mZ > 80.0f) {
+                    raise = -raise
+                }
+                gval = raise
+            }
+
+            // Scale by 1.68
+            gval = (gval * 1.68).toFloat()
+
+            // Clamp to -100..+100
+            if (gval > 100.0f) gval = 100.0f
+            if (gval < -100.0f) gval = -100.0f
+
+            // ElephantProduct: negate and scale by 0.4
+            mNewGrivatyVal = (-gval) * 0.4f
+
+            // Only update if change exceeds threshold (stock uses 3.0)
+            if (abs(mNewGrivatyVal - mOldGrivatyVal) > KEYSTONE_CHANGE_THRESHOLD) {
+                mOldGrivatyVal = mNewGrivatyVal
+
+                // Stock saves -((int)mNewGrivatyVal) to settings.
+                // On GSI the correction direction is inverted, so we use
+                // (int)(mNewGrivatyVal) directly (drop the outer negation).
+                var keystoneValue = mNewGrivatyVal.toInt()
+
+                // Clamp to DLPC3421 valid range
+                if (keystoneValue > PITCH_MAX) keystoneValue = PITCH_MAX
+                if (keystoneValue < PITCH_MIN) keystoneValue = PITCH_MIN
+
+                if (keystoneValue != mKeystoneChange) {
+                    mKeystoneChange = keystoneValue
+                    writeToFileNofail("$SYSFS_BASE/projector_pitch_setting", keystoneValue.toString())
+                    Log.d(TAG, "Tank8849 keystone: pitch=$keystoneValue (raise=$mRaiseAngle gval=$gval)")
+                }
+            }
+
+            // Move to idle phase
+            mCount--
+        }
+        // mCount < 0: idle, do nothing until timer resets
+
+        // Reset every 3 seconds (stock: BackupAgentTimeoutParameters.DEFAULT_QUOTA_EXCEEDED_TIMEOUT_MILLIS = 3000)
+        if (SystemClock.elapsedRealtime() - mCountStartTime > KEYSTONE_CYCLE_MS) {
+            mCountStartTime = 0L
+            mCount = KEYSTONE_SAMPLE_COUNT
+            mX = 0f
+            mY = 0f
+            mZ = 0f
+            mRaiseAngle = 0f
+            mNewGrivatyVal = 0f
+        }
+    }
+
+    // ─── Focus calibration sweep ────────────────────────────────────────
+
+    fun runFocusCalibration(sp: SharedPreferences) {
+        Log.d(TAG, "Tank8849: starting focus calibration sweep")
+
+        val mode = sp.getString(Tank8849Settings.projectorMode, "3") ?: "3"
+        sendIoctl(500, 0, mode.toInt(), 0)
+        Thread.sleep(2000)
+
+        Log.d(TAG, "Tank8849: running motor sweep")
+        writeToFileNofail("$SYSFS_BASE/focus_auto_calibration", "1")
+        Thread.sleep(10000)
+
+        try {
+            val proc = Runtime.getRuntime().exec(arrayOf("dmesg"))
+            val dmesg = proc.inputStream.bufferedReader().readText()
+            proc.waitFor()
+            val pattern = Regex("""\[init_cali_buff\]\[(\d+)\]\[(\d+)\]""")
+            val matches = pattern.findAll(dmesg).toList()
+            if (matches.size >= 16) {
+                val rawValues = matches.takeLast(16).map { it.groupValues[2].toInt() }
+                if (rawValues.all { it == 0 }) {
+                    Log.w(TAG, "Tank8849: sweep returned all zeros")
+                    return
+                }
+                val calibration = "550," + rawValues.joinToString(",")
+                Log.d(TAG, "Tank8849: calibration result: $calibration")
+                sp.edit().putString(Tank8849Settings.focusCalibration, calibration).apply()
+
+                sendIoctl(500, 0, 0, 0)
+                Thread.sleep(1000)
+                sendCalibration(sp)
+                sendIoctl(500, 0, mode.toInt(), 0)
+                Log.d(TAG, "Tank8849: projector restarted with calibrated values")
+            } else {
+                Log.w(TAG, "Tank8849: sweep produced ${matches.size} values, expected 16")
+            }
+        } catch (t: Throwable) {
+            Log.e(TAG, "Tank8849: failed to parse calibration from dmesg", t)
+        }
+    }
+
+    // ─── SharedPreferences listener ─────────────────────────────────────
+
+    val spListener = SharedPreferences.OnSharedPreferenceChangeListener { sp, key ->
+        when (key) {
+            Tank8849Settings.warningLight -> {
+                val value = (sp.getString(key, "0") ?: "0").toInt()
+                sendIoctl(310, 0, value, 0)
+            }
+            Tank8849Settings.campingLight -> {
+                val value = (sp.getString(key, "0") ?: "0").toInt()
+                sendIoctl(301, 0, value, 0)
+            }
+            Tank8849Settings.projectorEnabled -> {
+                val enabled = sp.getBoolean(key, false)
+                if (enabled) {
+                    enableProjector(sp)
+                } else {
+                    disableProjector()
+                }
+            }
+            Tank8849Settings.projectorMode -> {
+                val enabled = sp.getBoolean(Tank8849Settings.projectorEnabled, false)
+                if (enabled) {
+                    val mode = sp.getString(key, "3") ?: "3"
+                    sendIoctl(500, 0, mode.toInt(), 0)
+                    // Re-send calibration after mode switch
+                    sendCalibration(sp)
+                }
+            }
+            Tank8849Settings.displayEnabled -> {
+                val enabled = sp.getBoolean(key, true)
+                sendIoctl(500, 0, 0, if (enabled) 3 else 4)
+            }
+            Tank8849Settings.brightness -> {
+                val value = sp.getString(key, "128") ?: "128"
+                writeToFileNofail("$SYSFS_BASE/projector_rgb_current", value)
+            }
+            Tank8849Settings.keystone -> {
+                val value = sp.getString(key, "0") ?: "0"
+                writeToFileNofail("$SYSFS_BASE/projector_pitch_setting", value)
+            }
+            Tank8849Settings.autoKeystone -> {
+                val enabled = sp.getBoolean(key, true)
+                val projectorOn = sp.getBoolean(Tank8849Settings.projectorEnabled, false)
+                if (enabled && projectorOn) {
+                    startAutoKeystone()
+                } else {
+                    stopAutoKeystone()
+                }
+            }
+            Tank8849Settings.autoFocus -> {
+                thread { runFocusCalibration(sp) }
+            }
+            Tank8849Settings.focusCalibration -> {
+                sendCalibration(sp)
+            }
+            Tank8849Settings.focusAdjust -> {
+                val value = sp.getString(key, "0") ?: "0"
+                writeToFileNofail("$SYSFS_BASE/motor_turn_mode_step", value)
+            }
+            Tank8849Settings.fanSpeed -> {
+                val value = sp.getString(key, "50") ?: "50"
+                writeToFileNofail("$SYSFS_BASE/projector_fan_en", value)
+            }
+        }
+    }
+
+    // ─── Startup ────────────────────────────────────────────────────────
+
+    override fun startup(ctxt: Context) {
+        if (!Tank8849Settings.enabled()) return
+
+        powerManager = ctxt.getSystemService(Context.POWER_SERVICE) as PowerManager
+        contentResolver = ctxt.contentResolver
+        sensorManager = ctxt.getSystemService(Context.SENSOR_SERVICE) as? SensorManager
+        accelerometer = sensorManager?.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
+
+        val sp = PreferenceManager.getDefaultSharedPreferences(ctxt)
+
+        // Load factory calibration from proinfo on first boot
+        loadFactoryCalibration(sp)
+
+        sp.registerOnSharedPreferenceChangeListener(spListener)
+
+        // Refresh fan speed on boot (don't auto-enable projector on boot)
+        spListener.onSharedPreferenceChanged(sp, Tank8849Settings.fanSpeed)
+    }
+}
diff --git a/app/src/main/java/me/phh/treble/app/Tank8849Settings.kt b/app/src/main/java/me/phh/treble/app/Tank8849Settings.kt
