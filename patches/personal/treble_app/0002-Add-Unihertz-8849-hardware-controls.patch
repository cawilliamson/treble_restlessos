+++ b/app/src/main/java/me/phh/treble/app/Tank8849.kt
@@ -0,0 +1,291 @@
+package me.phh.treble.app
+
+import android.content.ContentResolver
+import android.content.Context
+import android.content.SharedPreferences
+import android.graphics.Point
+import android.os.PowerManager
+import android.os.ServiceManager
+import android.os.SystemClock
+import android.preference.PreferenceManager
+import android.provider.Settings
+import android.util.Log
+import android.view.Display
+import android.view.IWindowManager
+import vendor.mediatek.hardware.agolddaemon.IAgoldDaemon
+import java.io.File
+import kotlin.concurrent.thread
+
+object Tank8849 : EntryStartup {
+    private const val SYSFS_BASE = "/sys/bus/spi/drivers/fpga_spi"
+    private const val DEFAULT_CALIBRATION = "550,720,711,696,685,672,663,649,638,626,614,599,587,561,548,538,538"
+    private var powerManager: PowerManager? = null
+    private var contentResolver: ContentResolver? = null
+
+    fun writeToFileNofail(path: String, content: String) {
+        try {
+            File(path).printWriter().use { it.println(content) }
+        } catch (t: Throwable) {
+            Log.d("PHH", "Failed writing to $path", t)
+        }
+    }
+
+    private fun readFileNofail(path: String, default: String = ""): String {
+        return try {
+            File(path).readText().trim()
+        } catch (t: Throwable) {
+            default
+        }
+    }
+
+    private fun getAgoldService(): IAgoldDaemon? {
+        return try {
+            val binder = android.os.Binder.allowBlocking(
+                ServiceManager.waitForDeclaredService(IAgoldDaemon.DESCRIPTOR + "/default"))
+            IAgoldDaemon.Stub.asInterface(binder)
+        } catch (t: Throwable) {
+            Log.d("PHH", "Failed to get Agold service", t)
+            null
+        }
+    }
+
+    private fun sendIoctl(a: Int, b: Int, c: Int, d: Int): Int {
+        val svc = getAgoldService() ?: return -1
+        return try {
+            svc.SendMessageToIoctl(a, b, c, d)
+        } catch (t: Throwable) {
+            Log.d("PHH", "SendMessageToIoctl($a, $b, $c, $d) failed", t)
+            -1
+        }
+    }
+
+    private fun sendCalibration(sp: SharedPreferences) {
+        val calibration = sp.getString(Tank8849Settings.focusCalibration, DEFAULT_CALIBRATION) ?: DEFAULT_CALIBRATION
+        val svc = getAgoldService() ?: return
+        try {
+            svc.cmd(calibration, null)
+            Log.d("PHH", "Tank8849 focus calibration sent: $calibration")
+        } catch (t: Throwable) {
+            Log.d("PHH", "Focus calibration failed", t)
+        }
+    }
+
+    private fun waitForSysStatus(target: Int, timeoutMs: Long = 5000): Boolean {
+        val start = SystemClock.elapsedRealtime()
+        while (SystemClock.elapsedRealtime() - start < timeoutMs) {
+            val status = readFileNofail("$SYSFS_BASE/projector_sys_status", "-1")
+            if (status == target.toString()) return true
+            Thread.sleep(100)
+        }
+        Log.w("PHH", "Timed out waiting for projector_sys_status == $target")
+        return false
+    }
+
+    fun runFocusCalibration(sp: SharedPreferences) {
+        // Run the hardware motor calibration sweep to determine per-device
+        // focus values. The kernel driver logs the results as init_cali_buff
+        // entries in dmesg. We parse those and prepend the fixed offset 550
+        // to form the 17-value calibration string expected by the daemon.
+        Log.d("PHH", "Tank8849: starting focus calibration sweep")
+        writeToFileNofail("$SYSFS_BASE/focus_auto_calibration", "1")
+        // The sweep takes ~8 seconds to complete
+        Thread.sleep(10000)
+
+        try {
+            val dmesg = Runtime.getRuntime().exec("dmesg").inputStream.bufferedReader().readText()
+            val pattern = Regex("""\[init_cali_buff\]\[(\d+)\]\[(\d+)\]""")
+            val matches = pattern.findAll(dmesg).toList()
+            if (matches.size >= 16) {
+                // Take the last 16 matches (in case calibration ran multiple times)
+                val values = matches.takeLast(16).map { it.groupValues[2] }
+                val calibration = "550," + values.joinToString(",")
+                Log.d("PHH", "Tank8849: calibration result: $calibration")
+                sp.edit().putString(Tank8849Settings.focusCalibration, calibration).apply()
+            } else {
+                Log.w("PHH", "Tank8849: calibration sweep produced ${matches.size} values, expected 16")
+            }
+        } catch (t: Throwable) {
+            Log.e("PHH", "Tank8849: failed to parse calibration from dmesg", t)
+        }
+    }
+
+    private fun getWindowManager(): IWindowManager? {
+        return try {
+            IWindowManager.Stub.asInterface(ServiceManager.getService("window"))
+        } catch (t: Throwable) {
+            Log.e("PHH", "Tank8849: failed to get IWindowManager", t)
+            null
+        }
+    }
+
+    private fun shrinkDisplayForProjector() {
+        // The projector has a 16:9 aspect ratio but the phone display is taller
+        // (e.g. 20:9). Shrink the display viewport to 16:9 so the full UI fits
+        // within the projected area, with black bars top and bottom on the phone.
+        val wm = getWindowManager() ?: return
+        try {
+            val size = Point()
+            wm.getInitialDisplaySize(Display.DEFAULT_DISPLAY, size)
+            val width = size.x
+            val height16x9 = width * 16 / 9
+            Log.d("PHH", "Tank8849: shrinking display from ${size.x}x${size.y} to ${width}x${height16x9}")
+            wm.setForcedDisplayScalingMode(Display.DEFAULT_DISPLAY, 1) // DISABLED
+            wm.setForcedDisplaySize(Display.DEFAULT_DISPLAY, width, height16x9)
+        } catch (t: Throwable) {
+            Log.e("PHH", "Tank8849: failed to shrink display", t)
+        }
+    }
+
+    private fun restoreDisplay() {
+        val wm = getWindowManager() ?: return
+        try {
+            Log.d("PHH", "Tank8849: restoring display to original size")
+            wm.setForcedDisplayScalingMode(Display.DEFAULT_DISPLAY, 0) // AUTO
+            wm.clearForcedDisplaySize(Display.DEFAULT_DISPLAY)
+        } catch (t: Throwable) {
+            Log.e("PHH", "Tank8849: failed to restore display", t)
+        }
+    }
+
+    private fun enableProjector(sp: SharedPreferences) {
+        // The projector requires a display sleep/wake cycle to initialize
+        // the FPGA properly. Sequence from vendor:
+        // 1. Send focus calibration
+        // 2. Temporarily disable AoD so display fully sleeps
+        // 3. Sleep the display
+        // 4. Wait for projector_sys_status == 0
+        // 5. Send projector ioctl to turn on
+        // 6. Wake the display
+        // 7. Wait for projector_sys_status == 1
+        // 8. Restore AoD to its previous state
+        thread {
+            val mode = sp.getString(Tank8849Settings.projectorMode, "3") ?: "3"
+            val pm = powerManager ?: return@thread
+            val cr = contentResolver ?: return@thread
+
+            Log.d("PHH", "Tank8849 enable: sending calibration")
+            sendCalibration(sp)
+
+            // Save and disable AoD so goToSleep fully turns off the display
+            val aodWasEnabled = try {
+                Settings.Secure.getInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 0) != 0
+            } catch (t: Throwable) { false }
+
+            if (aodWasEnabled) {
+                Log.d("PHH", "Tank8849 enable: temporarily disabling AoD")
+                try {
+                    Settings.Secure.putInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 0)
+                } catch (t: Throwable) {
+                    Log.w("PHH", "Failed to disable AoD", t)
+                }
+                // Give the system a moment to process the AoD change
+                Thread.sleep(200)
+            }
+
+            Log.d("PHH", "Tank8849 enable: sleeping display")
+            pm.goToSleep(SystemClock.uptimeMillis())
+            waitForSysStatus(0)
+
+            Log.d("PHH", "Tank8849 enable: sending ioctl 500 0 $mode 0")
+            sendIoctl(500, 0, mode.toInt(), 0)
+
+            Log.d("PHH", "Tank8849 enable: waking display")
+            pm.wakeUp(SystemClock.uptimeMillis())
+            waitForSysStatus(1)
+
+            // Shrink display viewport to match projector aspect ratio
+            shrinkDisplayForProjector()
+
+            // Restore AoD if it was enabled before
+            if (aodWasEnabled) {
+                Log.d("PHH", "Tank8849 enable: restoring AoD")
+                try {
+                    Settings.Secure.putInt(cr, Settings.Secure.DOZE_ALWAYS_ON, 1)
+                } catch (t: Throwable) {
+                    Log.w("PHH", "Failed to restore AoD", t)
+                }
+            }
+
+            Log.d("PHH", "Tank8849 enable: done")
+        }
+    }
+
+    val spListener = SharedPreferences.OnSharedPreferenceChangeListener { sp, key ->
+        when (key) {
+            Tank8849Settings.warningLight -> {
+                val value = (sp.getString(key, "0") ?: "0").toInt()
+                Log.d("PHH", "Tank8849 warning light: $value")
+                sendIoctl(310, 0, value, 0)
+            }
+            Tank8849Settings.campingLight -> {
+                val value = (sp.getString(key, "0") ?: "0").toInt()
+                Log.d("PHH", "Tank8849 camping light: $value")
+                sendIoctl(301, 0, value, 0)
+            }
+            Tank8849Settings.projectorEnabled -> {
+                val enabled = sp.getBoolean(key, false)
+                if (enabled) {
+                    enableProjector(sp)
+                } else {
+                    sendIoctl(500, 0, 0, 0)
+                    restoreDisplay()
+                }
+            }
+            Tank8849Settings.projectorMode -> {
+                val enabled = sp.getBoolean(Tank8849Settings.projectorEnabled, false)
+                if (enabled) {
+                    val mode = sp.getString(key, "3") ?: "3"
+                    sendIoctl(500, 0, mode.toInt(), 0)
+                }
+            }
+            Tank8849Settings.displayEnabled -> {
+                val enabled = sp.getBoolean(key, true)
+                if (enabled) {
+                    sendIoctl(500, 0, 0, 3)
+                } else {
+                    sendIoctl(500, 0, 0, 4)
+                }
+            }
+            Tank8849Settings.brightness -> {
+                val value = sp.getString(key, "128") ?: "128"
+                writeToFileNofail("$SYSFS_BASE/projector_rgb_current", value)
+            }
+            Tank8849Settings.keystone -> {
+                val value = sp.getString(key, "0") ?: "0"
+                writeToFileNofail("$SYSFS_BASE/projector_pitch_set", value)
+            }
+            Tank8849Settings.autoFocus -> {
+                Log.d("PHH", "Tank8849: running focus calibration")
+                thread {
+                    runFocusCalibration(sp)
+                    // Re-send the newly calibrated values to the daemon
+                    sendCalibration(sp)
+                }
+            }
+            Tank8849Settings.focusCalibration -> {
+                sendCalibration(sp)
+            }
+            Tank8849Settings.focusAdjust -> {
+                val value = sp.getString(key, "0") ?: "0"
+                writeToFileNofail("$SYSFS_BASE/motor_turn_mode_step", value)
+            }
+            Tank8849Settings.fanSpeed -> {
+                val value = sp.getString(key, "50") ?: "50"
+                writeToFileNofail("$SYSFS_BASE/projector_fan_en", value)
+            }
+        }
+    }
+
+    override fun startup(ctxt: Context) {
+        if (!Tank8849Settings.enabled()) return
+
+        powerManager = ctxt.getSystemService(Context.POWER_SERVICE) as PowerManager
+        contentResolver = ctxt.contentResolver
+
+        val sp = PreferenceManager.getDefaultSharedPreferences(ctxt)
+        sp.registerOnSharedPreferenceChangeListener(spListener)
+
+        // Refresh fan speed on boot (don't auto-enable projector on boot)
+        spListener.onSharedPreferenceChanged(sp, Tank8849Settings.fanSpeed)
+    }
+}
