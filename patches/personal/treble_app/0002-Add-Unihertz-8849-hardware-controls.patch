+            android:entryValues="@array/pref_tank8849_mode_values"
+            android:key="tank8849_projector_mode"
+            android:title="Projection mode"
+            app:summary="Orientation and aspect ratio" />
+        <CheckBoxPreference
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:defaultValue="true"
+            android:key="tank8849_display_enabled"
+            android:title="Display"
+            app:summary="Keep the phone display on while projecting" />
+    </PreferenceCategory>
+    <PreferenceCategory android:title="Image">
+        <EditTextPreference
+            android:defaultValue="128"
+            android:key="tank8849_brightness"
+            android:title="Brightness"
+            app:summary="Projector brightness (1-255)" />
+        <EditTextPreference
+            android:defaultValue="0"
