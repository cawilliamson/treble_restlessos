diff --git a/app/src/main/java/me/phh/treble/app/MainSettingsFragment.kt b/app/src/main/java/me/phh/treble/app/MainSettingsFragment.kt
new file mode 100644
index 0000000..f7e8408
--- /dev/null
+++ b/app/src/main/java/me/phh/treble/app/MainSettingsFragment.kt
@@ -0,0 +1,69 @@
+package me.phh.treble.app
+
+import android.content.Intent
+import android.os.Bundle
+import android.os.SystemProperties
+import androidx.preference.Preference
+import androidx.preference.PreferenceFragmentCompat
+
+class MainSettingsFragment : SettingsFragment() {
+    override val preferencesResId = R.xml.pref_main
+
+    private class Entry(val settings: Settings?, val createFragment: () -> androidx.fragment.app.Fragment)
+
+    private val screens = mapOf(
+        "my_device" to Entry(MyDeviceSettings, ::MyDeviceSettingsFragment),
+        "asus" to Entry(AsusSettings, ::AsusSettingsFragment),
+        "huawei" to Entry(HuaweiSettings, ::HuaweiSettingsFragment),
+        "lenovo" to Entry(LenovoSettings, ::LenovoSettingsFragment),
+        "nubia" to Entry(NubiaSettings, ::NubiaSettingsFragment),
+        "oneplus" to Entry(OnePlusSettings, ::OnePlusSettingsFragment),
+        "oppo" to Entry(OppoSettings, ::OppoSettingsFragment),
+        "samsung" to Entry(SamsungSettings, ::SamsungSettingsFragment),
+        "transsion" to Entry(TranssionSettings, ::TranssionSettingsFragment),
+        "unihertz8849" to Entry(Unihertz8849Settings, ::Unihertz8849SettingsFragment),
+        "vsmart" to Entry(VsmartSettings, ::VsmartSettingsFragment),
+        "xiaomi" to Entry(XiaomiSettings, ::XiaomiSettingsFragment),
+        "doze" to Entry(null, ::DozeSettingsFragment),
+        "hardening" to Entry(HardeningSettings, ::HardeningSettingsFragment),
+        "ims" to Entry(ImsSettings, ::ImsSettingsFragment),
+        "misc" to Entry(null, ::MiscSettingsFragment),
+        "custom" to Entry(CustomSettings, ::CustomSettingsFragment),
+        "audio_effects" to Entry(null, ::AudioEffectsFragment),
+    )
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        super.onCreatePreferences(savedInstanceState, rootKey)
+        screens.forEach { (key, entry) ->
+            val settings = entry.settings ?: return@forEach
+            if (!settings.enabled())
+                findPreference<Preference>(key)?.isVisible = false
+        }
+        if (SystemProperties.get("ro.system.ota.json_url", "").trim() == "")
+            findPreference<Preference>("updater")?.isVisible = false
+        // collapse categories whose entries are all hidden
+        for (i in 0 until preferenceScreen.preferenceCount) {
+            val group = preferenceScreen.getPreference(i)
+            if (group is androidx.preference.PreferenceGroup) {
+                group.isVisible = (0 until group.preferenceCount).any { j -> group.getPreference(j).isVisible }
+            }
+        }
+    }
+
+    override fun onPreferenceTreeClick(preference: Preference): Boolean {
+        if (preference.key == "updater") {
+            startActivity(Intent(context, UpdaterActivity::class.java))
+            return true
+        }
+        val entry = screens[preference.key] ?: return super.onPreferenceTreeClick(preference)
+        val fragment = entry.createFragment()
+        fragment.arguments = Bundle().apply {
+            putString("title", preference.title?.toString())
+        }
+        parentFragmentManager.beginTransaction()
+            .replace(R.id.settings_container, fragment)
+            .addToBackStack(null)
+            .commit()
+        return true
+    }
+}
