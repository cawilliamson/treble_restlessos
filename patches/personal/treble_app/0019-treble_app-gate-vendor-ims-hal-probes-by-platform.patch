From c0300741be684ef36be7ec901fe2959be5c17918 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:54:46 +0300
Subject: [PATCH 19/19] treble_app: gate vendor ims hal probes by platform

ims.kt eagerly probed mtk, qcom, slsi, sprd, and huawei hidl/aidl
hals across 12 slots on every boot regardless of soc or radio
presence, triggering ~90 system_app selinux denials on qualcomm
devices and touching hwservicemanager even on wi-fi-only tablets.

skip all vendor probes when ro.boot.baseband is apq/none or
ro.radio.noril is enabled, gate each vendor probe block on its
platform properties, and initialize the hidl service manager and
probe results lazily so non-matching hals are never queried.
---
 app/src/main/java/me/phh/treble/app/Ims.kt | 94 ++++++++++++++++------
 1 file changed, 71 insertions(+), 23 deletions(-)

diff --git a/app/src/main/java/me/phh/treble/app/Ims.kt b/app/src/main/java/me/phh/treble/app/Ims.kt
index e48c16a..82159b7 100644
--- a/app/src/main/java/me/phh/treble/app/Ims.kt
+++ b/app/src/main/java/me/phh/treble/app/Ims.kt
@@ -67,31 +67,79 @@ object Ims: EntryStartup {
         }
     }
 
-    val mHidlService = android.hidl.manager.V1_0.IServiceManager.getService()
+    val mHidlService by lazy { android.hidl.manager.V1_0.IServiceManager.getService() }
+
+    private val hardware = SystemProperties.get("ro.hardware", "").lowercase()
+    private val platform = SystemProperties.get("ro.board.platform", "").lowercase()
+    private val socManufacturer = SystemProperties.get("ro.soc.manufacturer", "")
+    private val vendorManufacturer = SystemProperties.get("ro.product.vendor.manufacturer", "")
+    private val baseband = SystemProperties.get("ro.boot.baseband", "")
+    private val noRil = baseband.equals("apq", ignoreCase = true) ||
+            baseband.equals("none", ignoreCase = true) ||
+            SystemProperties.get("ro.radio.noril", "").let {
+                it.equals("yes", ignoreCase = true) || it.equals("true", ignoreCase = true) || it == "1"
+            }
+
+    private val isMtk = !noRil && (
+            hardware.startsWith("mt") ||
+            platform.startsWith("mt") ||
+            SystemProperties.get("ro.vendor.mediatek.platform", "").isNotEmpty()
+    )
+    private val isQcom = !noRil && (
+            hardware == "qcom" ||
+            SystemProperties.get("ro.hardware.egl", "") == "adreno" ||
+            socManufacturer.equals("qualcomm", ignoreCase = true) ||
+            socManufacturer.equals("qti", ignoreCase = true)
+    )
+    private val isSlsi = !noRil && (
+            hardware.contains("exynos") ||
+            hardware.startsWith("s5e") ||
+            platform.startsWith("exynos") ||
+            platform.startsWith("s5e") ||
+            platform.startsWith("universal") ||
+            (vendorManufacturer.equals("samsung", ignoreCase = true) && hardware != "qcom")
+    )
+    private val isSprd = !noRil && (
+            hardware.startsWith("sp") ||
+            hardware.startsWith("sc") ||
+            hardware.startsWith("ums") ||
+            hardware.startsWith("ud") ||
+            platform.startsWith("sp") ||
+            platform.startsWith("sc") ||
+            platform.startsWith("ums") ||
+            platform.startsWith("ud") ||
+            socManufacturer.equals("unisoc", ignoreCase = true) ||
+            socManufacturer.equals("spreadtrum", ignoreCase = true)
+    )
+    private val isHuawei = !noRil && (
+            hardware.contains("kirin") ||
+            hardware.startsWith("hi") ||
+            platform.contains("kirin") ||
+            vendorManufacturer.equals("huawei", ignoreCase = true) ||
+            vendorManufacturer.equals("honor", ignoreCase = true)
+    )
 
     val mAllSlots = listOf("imsrild1", "imsrild2", "imsrild3", "slot1", "slot2", "slot3", "imsSlot1", "imsSlot2", "mtkSlot1", "mtkSlot2", "imsradio0", "imsradio1")
-    val gotMtkP = mAllSlots
-            .find { i -> mHidlService.get("vendor.mediatek.hardware.radio@3.0::IRadio", i) != null } != null
-    val gotMtkQ = mAllSlots
-            .find { i -> mHidlService.get("vendor.mediatek.hardware.mtkradioex@1.0::IMtkRadioEx", i) != null } != null
-    val gotMtkR = mAllSlots
-            .find { i -> mHidlService.get("vendor.mediatek.hardware.mtkradioex@2.0::IMtkRadioEx", i) != null } != null
-    val gotMtkS = mAllSlots
-            .find { i -> mHidlService.get("vendor.mediatek.hardware.mtkradioex@3.0::IMtkRadioEx", i) != null } != null
-    val gotMtkAidl = mAllSlots
-            .find { i -> ServiceManager.getService("vendor.mediatek.hardware.mtkradioex.ims.IMtkRadioExIms/" + i) != null } != null
-    val gotQcomHidl = mAllSlots
-            .find { i -> mHidlService.get("vendor.qti.hardware.radio.ims@1.0::IImsRadio", i) != null } != null
-    val gotQcomHidlMoto = gotQcomHidl
-            && SystemProperties.get("ro.product.vendor.brand", "N/A").equals("motorola")
-    val gotQcomAidl = mAllSlots
-            .find { i -> ServiceManager.getService("vendor.qti.hardware.radio.ims.IImsRadio/" + i) != null } != null
-    val gotSLSI = mAllSlots
-            .find { i -> mHidlService.get("vendor.samsung_slsi.telephony.hardware.radio@1.0::IOemSamsungslsi", i) != null } != null
-    val gotSPRD = mAllSlots
-            .find { i -> mHidlService.get("vendor.sprd.hardware.radio@1.0::IExtRadio", i) != null } != null
-    val gotHW = mAllSlots
-            .find { i -> mHidlService.get("vendor.huawei.hardware.radio@1.0::IRadio", i) != null } != null
+
+    private fun hasHidl(fqName: String) =
+            mAllSlots.any { mHidlService?.get(fqName, it) != null }
+
+    private fun hasAidl(prefix: String) =
+            mAllSlots.any { ServiceManager.getService(prefix + it) != null }
+
+    val gotMtkP by lazy { isMtk && hasHidl("vendor.mediatek.hardware.radio@3.0::IRadio") }
+    val gotMtkQ by lazy { isMtk && hasHidl("vendor.mediatek.hardware.mtkradioex@1.0::IMtkRadioEx") }
+    val gotMtkR by lazy { isMtk && hasHidl("vendor.mediatek.hardware.mtkradioex@2.0::IMtkRadioEx") }
+    val gotMtkS by lazy { isMtk && hasHidl("vendor.mediatek.hardware.mtkradioex@3.0::IMtkRadioEx") }
+    val gotMtkAidl by lazy { isMtk && hasAidl("vendor.mediatek.hardware.mtkradioex.ims.IMtkRadioExIms/") }
+    val gotQcomHidl by lazy { isQcom && hasHidl("vendor.qti.hardware.radio.ims@1.0::IImsRadio") }
+    val gotQcomHidlMoto by lazy {
+        gotQcomHidl && SystemProperties.get("ro.product.vendor.brand", "N/A").equals("motorola")
+    }
+    val gotQcomAidl by lazy { isQcom && hasAidl("vendor.qti.hardware.radio.ims.IImsRadio/") }
+    val gotSLSI by lazy { isSlsi && hasHidl("vendor.samsung_slsi.telephony.hardware.radio@1.0::IOemSamsungslsi") }
+    val gotSPRD by lazy { isSprd && hasHidl("vendor.sprd.hardware.radio@1.0::IExtRadio") }
+    val gotHW by lazy { isHuawei && hasHidl("vendor.huawei.hardware.radio@1.0::IRadio") }
 
     fun isImsStackEnabled(pm: PackageManager) = try {
         pm.getApplicationEnabledSetting(ImsSettings.imsStackPackage) == PackageManager.COMPONENT_ENABLED_STATE_ENABLED
-- 
