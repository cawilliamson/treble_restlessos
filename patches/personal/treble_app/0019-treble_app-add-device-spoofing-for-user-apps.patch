+++ b/app/src/main/java/me/phh/treble/app/SpoofSettings.kt
@@ -0,0 +1,120 @@
+package me.phh.treble.app
+
+import android.app.AlertDialog
+import android.os.Bundle
+import android.os.SystemProperties
+import android.text.InputType
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.Toast
+import androidx.preference.Preference
+import androidx.preference.SwitchPreferenceCompat
+
+object SpoofSettings : Settings {
+    val enabled = "key_spoof_enabled"
+    val values = "key_spoof_values"
+
+    // non ro properties cannot hold more than this
+    val maxValueLength = 91
+
+    val fields = listOf(
+        "manufacturer" to "Manufacturer",
+        "brand" to "Brand",
+        "model" to "Model",
+        "device" to "Device",
+        "product" to "Product",
+        "fingerprint" to "Fingerprint",
+        "release" to "Android version",
+    )
+
+    val presets = listOf(
+        "Pixel 8" to preset("Google", "google", "Pixel 8", "shiba", "shiba", "google/shiba/shiba:17/CP3A.261005.005/16271449:user/release-keys"),
+        "Pixel 9 Pro" to preset("Google", "google", "Pixel 9 Pro", "caiman", "caiman", "google/caiman/caiman:17/CP3A.261005.005/16271449:user/release-keys"),
+        "Pixel 10 Pro XL" to preset("Google", "google", "Pixel 10 Pro XL", "mustang", "mustang", "google/mustang/mustang:17/CP3A.261005.005/16271449:user/release-keys"),
+        "Galaxy A16 5G (SM-A166B)" to preset("samsung", "samsung", "SM-A166B", "a16x", "a16xxx", "samsung/a16xxx/a16x:17/CP2A.260605.016/A166BXXUAEZJ5:user/release-keys"),
+        "Galaxy S24 Ultra (SM-S928B)" to preset("samsung", "samsung", "SM-S928B", "e3q", "e3qxxx", "samsung/e3qxxx/e3q:17/CP2A.260605.016/S928BXXS6EZJ1:user/release-keys"),
+        "Xiaomi 15 Ultra" to preset("Xiaomi", "Xiaomi", "25019PNF3C", "xuanyuan", "xuanyuan", "Xiaomi/xuanyuan/xuanyuan:17/CP2A.260605.016/OS4.0.0.18.XOACNXM:user/release-keys"),
+        "Redmi K80" to preset("Xiaomi", "Redmi", "24117RK2CC", "zorn", "zorn", "Redmi/zorn/zorn:17/CP2A.260605.016/OS4.0.0.13.XOKCNXM:user/release-keys"),
+    )
+
+    private fun preset(manufacturer: String, brand: String, model: String, device: String, product: String, fingerprint: String) = mapOf(
+        "manufacturer" to manufacturer,
+        "brand" to brand,
+        "model" to model,
+        "device" to device,
+        "product" to product,
+        "fingerprint" to fingerprint,
+        "release" to "17",
+    )
+
+    override fun enabled() = true
+
+    fun prop(field: String) = "persist.sys.spoof.$field"
+}
+
+class SpoofSettingsFragment : SettingsFragment() {
+    override val preferencesResId = R.xml.pref_spoof
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        super.onCreatePreferences(savedInstanceState, rootKey)
+        findPreference<SwitchPreferenceCompat>(SpoofSettings.enabled)!!.setOnPreferenceChangeListener { _, value ->
+            Misc.safeSetprop(SpoofSettings.prop("enabled"), if (value as Boolean) "true" else "false")
+            true
+        }
+        findPreference<Preference>(SpoofSettings.values)!!.setOnPreferenceClickListener {
+            edit()
+            true
+        }
+    }
+
+    private fun edit() {
+        val ctxt = requireContext()
+        val inputs = SpoofSettings.fields.associate { (field, name) ->
+            field to EditText(ctxt).apply {
+                hint = name
+                inputType = InputType.TYPE_CLASS_TEXT
+                setSingleLine()
+                setText(SystemProperties.get(SpoofSettings.prop(field)))
+            }
+        }
+        val form = LinearLayout(ctxt).apply {
+            orientation = LinearLayout.VERTICAL
+            val padding = (20 * resources.displayMetrics.density).toInt()
+            setPadding(padding, padding / 2, padding, 0)
+            addView(Button(ctxt).apply {
+                text = "Use preset"
+                setOnClickListener {
+                    AlertDialog.Builder(ctxt)
+                        .setTitle("Use preset")
+                        .setItems(SpoofSettings.presets.map { it.first }.toTypedArray()) { _, which ->
+                            SpoofSettings.presets[which].second.forEach { (field, value) -> inputs[field]?.setText(value) }
+                        }
+                        .show()
+                }
+            }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+            inputs.values.forEach { addView(it) }
+        }
+        val dialog = AlertDialog.Builder(ctxt)
+            .setTitle("Device values")
+            .setView(ScrollView(ctxt).apply { addView(form) })
+            .setPositiveButton("Save", null)
+            .setNegativeButton("Cancel", null)
+            .create()
+        dialog.setOnShowListener {
+            // set here so a value that is too long keeps the dialog open
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val values = inputs.mapValues { it.value.text.toString().trim() }
+                if (values.values.any { it.length > SpoofSettings.maxValueLength }) {
+                    Toast.makeText(ctxt, "Values are limited to ${SpoofSettings.maxValueLength} characters", Toast.LENGTH_LONG).show()
+                    return@setOnClickListener
+                }
+                values.forEach { (field, value) -> Misc.safeSetprop(SpoofSettings.prop(field), value) }
+                dialog.dismiss()
+            }
+        }
+        dialog.show()
+    }
+}
