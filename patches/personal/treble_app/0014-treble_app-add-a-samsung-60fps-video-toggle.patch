From 63ed987e0db295aad03c53a566edec49622dc2e0 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 3 Oct 2026 04:11:06 +0300
Subject: [PATCH 14/17] treble_app: add a samsung 60fps video toggle

---
 app/src/main/java/me/phh/treble/app/Samsung.kt         | 4 ++++
 app/src/main/java/me/phh/treble/app/SamsungSettings.kt | 1 +
 app/src/main/res/xml/pref_samsung.xml                  | 5 +++++
 3 files changed, 10 insertions(+)

diff --git a/app/src/main/java/me/phh/treble/app/Samsung.kt b/app/src/main/java/me/phh/treble/app/Samsung.kt
index 8c4c497..b15921a 100644
--- a/app/src/main/java/me/phh/treble/app/Samsung.kt
+++ b/app/src/main/java/me/phh/treble/app/Samsung.kt
@@ -84,6 +84,10 @@ class Samsung: EntryStartup {
                 val value = sp.getBoolean(key, false)
                 SystemProperties.set("persist.sys.phh.samsung.remosaic", value.toString())
             }
+            SamsungSettings.video60 -> {
+                val value = sp.getBoolean(key, false)
+                SystemProperties.set("persist.sys.phh.samsung.video60", value.toString())
+            }
             SamsungSettings.alternateAudioPolicy -> {
                 val b = sp.getBoolean(key, false)
                 val value = if(b) "1" else "0"
diff --git a/app/src/main/java/me/phh/treble/app/SamsungSettings.kt b/app/src/main/java/me/phh/treble/app/SamsungSettings.kt
index d40606c..d2617d3 100644
--- a/app/src/main/java/me/phh/treble/app/SamsungSettings.kt
+++ b/app/src/main/java/me/phh/treble/app/SamsungSettings.kt
@@ -12,6 +12,7 @@ object SamsungSettings : Settings {
     val backlightMultiplier = "key_samsung_backlight_multiplier"
     val cameraIds = "key_samsung_camera_ids"
     val remosaic = "key_samsung_remosaic"
+    val video60 = "key_samsung_video60"
     val alternateAudioPolicy = "key_samsung_alternate_audio_policy"
     val fodSingleClick = "key_samsung_fod_single_click"
     val flashStrength = "key_samsung_flash_strength"
diff --git a/app/src/main/res/xml/pref_samsung.xml b/app/src/main/res/xml/pref_samsung.xml
index 4d7c726..c7b5e25 100644
--- a/app/src/main/res/xml/pref_samsung.xml
+++ b/app/src/main/res/xml/pref_samsung.xml
@@ -48,6 +48,11 @@
             android:key="key_samsung_remosaic"
             android:title="Enable full resolution photos"
             android:summary="Offers the remosaic size (e.g. 50MP) to camera apps that pick the highest resolution. Reopen the camera app after changing" />
+        <SwitchPreference
+            android:defaultValue="false"
+            android:key="key_samsung_video60"
+            android:title="Record 1080p and 720p video at 60fps"
+            android:summary="On cameras that support it, records 16:9 video up to 1080p at 60fps. Reopen the camera app after changing" />
         <EditTextPreference
             android:defaultValue="1"
             android:key="key_samsung_flash_strength"
-- 
2.39.2 (Apple Git-143)

