index abc1234..def5678 100644
--- a/target/product/base_system.mk
+++ b/target/product/base_system.mk
@@ -76,7 +76,6 @@ PRODUCT_PACKAGES += \
     com.android.tethering \
     $(RELEASE_PACKAGE_TZDATA_MODULE) \
     com.android.uwb \
-    com.android.virt \
     com.android.wifi \
     ContactsProvider \
     content \
@@ -572,7 +571,6 @@ PRODUCT_PACKAGES += \
     unwind_info \
     unwind_reg_info \
