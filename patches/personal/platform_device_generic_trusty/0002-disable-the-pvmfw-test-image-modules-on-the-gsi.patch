From 0fd7a19b90fdb08c669e7d81e5a1473cfdb328a5 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 29 Sep 2026 13:40:40 +0100
Subject: [PATCH 2/2] disable the pvmfw test image modules on the gsi

the pvmfw test image packages protected vm firmware artifacts built
from the virtualization sources, which are excluded from the gsi
manifest sync.

Change-Id: I84af714f4a2167805a9db5e477d0225a54b09107
---
 custom_vm/memshare_vm/Android.bp | 7 +++----
 pvmfw/Android.bp                 | 5 ++++-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/custom_vm/memshare_vm/Android.bp b/custom_vm/memshare_vm/Android.bp
index 43bd48f..450a1af 100644
--- a/custom_vm/memshare_vm/Android.bp
+++ b/custom_vm/memshare_vm/Android.bp
@@ -82,10 +82,9 @@ cc_genrule {
         },
     },
     out: ["memshare_vm.S"],
-    tools: [
-        "gen_signed_vm_assembly_file",
-    ],
-    cmd: "$(location gen_signed_vm_assembly_file) $(in) $(out)",
+    // the signed vm assembly generator is a virtualization host tool that is
+    // not built on the gsi; this rule is disabled there anyway
+    cmd: "cp $(in) $(out)",
     visibility: ["//visibility:private"],
     vendor_available: true,
     enabled: select((os(), arch(), soong_config_variable("trusty_vendor_vm", "enabled")), {
diff --git a/pvmfw/Android.bp b/pvmfw/Android.bp
index bea7411..e2c3bda 100644
--- a/pvmfw/Android.bp
+++ b/pvmfw/Android.bp
@@ -15,7 +15,8 @@ cc_genrule {
                 ":test_avf_bcc_dat",
                 ":test_ref_dt",
             ],
-            enabled: true,
+            // the virtualization stack is not built on the gsi
+            enabled: false,
         },
     },
     out: [
@@ -27,6 +28,8 @@ cc_genrule {
 prebuilt_etc {
     name: "pvmfw_test_img.img",
     filename: "pvmfw_test_img.img",
+    // the virtualization stack is not built on the gsi
+    enabled: false,
     relative_install_path: "pvmfw",
     vendor: true,
     target: {
-- 
2.55.0

