index b91c328..21b1f32 100644
--- a/src/me/phh/qcrilam/BootReceiver.kt
+++ b/src/me/phh/qcrilam/BootReceiver.kt
@@ -23,11 +23,32 @@ package me.phh.qcrilam
 import android.content.BroadcastReceiver
 import android.content.Context
 import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.SystemProperties
 import android.os.UserManager
 
 class BootReceiver : BroadcastReceiver() {
+    private fun shouldStart(context: Context): Boolean {
+        if (!UserManager.get(context).isSystemUser()) return false
+        if (!context.packageManager.hasSystemFeature(PackageManager.FEATURE_TELEPHONY)) return false
+
+        val baseband = SystemProperties.get("ro.boot.baseband", "")
+        if (baseband.equals("apq", ignoreCase = true) || baseband.equals("none", ignoreCase = true)) {
+            return false
+        }
+
+        val noRil = SystemProperties.get("ro.radio.noril", "")
+        if (noRil.equals("yes", ignoreCase = true) || noRil.equals("true", ignoreCase = true) || noRil == "1") {
+            return false
+        }
+
+        val hardware = SystemProperties.get("ro.hardware", "")
+        val egl = SystemProperties.get("ro.hardware.egl", "")
+        return hardware == "qcom" || egl == "adreno"
+    }
+
     override fun onReceive(context: Context, intent: Intent?) {
-        if (UserManager.get(context).isSystemUser()){
+        if (shouldStart(context)) {
             context.startService(Intent(context, QcRilAmService::class.java))
         }
     }
