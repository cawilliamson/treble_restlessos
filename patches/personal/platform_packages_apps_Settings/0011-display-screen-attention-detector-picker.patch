diff --git a/src/com/android/settings/display/AdaptiveSleepDetectorPreferenceController.java b/src/com/android/settings/display/AdaptiveSleepDetectorPreferenceController.java
new file mode 100644
index 0000000..17af943
--- /dev/null
+++ b/src/com/android/settings/display/AdaptiveSleepDetectorPreferenceController.java
@@ -0,0 +1,54 @@
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+
+/**
+ * The controller of Screen attention's face detector preference.
+ * Picks whether the camera HAL or the system face detector decides if a face is present.
+ */
+public class AdaptiveSleepDetectorPreferenceController {
+
+    // read by com.restlessos.attention
+    private static final String SETTING = "restless_attention_detector";
+    private static final String VALUE_HAL = "hal";
+    private static final String VALUE_SYSTEM = "system";
+
+    private final Context mContext;
+    private ListPreference mPreference;
+
+    public AdaptiveSleepDetectorPreferenceController(Context context) {
+        mContext = context;
+    }
+
+    /**
+     * Adds the controlled preference to the provided preference screen.
+     */
+    public void addToScreen(PreferenceScreen screen) {
+        initializePreference();
+        String value = Settings.Secure.getString(mContext.getContentResolver(), SETTING);
+        mPreference.setValue(VALUE_SYSTEM.equals(value) ? VALUE_SYSTEM : VALUE_HAL);
+        screen.addPreference(mPreference);
+    }
+
+    private void initializePreference() {
+        if (mPreference == null) {
+            mPreference = new ListPreference(mContext);
+            mPreference.setKey("adaptive_sleep_detector");
+            mPreference.setTitle(R.string.adaptive_sleep_detector_title);
+            mPreference.setDialogTitle(R.string.adaptive_sleep_detector_title);
+            mPreference.setEntries(new CharSequence[] {
+                    mContext.getString(R.string.adaptive_sleep_detector_hal),
+                    mContext.getString(R.string.adaptive_sleep_detector_system)});
+            mPreference.setEntryValues(new CharSequence[] {VALUE_HAL, VALUE_SYSTEM});
+            mPreference.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+            mPreference.setOnPreferenceChangeListener((p, newValue) -> Settings.Secure.putString(
+                    mContext.getContentResolver(), SETTING, (String) newValue));
+        }
+    }
+}
