From 84af6bc15894045636ba0b654c87bafdef2b1d44 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:44:38 +0300
Subject: [PATCH 13/14] fingerprint: don't clip the udfps enroll view at the
 footer bar

on devices with the sensor close to the bottom edge the udfps enroll
view reaches below the footer bar top. the glif template clips its
scroll view there, so the sensor circle got cut in half during
enrollment. disable clipping on every parent of the enroll view.
---
 .../fingerprint/UdfpsEnrollEnrollingView.java        | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java b/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
index 931974e..9925280 100644
--- a/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
+++ b/src/com/android/settings/biometrics/fingerprint/UdfpsEnrollEnrollingView.java
@@ -103,6 +103,18 @@ public class UdfpsEnrollEnrollingView extends GlifLayout {
         super.onFinishInflate();
         mHeaderView = findViewById(com.google.android.setupdesign.R.id.sud_landscape_header_area);
         mUdfpsEnrollView = findViewById(R.id.udfps_animation_view);
+        disableUdfpsViewClipping();
+    }
+
+    // Low sensors sit partly below the footer bar top, where the template clips the content.
+    private void disableUdfpsViewClipping() {
+        View view = mUdfpsEnrollView;
+        while (view != null && view != this && view.getParent() instanceof ViewGroup) {
+            final ViewGroup parent = (ViewGroup) view.getParent();
+            parent.setClipChildren(false);
+            parent.setClipToPadding(false);
+            view = parent;
+        }
     }

     @Override
