+package com.android.settings.gestures;
+
+import static android.os.UserHandle.USER_CURRENT;
+import static android.view.WindowManagerPolicyConstants.NAV_BAR_MODE_GESTURAL_OVERLAY;
+
+import android.content.Context;
+import android.content.om.IOverlayManager;
+import android.content.om.OverlayInfo;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Switches gesture navigation between the default overlay and the one without the handle.
+ */
+public class GestureNavigationHideHandleController extends TogglePreferenceController {
+
+    static final String NAV_BAR_MODE_GESTURAL_NO_HANDLE_OVERLAY =
+            "com.android.internal.systemui.navbar.gestural_nohandle";
+    static final String LAUNCHER_NO_HANDLE_OVERLAY =
+            "com.android.internal.systemui.navbar.gestural_nohandle.launcher";
+
+    private final IOverlayManager mOverlayManager;
+
+    public GestureNavigationHideHandleController(Context context, String key) {
+        super(context, key);
+        mOverlayManager = IOverlayManager.Stub.asInterface(
+                ServiceManager.getService(Context.OVERLAY_SERVICE));
+    }
+
+    static boolean isHandleHidden(IOverlayManager overlayManager) {
+        try {
+            final OverlayInfo info = overlayManager.getOverlayInfo(
+                    NAV_BAR_MODE_GESTURAL_NO_HANDLE_OVERLAY, USER_CURRENT);
+            return info != null && info.isEnabled();
+        } catch (RemoteException e) {
+            return false;
+        }
+    }
+
+    @Override
+    public boolean isChecked() {
+        return isHandleHidden(mOverlayManager);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        try {
+            mOverlayManager.setEnabledExclusiveInCategory(isChecked
+                    ? NAV_BAR_MODE_GESTURAL_NO_HANDLE_OVERLAY
+                    : NAV_BAR_MODE_GESTURAL_OVERLAY, USER_CURRENT);
+            mOverlayManager.setEnabled(LAUNCHER_NO_HANDLE_OVERLAY, isChecked, USER_CURRENT);
+        } catch (RemoteException e) {
+            return false;
+        }
+        return true;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SystemNavigationPreferenceController.isGestureAvailable(mContext)
+                && SystemNavigationPreferenceController.isOverlayPackageAvailable(mContext,
+                        NAV_BAR_MODE_GESTURAL_NO_HANDLE_OVERLAY)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_system;
+    }
+}
