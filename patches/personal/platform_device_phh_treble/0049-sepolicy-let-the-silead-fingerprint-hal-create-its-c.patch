From adfe36eb8d628e185c1d3cd661462a8ed53fcfaf Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:55:33 +0300
Subject: [PATCH 49/51] sepolicy: let the silead fingerprint hal create its
 config dir

the transsion silead fingerprint hal creates a config dir under its data
dir on first start. the vendor policy only grants rw_dir_perms there, so
the mkdir is denied, openHal fails and the hal keeps crashing in
setActiveGroup with a null device. allow it to create dirs and files in
silead_fpd_data_file.
---
 sepolicy/mediatek.te | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/sepolicy/mediatek.te b/sepolicy/mediatek.te
index d5750da..1029b3c 100644
--- a/sepolicy/mediatek.te
+++ b/sepolicy/mediatek.te
@@ -56,3 +56,8 @@ allow fuelgauged_nvram sysfs_dt_firmware_android:lnk_file r_file_perms;
 type hal_aidl_agolddaemon_service, service_manager_type;
 allow cameraserver hal_aidl_agolddaemon_service:service_manager find;
 binder_call(cameraserver, hal_aidl_agolddaemon_default);
+
+# silead fingerprint hal (transsion): openHal fails when it can't create its config dir (#230)
+type silead_fpd_data_file, file_type, data_file_type;
+allow hal_fingerprint_default silead_fpd_data_file:dir create_dir_perms;
+allow hal_fingerprint_default silead_fpd_data_file:file create_file_perms;
-- 
2.56.0

