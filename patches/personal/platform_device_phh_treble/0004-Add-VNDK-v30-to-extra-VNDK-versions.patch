From 04f34075c7feaaf9864b104aabff6fd00e9f37a8 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 20 Feb 2026 14:08:15 +0000
Subject: [PATCH 4/5] Add VNDK v30 to extra VNDK versions

Include VNDK v30 prebuilts in the GSI image so devices shipping with
VNDK 30 vendor images can find the matching libraries at runtime.
---
 base.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/base.mk b/base.mk
index a29e402..6cf6e95 100644
--- a/base.mk
+++ b/base.mk
@@ -259,4 +259,4 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/window_extensions.mk)
 PRODUCT_PRODUCT_PROPERTIES += \
     persist.settings.large_screen_opt.enabled=true
 
-PRODUCT_EXTRA_VNDK_VERSIONS += 28 29
+PRODUCT_EXTRA_VNDK_VERSIONS += 28 29 30
-- 
2.52.0

