From 5ab716f53e4bcc37e385283f01392572427a9d0f Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 17 Feb 2026 12:16:21 +0000
Subject: [PATCH 2/3] Add Vanadium to WebView providers overlay

The TrebleDroid overlay for config_webview_packages.xml only lists
Chrome and AOSP WebView as providers. Since this is a vanilla
GrapheneOS GSI build (no GApps), none of those WebView providers
are actually present on the system.

GrapheneOS ships Vanadium (app.vanadium.webview) as the default
WebView provider. Add it to the overlay so the framework recognizes
it as a valid WebView implementation.

Change-Id: I0000000000000000000000000000000000000010
---
 .../base/core/res/res/xml/config_webview_packages.xml          | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml b/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml
index 3f96e59..f3078d1 100644
--- a/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml
+++ b/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml
@@ -16,6 +16,9 @@
 
 <webviewproviders>
 
+    <webviewprovider description="Vanadium" packageName="app.vanadium.webview" availableByDefault="true">
+    </webviewprovider>
+
     <webviewprovider description="Chrome Stable" packageName="com.android.chrome" availableByDefault="true">
         <signature></signature>
     </webviewprovider>
