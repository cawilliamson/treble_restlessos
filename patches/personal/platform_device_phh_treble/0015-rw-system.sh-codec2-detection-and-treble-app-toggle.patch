From 1ec8c5307d60b20c1684bf6c95899c3dbb28ee63 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Wed, 25 Mar 2026 09:22:30 +0000
Subject: [PATCH 15/15] rw-system.sh: codec2 detection and treble app toggle

disable C2 entirely (ccodec=0) when no vendor C2 HAL is declared in
VINTF.  otherwise leave the AOSP default (ccodec=4) which gives all
codecs their normal rank, allowing vendor HW codecs to be used when
they work.

add support for persist.sys.phh.prefer_sw_codecs toggle (set via
treble app) which overrides to ccodec=1, ranking AOSP software codecs
above broken vendor HW codecs.  this is off by default -- users who
experience camera recording crashes can enable it.
---
 rw-system.sh | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/rw-system.sh b/rw-system.sh
index 44cb295..3148d0d 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -1039,10 +1039,34 @@ if getprop ro.build.overlay.deviceid |grep -qE '^RMX';then
     fi
 fi
 
-if [ -n "$vndk" ] && [ "$vndk" -le 28 ] && getprop ro.hardware |grep -q -e mt6761 -e mt6763 -e mt6765 -e mt6785 -e mt8768 -e mt6779 -e mt6771 -e mt8766;then
+# codec2 / media codec configuration.
+#
+# if no vendor C2 HAL is declared in VINTF, disable C2 entirely and rely
+# on OMX.  otherwise leave the AOSP default (ccodec=4) which gives all
+# codecs their normal rank.
+#
+# on some GSI devices, vendor HW video codecs are registered but broken
+# (V4L2 driver mismatch).  the treble app has a toggle to prefer software
+# codecs (ccodec=1) for users who experience camera recording crashes.
+c2_hal_found=false
+for manifest in /vendor/manifest.xml /vendor/etc/vintf/manifest.xml /vendor/etc/vintf/manifest/*.xml /odm/etc/vintf/manifest.xml /odm/etc/vintf/manifest/*.xml; do
+    [ -f "$manifest" ] || continue
+    if grep -q 'android.hardware.media.c2' "$manifest"; then
+        c2_hal_found=true
+        break
+    fi
+done
+
+if [ "$c2_hal_found" = false ]; then
     setprop debug.stagefright.ccodec 0
 fi
 
+# treble app toggle: persist.sys.phh.prefer_sw_codecs
+# when enabled, sets ccodec=1 to rank AOSP sw codecs above vendor HW codecs
+if [ "$(getprop persist.sys.phh.prefer_sw_codecs)" = "true" ]; then
+    setprop debug.stagefright.ccodec 1
+fi
+
 if getprop ro.omc.build.version |grep -qE .;then
 	for f in $(find /odm -name \*.apk);do
 		mount /mnt/phh/empty $f
-- 
