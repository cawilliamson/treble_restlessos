From 48d22e190f92f90bb3955ddab9fede68d0ea3045 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 16 Mar 2026 18:00:00 +0000
Subject: [PATCH 7/12] Fix VNDK version detection for modern vendors

vndk-detect only checks /vendor/etc/selinux/nonplat_sepolicy.cil which
does not exist on Android 10+ vendor partitions. Add fallback detection
via ro.vndk.version and ro.vendor.build.version.sdk from vendor
build.prop so that persist.sys.vndk is set correctly on modern devices.

Without this, ro.vndk.version remains empty, linkerconfig skips VNDK-SP
search paths in vendor namespaces, and 32-bit vendor processes cannot
resolve libraries from VNDK apexes (e.g. MTK OMX codecs fail to load
android.hardware.graphics.common-V2-ndk_platform.so from the v32 apex).
---
 vndk-detect | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/vndk-detect b/vndk-detect
index db19f19..417b1e9 100644
--- a/vndk-detect
+++ b/vndk-detect
@@ -9,6 +9,17 @@ while read version;do
 	setprop persist.sys.vndk $version
 done
 
+# fallback for Android 10+ vendors without nonplat_sepolicy.cil
+if [ -z "$(getprop persist.sys.vndk)" ]; then
+	vndk_version=$(grep -m1 '^ro\.vndk\.version=' /vendor/build.prop 2>/dev/null | cut -d= -f2)
+	if [ -z "$vndk_version" ]; then
+		vndk_version=$(grep -m1 '^ro\.vendor\.build\.version\.sdk=' /vendor/build.prop 2>/dev/null | cut -d= -f2)
+	fi
+	if [ -n "$vndk_version" ]; then
+		setprop persist.sys.vndk "$vndk_version"
+	fi
+fi
+
 if [ -d /sys/module/five ];then
 	if mount -o bind /mnt/phh/empty /sbin/adbd;then
 		setprop sys.phh.five true
