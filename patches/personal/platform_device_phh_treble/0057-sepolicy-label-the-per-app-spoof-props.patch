From 3eafd06e5a87ff02e65b9bae8fe3fe9d3e3d24e7 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sun, 8 Nov 2026 13:45:52 +0300
Subject: [PATCH 57/57] sepolicy: label the per app spoof props

label persist.sys.spoof. so the treble app can set the per app build
values and the apps can read them when they start.
---
 sepolicy/property_contexts | 1 +
 sepolicy/spoof.te          | 5 +++++
 2 files changed, 6 insertions(+)
 create mode 100644 sepolicy/spoof.te

diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index 90d9239..c5521d6 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -4,3 +4,4 @@ sys.phh.oplus.fppress    u:object_r:phh_oplus_prop:s0
 persist.sys.phh.samsung.remosaic u:object_r:phh_samsung_camera_prop:s0
 persist.sys.phh.samsung.video60 u:object_r:phh_samsung_camera_prop:s0
 persist.sys.phh.samsung.video60_grapheneos u:object_r:phh_samsung_camera_prop:s0
+persist.sys.spoof. u:object_r:phh_spoof_prop:s0
diff --git a/sepolicy/spoof.te b/sepolicy/spoof.te
new file mode 100644
index 0000000..32aeb25
--- /dev/null
+++ b/sepolicy/spoof.te
@@ -0,0 +1,5 @@
+type phh_spoof_prop, property_type;
+set_prop(system_app, phh_spoof_prop);
+set_prop(platform_app, phh_spoof_prop);
+get_prop(untrusted_app_all, phh_spoof_prop);
+get_prop(priv_app, phh_spoof_prop);
-- 
