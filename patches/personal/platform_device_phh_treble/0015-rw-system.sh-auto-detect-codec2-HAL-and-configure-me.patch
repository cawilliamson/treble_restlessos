From 8f07f7fb678d7c9f60884d1d33291bb9da01c75e Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Wed, 25 Mar 2026 09:22:30 +0000
Subject: [PATCH 15/15] rw-system.sh: auto-detect codec2 HAL and configure media
 stack

detect whether the vendor ships a codec2 HAL by scanning the VINTF
manifests for android.hardware.media.c2. when present, set properties
to prefer codec2 over OMX. further distinguish AIDL vs HIDL c2 HALs
and set media.c2.hal.selection=aidl when appropriate.

when no vendor c2 HAL is found, explicitly disable codec2 (ccodec=0)
to prevent playback failures from the framework trying to use a c2
path that has no backing implementation.

this replaces the old blanket 'ccodec 0' override for MTK VNDK<=28
devices. the VINTF manifest check is strictly more accurate than a
hardcoded chipset name list -- devices like MT6765 with VNDK 28 DO
ship a working c2 HAL and were incorrectly being forced to OMX.
---
 rw-system.sh | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/rw-system.sh b/rw-system.sh
index c314aa1..c6cd393 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -1039,7 +1039,40 @@ if getprop ro.build.overlay.deviceid |grep -qE '^RMX';then
     fi
 fi

-if [ -n "$vndk" ] && [ "$vndk" -le 28 ] && getprop ro.hardware |grep -q -e mt6761 -e mt6763 -e mt6765 -e mt6785 -e mt8768 -e mt6779 -e mt6771 -e mt8766;then
+# codec2 HAL detection: prefer c2 when the vendor ships a working HAL,
+# otherwise fall back to OMX to avoid broken playback on older vendors.
+# this replaces the old blanket "ccodec 0" for MTK VNDK<=28 devices --
+# VINTF manifest scanning is more accurate than a chipset name list.
+c2_hal_found=false
+for manifest in /vendor/manifest.xml /vendor/etc/vintf/manifest.xml /vendor/etc/vintf/manifest/*.xml /odm/etc/vintf/manifest.xml /odm/etc/vintf/manifest/*.xml; do
+    [ -f "$manifest" ] || continue
+    if grep -q 'android.hardware.media.c2' "$manifest"; then
+        c2_hal_found=true
+        break
+    fi
+done
+
+if [ "$c2_hal_found" = true ]; then
+    # vendor declares codec2 HAL -- prefer c2 over OMX
+    setprop debug.stagefright.c2inputsurface -1
+    setprop debug.stagefright.omx_default_rank 0
+    # detect AIDL vs HIDL: AIDL manifests use <fqname> or format="aidl"
+    c2_aidl=false
+    for manifest in /vendor/manifest.xml /vendor/etc/vintf/manifest.xml /vendor/etc/vintf/manifest/*.xml /odm/etc/vintf/manifest.xml /odm/etc/vintf/manifest/*.xml; do
+        [ -f "$manifest" ] || continue
+        if grep -A5 'android.hardware.media.c2' "$manifest" | grep -qE 'format.*aidl|<fqname>.*IComponentStore/'; then
+            c2_aidl=true
+            break
+        fi
+    done
+    if [ "$c2_aidl" = true ]; then
+        setprop debug.stagefright.ccodec 4
+        setprop media.c2.hal.selection aidl
+    else
+        setprop debug.stagefright.ccodec 4
+    fi
+else
+    # no vendor codec2 HAL -- disable c2 and rely on OMX
     setprop debug.stagefright.ccodec 0
 fi

-- 
