From f99661e36e91975d92c630e4a39c136300758653 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Wed, 25 Mar 2026 09:22:30 +0000
Subject: [PATCH 15/15] rw-system.sh: fix codec2 configuration for GSI compatibility

the AOSP default (ccodec=4) gives all C2 components their normal
rank, which means broken vendor HW video codecs (common on GSI where
the V4L2 driver doesn't match the vendor C2 store) are tried before
AOSP software codecs.  camera recording crashes because the encoder
can't instantiate and no fallback occurs.

use ccodec=1 when a vendor C2 HAL exists: this ranks c2.android.*
(AOSP software) codecs first for audio and video encoding/decoding,
while vendor video codecs are demoted to last.  vendor codecs that
work (audio, heif, etc.) remain available.  if no vendor C2 HAL is
declared in VINTF, disable C2 entirely (ccodec=0) and rely on OMX.
---
 rw-system.sh | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/rw-system.sh b/rw-system.sh
index 44cb295..719e628 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -1039,7 +1039,31 @@ if getprop ro.build.overlay.deviceid |grep -qE '^RMX';then
     fi
 fi
 
-if [ -n "$vndk" ] && [ "$vndk" -le 28 ] && getprop ro.hardware |grep -q -e mt6761 -e mt6763 -e mt6765 -e mt6785 -e mt8768 -e mt6779 -e mt6771 -e mt8766;then
+# codec2 / media codec configuration.
+#
+# the AOSP default (ccodec=4) gives all C2 components their normal rank,
+# which means broken vendor HW video codecs (common on GSI -- the V4L2
+# driver doesn't match what the vendor C2 store expects) are tried before
+# the working AOSP software codecs.  camera recording crashes because the
+# encoder can't instantiate.
+#
+# ccodec=1 makes c2.android.* (AOSP sw) codecs rank first for audio and
+# video, while vendor codecs with .avc.decoder/.avc.encoder suffix are
+# demoted to last.  vendor codecs that DO work (audio, heif, etc.) remain
+# available.  if no vendor C2 HAL exists at all, disable C2 entirely and
+# rely on OMX.
+c2_hal_found=false
+for manifest in /vendor/manifest.xml /vendor/etc/vintf/manifest.xml /vendor/etc/vintf/manifest/*.xml /odm/etc/vintf/manifest.xml /odm/etc/vintf/manifest/*.xml; do
+    [ -f "$manifest" ] || continue
+    if grep -q 'android.hardware.media.c2' "$manifest"; then
+        c2_hal_found=true
+        break
+    fi
+done
+
+if [ "$c2_hal_found" = true ]; then
+    setprop debug.stagefright.ccodec 1
+else
     setprop debug.stagefright.ccodec 0
 fi
 
