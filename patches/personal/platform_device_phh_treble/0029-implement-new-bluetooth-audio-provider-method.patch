From 3b53f0b0f47c76f0580d12ac18a38159e70a3cdc Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 21 Sep 2026 00:00:00 +0100
Subject: [PATCH 29/53] implement new bluetooth audio provider method

android-17.0 added getLeAudioAseCodecConfiguredParameters to the
bluetooth audio aidl interface, leaving the phh bluetooth audio
providers abstract at build time.  every provider class inherits from
bluetooth audio provider, so a single stub override of the new method
matches upstream's own default implementation and makes all 14
subclasses concrete again.
---
 bluetooth/audio/hal/BluetoothAudioProvider.cpp | 18 ++++++++++++++++++
 bluetooth/audio/hal/BluetoothAudioProvider.h   | 10 ++++++++++
 2 files changed, 28 insertions(+)

diff --git a/bluetooth/audio/hal/BluetoothAudioProvider.cpp b/bluetooth/audio/hal/BluetoothAudioProvider.cpp
index 8d03fae..b5bbe56 100644
--- a/bluetooth/audio/hal/BluetoothAudioProvider.cpp
+++ b/bluetooth/audio/hal/BluetoothAudioProvider.cpp
@@ -304,6 +304,24 @@ BluetoothAudioProvider::getLeAudioBroadcastDatapathConfiguration(
   return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
 }

+ndk::ScopedAStatus
+BluetoothAudioProvider::getLeAudioAseCodecConfiguredParameters(
+    const std::optional<std::vector<std::optional<
+        ::aidl::android::hardware::bluetooth::audio::LeAudioAseConfiguration>>>&
+        in_sinkAseConfiguration,
+    const std::optional<std::vector<std::optional<
+        ::aidl::android::hardware::bluetooth::audio::LeAudioAseConfiguration>>>&
+        in_sourceAseConfiguration,
+    std::optional<::aidl::android::hardware::bluetooth::audio::
+                      IBluetoothAudioProvider::LeAudioAseCodecConfiguredResponse>*
+        _aidl_return) {
+  /* TODO: Implement */
+  (void)in_sinkAseConfiguration;
+  (void)in_sourceAseConfiguration;
+  (void)_aidl_return;
+  return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+}
+
 }  // namespace audio
 }  // namespace bluetooth
 }  // namespace hardware
diff --git a/bluetooth/audio/hal/BluetoothAudioProvider.h b/bluetooth/audio/hal/BluetoothAudioProvider.h
index 866eaeb..bb40c90 100644
--- a/bluetooth/audio/hal/BluetoothAudioProvider.h
+++ b/bluetooth/audio/hal/BluetoothAudioProvider.h
@@ -127,6 +127,16 @@ class BluetoothAudioProvider : public BnBluetoothAudioProvider {
           in_streamMap,
       ::aidl::android::hardware::bluetooth::audio::IBluetoothAudioProvider::
           LeAudioDataPathConfiguration* _aidl_return) override;
+  ndk::ScopedAStatus getLeAudioAseCodecConfiguredParameters(
+      const std::optional<std::vector<std::optional<
+          ::aidl::android::hardware::bluetooth::audio::LeAudioAseConfiguration>>>&
+          in_sinkAseConfiguration,
+      const std::optional<std::vector<std::optional<
+          ::aidl::android::hardware::bluetooth::audio::LeAudioAseConfiguration>>>&
+          in_sourceAseConfiguration,
+      std::optional<::aidl::android::hardware::bluetooth::audio::
+                        IBluetoothAudioProvider::LeAudioAseCodecConfiguredResponse>*
+          _aidl_return) override;

   ndk::ScopedAStatus parseA2dpConfiguration(
       const CodecId& codec_id, const std::vector<uint8_t>& configuration,
