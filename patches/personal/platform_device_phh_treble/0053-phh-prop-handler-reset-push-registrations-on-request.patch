From d82ac26adc0f5aa218909d5ee4d5107ce0445e03 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 31 Oct 2026 02:38:05 +0300
Subject: [PATCH 53/53] phh-prop-handler: reset push registrations on request

firebase caches the push token in each app's
com.google.android.gms.appid.xml. the token is bound to the gms install
that issued it, so after switching between google play services and
microg apps keep a dead token and stop getting pushes.

when persist.sys.reset_push is set to 1, drop that cache for every
app on every user and force stop the app, so it registers again with
the current gms once opened. set the prop to 2 when done so the treble
app can tell the user.
---
 phh-prop-handler.sh | 24 ++++++++++++++++++++++++
 vndk.rc             |  3 +++
 2 files changed, 27 insertions(+)

diff --git a/phh-prop-handler.sh b/phh-prop-handler.sh
index d9e3153..391de04 100644
--- a/phh-prop-handler.sh
+++ b/phh-prop-handler.sh
@@ -298,6 +298,30 @@ if [ "$1" == "persist.bluetooth.system_audio_hal.enabled" ]; then
     exit
 fi
 
+if [ "$1" == "persist.sys.reset_push" ]; then
+    [ "$prop_value" == 1 ] || exit
+
+    # firebase keeps the push token of the gms that issued it, drop it so the
+    # app registers again with the current one
+    for token_file in /data/user/*/*/shared_prefs/com.google.android.gms.appid.xml; do
+        [ -f "$token_file" ] || continue
+
+        app_dir="$(dirname "$(dirname "$token_file")")"
+        package="$(basename "$app_dir")"
+        user_id="$(basename "$(dirname "$app_dir")")"
+
+        case "$package" in
+            com.google.android.gms|com.android.vending) continue ;;
+        esac
+
+        rm -f "$token_file"
+        am force-stop --user "$user_id" "$package"
+    done
+
+    setprop persist.sys.reset_push 2
+    exit
+fi
+
 if [ "$1" == "persist.sys.phh.lmk_tweaks" ]; then
     if [[ "$prop_value" != "false" && "$prop_value" != "true" ]]; then
         exit 1
diff --git a/vndk.rc b/vndk.rc
index 58b03f3..fadc9af 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -183,6 +183,9 @@ on property:init.svc.wifidisplayhalservice=running && property:ro.product.device
 on property:persist.sys.phh.lmk_tweaks=*
     exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.lmk_tweaks"
 
+on property:persist.sys.reset_push=1
+    exec_background u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.reset_push"
+
 # stock init.rc hands these to system on samsung, the gsi does not. without it
 # system_server cannot write battery_cycle and the health hal cannot set batt_type.
 on post-fs-data && property:ro.product.vendor.manufacturer=samsung
-- 
