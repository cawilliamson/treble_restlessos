From b0e4576da3c8c170009bb5e5ee84ec88356011b2 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 22 Oct 2026 22:13:35 +0100
Subject: [PATCH 44/51] drop trebledroid remote debugging machinery

remove the phh-remotectl dropbear reverse tunnel, its init rc and the
static dbclient binary. nothing on the system sets
persist.sys.phh.remote any more, so the adbd tcp trigger and service
were unreachable dead weight.
---
 base.mk                 |   6 ------
 remote/dbclient         | Bin 199072 -> 0 bytes
 remote/phh-remotectl.rc |  14 --------------
 remote/phh-remotectl.sh |   7 -------
 4 files changed, 27 deletions(-)
 delete mode 100755 remote/dbclient
 delete mode 100644 remote/phh-remotectl.rc
 delete mode 100644 remote/phh-remotectl.sh

diff --git a/base.mk b/base.mk
index bc4289b..ee55992 100644
--- a/base.mk
+++ b/base.mk
@@ -200,12 +200,6 @@ PRODUCT_COPY_FILES += \
     device/phh/treble/privapp-permissions-me.phh.treble.app.xml:system/etc/permissions/privapp-permissions-me.phh.treble.app.xml \
     device/phh/treble/sysconfig-me.phh.treble.app.xml:system/etc/sysconfig/sysconfig-me.phh.treble.app.xml

-# Remote debugging
-PRODUCT_COPY_FILES += \
-    device/phh/treble/remote/dbclient:system/bin/dbclient \
-    device/phh/treble/remote/phh-remotectl.rc:system/etc/init/phh-remotectl.rc \
-    device/phh/treble/remote/phh-remotectl.sh:system/bin/phh-remotectl.sh \
-
 PRODUCT_PACKAGES += \
     android.hardware.biometrics.fingerprint@2.1-service.oppo.compat \
     android.hardware.biometrics.fingerprint@2.1-service.oplus.compat \
diff --git a/remote/dbclient b/remote/dbclient
deleted file mode 100755
index fa2d49c5caf552734f88d00d1659e4e923d68f67..0000000000000000000000000000000000000000
GIT binary patch
literal 0
