From d2b9fa72ea47ece4ca1d83dbd1ca8adcd769ca7b Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 15 Oct 2026 00:10:15 +0100
Subject: [PATCH 45/52] sepolicy: let the xiaomi touch init set its panel property

---
 sepolicy/xiaomi.te | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/sepolicy/xiaomi.te b/sepolicy/xiaomi.te
index 4d7d20a..f9412c0 100644
--- a/sepolicy/xiaomi.te
+++ b/sepolicy/xiaomi.te
@@ -10,3 +10,9 @@ allow shell sysfs_tp_fodstatus:file getattr;
 
 allow shell vendor_sysfs_displayfeature:dir search;
 
+
+# xiaomi touch init sets the panel vendor property during boot; the stricter
+# gsi policy denies it and the touch driver then runs without its panel config
+type vendor_touch_init_shell, domain;
+type vendor_fp_prop, property_type;
+allow vendor_touch_init_shell vendor_fp_prop:property_service set;
