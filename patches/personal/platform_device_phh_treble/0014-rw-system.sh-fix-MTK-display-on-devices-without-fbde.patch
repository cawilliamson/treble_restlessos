From 590034ab0711e1c19c364adc951991513d0d4e27 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 24 Mar 2026 12:44:06 +0000
Subject: [PATCH 14/14] rw-system.sh: fix MTK display on devices without fbdev

On many MTK devices the vendor kernel DRM driver does not expose the
standard KMS atomic plane properties (alpha, pixel blend mode).  The
HWC then fails to initialise any overlay plane; atomic commits for
display power management also fail, leaving the display black or
causing it to turn off after boot.

The reliable runtime signal is the absence of /dev/fb0: kernels built
with CONFIG_DRM_FBDEV_EMULATION=n create no fb node, and those same
kernels also lack the standard KMS atomic plane properties.

Fix strategy (applied only when /dev/fb0 is absent on MTK):
- persist.sys.phh.no_present_or_validate=true to force pure client
  (GPU) composition, bypassing broken DRM atomic commit paths
- debug.sf.latch_unsignaled=1 to prevent missed frames when the HWC
  cannot signal fences properly

Add SELinux rules allowing the MTK HWComposer HAL to read debug_prop
and system_prop so it can pick up the renderengine backend override
and other display configuration properties set by rw-system.sh.
---
 rw-system.sh         | 30 ++++++++++++++++++++++++++++++
 sepolicy/mediatek.te |  5 +++++
 2 files changed, 35 insertions(+)

diff --git a/rw-system.sh b/rw-system.sh
index 332af00..c314aa1 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -1123,6 +1123,36 @@ if [ "$board" = mt6768 ]; then
 	setprop ro.netflix.bsp_rev MTK6768-19055-1
 fi
 
+# MTK HWComposer DRM plane and display power fixes.
+#
+# on many MTK devices the vendor kernel DRM driver does not expose the
+# standard KMS atomic plane properties (alpha, pixel blend mode).  the
+# HWC then fails to initialise any overlay plane; atomic commits for
+# display power management also fail, leaving the display black or
+# causing it to turn off after boot.  integrated touch/display drivers
+# (e.g. chipone TDDI) use DRM notifier callbacks to track display
+# state -- when display power transitions fail the touch driver thinks
+# the panel is off and disables itself.
+#
+# the reliable runtime signal is the absence of /dev/fb0: kernels built
+# with CONFIG_DRM_FBDEV_EMULATION=n create no fb node, and those same
+# kernels also lack the standard KMS atomic plane properties.
+#
+# fix strategy (applied only when /dev/fb0 is absent on MTK):
+#  - persist.sys.phh.no_present_or_validate=true -- tells the
+#    trebledroid surfaceflinger shim to skip presentOrValidateDisplay,
+#    forcing pure client (GPU) composition and avoiding the atomic
+#    commit paths that fail without working DRM planes.
+#  - debug.sf.latch_unsignaled=1 -- allows SF to latch buffers that
+#    have not yet been signalled by the HWC fence, preventing missed
+#    frames when the HWC cannot signal properly.
+if echo "$board" | grep -qiE '^mt[0-9]'; then
+	if [ ! -e /dev/fb0 ]; then
+		setprop persist.sys.phh.no_present_or_validate true
+		setprop debug.sf.latch_unsignaled 1
+	fi
+fi
+
 if [ "$board" = lahaina ]; then
 	setprop ro.netflix.bsp_rev Q875-32774-1
 fi
diff --git a/sepolicy/mediatek.te b/sepolicy/mediatek.te
index 2b24965..f3e3d61 100644
--- a/sepolicy/mediatek.te
+++ b/sepolicy/mediatek.te
@@ -2,6 +2,11 @@ type hal_graphics_allocator_default, domain;
 type proc_ged, file_type;
 allowxperm domain proc_ged:file ioctl { 0x6700-0x67ff };
 
+# allow MTK hwcomposer to read system and debug properties
+# (debug.renderengine.backend, debug.sf.*, etc.)
+allow hal_graphics_composer_default debug_prop:file { getattr map open read };
+allow hal_graphics_composer_default system_prop:file { getattr map open read };
+
 allow init mnt_product_file:dir mounton;
 
 type mtk_hal_audio, domain;
-- 
