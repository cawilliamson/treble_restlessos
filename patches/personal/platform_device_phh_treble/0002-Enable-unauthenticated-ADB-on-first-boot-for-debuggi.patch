From 7e2cd2cda160b0f4388b5986c3abb6499f527206 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 8 Mar 2026 11:48:24 +0000
Subject: [PATCH 2/3] Enable unauthenticated ADB on first boot for debugging

On first boot after a fresh install or GSI upgrade, enable ADB with
no authentication so boot issues can be diagnosed.  Uses the normal
init USB path (property-based) to avoid tearing down configfs which
breaks vendor USB HALs.

rw-system.sh compares the system fingerprint against a cached value
on /cache.  On mismatch it sets ro.adb.secure=0 and persist.sys.usb.config=adb.
phh-on-boot.sh cleans up at boot_completed.

Remove persist.sys.usb.config=adb from base.mk so ADB is off by
default on subsequent boots.
---
 base.mk        |  1 -
 phh-on-boot.sh |  7 +++++++
 rw-system.sh   | 10 ++++++++++
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/base.mk b/base.mk
index a88edfc..76b1c4d 100644
--- a/base.mk
+++ b/base.mk
@@ -42,7 +42,6 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 
 # Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    persist.sys.usb.config=adb \
     ro.cust.cdrom=/dev/null
 
 # VNDK config files
diff --git a/phh-on-boot.sh b/phh-on-boot.sh
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -38,6 +38,13 @@ if [ ! -f /metadata/securize_disable ]; then
   resetprop_phh -n init.svc.flash_recovery stopped
 fi
 
+# End first-boot debug ADB window.
+if [ "$(getprop ro.adb.secure)" = "0" ]; then
+    resetprop_phh --delete ro.adb.secure
+    resetprop_phh --delete persist.sys.usb.config
+    stop adbd
+fi
+
 vndk="$(getprop persist.sys.vndk)"
 [ -z "$vndk" ] && vndk="$(getprop ro.vndk.version |grep -oE '^[0-9]+')"
 
diff --git a/rw-system.sh b/rw-system.sh
index 8bb41dc..bdff3de 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -10,6 +10,16 @@ else
     chmod 0644 /cache/phh/logs
 fi
 
+# First-boot debug ADB: detect new GSI build and enable unauthenticated
+# ADB via the normal init USB path (no configfs teardown).
+gsi_fp_cache="/cache/phh-gsi-fingerprint"
+gsi_fp="$(getprop ro.system.build.fingerprint)"
+if [ -n "$gsi_fp" ] && [ "$gsi_fp" != "$(cat "$gsi_fp_cache" 2>/dev/null)" ]; then
+    echo "$gsi_fp" > "$gsi_fp_cache"
+    resetprop_phh ro.adb.secure 0
+    resetprop_phh -n persist.sys.usb.config adb
+fi
+
 if [ -f /cache/phh-adb ];then
     setprop ctl.stop adbd
     setprop ctl.stop adbd_apex
-- 
