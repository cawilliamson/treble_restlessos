From 8b272060ca6707f489bd98cb66282882fcd71b14 Mon Sep 17 00:00:00 2001
From: doissM <doissM@users.noreply.github.com>
Date: Thu, 26 Mar 2026 16:34:54 +0000
Subject: [PATCH 15/15] rw-system.sh: add codec fix toggle for broken vendor C2 HALs

add treble app toggle (persist.sys.phh.prefer_sw_codecs) that applies
the codec fix from the CodecFix magisk module: force AIDL C2 HAL
selection to hide broken HIDL vendor codecs, promote OMX to highest
rank, and disable C2 input surface.  off by default.

based on the CodecFix magisk module by doissM.
---
 rw-system.sh | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/rw-system.sh b/rw-system.sh
index 44cb295..43bffb8 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -1043,6 +1043,17 @@ if [ -n "$vndk" ] && [ "$vndk" -le 28 ] && getprop ro.hardware |grep -q -e mt676
     setprop debug.stagefright.ccodec 0
 fi
 
+# treble app toggle: prefer software/OMX codecs over broken vendor C2 HW
+# codecs.  forces AIDL C2 HAL selection (hiding HIDL vendor codecs),
+# promotes OMX to highest rank, and disables C2 input surface.
+# based on doissM's CodecFix magisk module.
+if [ "$(getprop persist.sys.phh.prefer_sw_codecs)" = "true" ]; then
+    setprop debug.stagefright.c2inputsurface -1
+    setprop debug.stagefright.ccodec 4
+    setprop debug.stagefright.omx_default_rank 0
+    setprop media.c2.hal.selection aidl
+fi
+
 if getprop ro.omc.build.version |grep -qE .;then
 	for f in $(find /odm -name \*.apk);do
 		mount /mnt/phh/empty $f
-- 
