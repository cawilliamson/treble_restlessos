From c670ce989db7c98fccc9dcb28ddfcd2d2505dfb3 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:23:51 +0300
Subject: [PATCH 51/52] ims: ship the aosp ims stack for the treble app to
 enable

gsis have no imsservice on most devices, and floss ims is the only ap
side fallback. aosp now carries imsstack and imsmedia, an ap side ims
stack that only needs the standard radio hals, which lineage already
uses on samsung exynos and snapdragon.

build imsstack and imsmedia into system. imsstack ships disabled, the
treble app enables it on request and sets persist.sys.phh.ims.aosp,
which switches iwlan to ap-assisted like floss. add the radio rules
imsstack needs to hand its sockets to the phone process.
---
 base.mk              | 7 +++++++
 sepolicy/imsstack.te | 3 +++
 vndk.rc              | 3 +++
 3 files changed, 13 insertions(+)
 create mode 100644 sepolicy/imsstack.te

diff --git a/base.mk b/base.mk
index d6fe086..2f25503 100644
--- a/base.mk
+++ b/base.mk
@@ -289,6 +289,13 @@ PRODUCT_PACKAGES += \
     QualifiedNetworksService \
     MtkInCallService \
 
+# AOSP IMS stack, shipped disabled; treble_app enables it on request
+PRODUCT_PACKAGES += \
+    ImsStack \
+    ImsMediaService \
+    libimsmedia \
+    preinstalled-packages-imsmedia.xml
+
 # Two-pane layout in Settings
 $(call inherit-product, $(SRC_TARGET_DIR)/product/window_extensions.mk)
 PRODUCT_PRODUCT_PROPERTIES += \
diff --git a/sepolicy/imsstack.te b/sepolicy/imsstack.te
new file mode 100644
index 0000000..bae4102
--- /dev/null
+++ b/sepolicy/imsstack.te
@@ -0,0 +1,3 @@
+allow radio platform_app:udp_socket { getattr read setopt shutdown write };
+allow radio scheduling_policy_service:service_manager find;
+r_dir_file(radio, cgroup)
diff --git a/vndk.rc b/vndk.rc
index 424938f..58b03f3 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -122,6 +122,9 @@ on property:persist.sys.phh.force_display_5g=1
 on property:persist.sys.phh.ims.floss=true
     exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.telephony.iwlan_operation_mode AP-assisted
 
+on property:persist.sys.phh.ims.aosp=true
+    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.telephony.iwlan_operation_mode AP-assisted
+
 on property:persist.sys.phh.enable_sf_gl_backpressure=*
     setprop debug.sf.enable_gl_backpressure ${persist.sys.phh.enable_sf_gl_backpressure}
 
-- 
2.56.0

