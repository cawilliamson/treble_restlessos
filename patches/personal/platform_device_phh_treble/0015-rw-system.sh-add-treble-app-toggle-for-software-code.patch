From 7c321a7875f71ed86c9a512ffab87d313ac6baee Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 26 Mar 2026 16:26:26 +0000
Subject: [PATCH 15/15] rw-system.sh: add treble app toggle for software codec
 preference

add support for persist.sys.phh.prefer_sw_codecs (set via treble app)
which sets ccodec=1 to rank AOSP software codecs above vendor HW
codecs.  fixes camera recording crashes on devices with broken vendor
HW encoders.  off by default -- does not change any existing behaviour.
---
 rw-system.sh | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/rw-system.sh b/rw-system.sh
index 44cb295..f932fdc 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -1043,6 +1043,12 @@ if [ -n "$vndk" ] && [ "$vndk" -le 28 ] && getprop ro.hardware |grep -q -e mt676
     setprop debug.stagefright.ccodec 0
 fi
 
+# treble app toggle: prefer software codecs over vendor HW codecs.
+# sets ccodec=1 which ranks AOSP sw codecs first.  off by default.
+if [ "$(getprop persist.sys.phh.prefer_sw_codecs)" = "true" ]; then
+    setprop debug.stagefright.ccodec 1
+fi
+
 if getprop ro.omc.build.version |grep -qE .;then
 	for f in $(find /odm -name \*.apk);do
 		mount /mnt/phh/empty $f
-- 
