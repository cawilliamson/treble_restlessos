From 5e6e61eb5aa7b94462331da4117021df8761c7ea Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 7 Mar 2026 19:53:41 +0000
Subject: [PATCH] Enable unauthenticated ADB on first boot for debugging

Allow unauthenticated ADB access on the first boot after a fresh
install or GSI upgrade so that boot issues can be diagnosed over USB.

At the top of rw-system.sh, before anything else, compare the current
GSI fingerprint against the value persisted on /metadata.  When they
differ (new build), fall into the existing /cache/phh-adb USB gadget
setup with ro.adb.secure=0 to start adbd as early as possible.

Once sys.boot_completed fires, phh-on-boot.sh detects ro.adb.secure=0,
deletes the property and kills the debug adbd.

Remove persist.sys.usb.config=adb from base.mk so ADB is off by
default.  The user can re-enable USB debugging via Developer Options,
at which point normal RSA key authentication applies.
---
 base.mk        |  1 -
 phh-on-boot.sh |  9 +++++++++
 rw-system.sh   | 11 ++++++++++-
 3 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/base.mk b/base.mk
index 79a3fd3..54328fe 100644
--- a/base.mk
+++ b/base.mk
@@ -42,7 +42,6 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 
 # Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    persist.sys.usb.config=adb \
     ro.cust.cdrom=/dev/null
 
 # VNDK config files
diff --git a/phh-on-boot.sh b/phh-on-boot.sh
index 6f2fd68..b83d401 100644
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -27,6 +27,15 @@ if [ ! -f /metadata/securize_disable ]; then
   resetprop_phh -n init.svc.flash_recovery stopped
 fi
 
+# End the first-boot debug window: if ro.adb.secure was set to 0 by
+# rw-system.sh for first-boot debugging, clear it and kill the
+# manually-launched adbd.  The user can re-enable USB debugging via
+# Developer Options, at which point normal RSA authentication applies.
+if [ "$(getprop ro.adb.secure)" = "0" ]; then
+    resetprop_phh --delete ro.adb.secure
+    pkill -f adbd
+fi
+
 vndk="$(getprop persist.sys.vndk)"
 [ -z "$vndk" ] && vndk="$(getprop ro.vndk.version |grep -oE '^[0-9]+')"
 
diff --git a/rw-system.sh b/rw-system.sh
index 68df619..96fe33d 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -10,7 +10,14 @@ else
     chmod 0644 /cache/phh/logs
 fi
 
-if [ -f /cache/phh-adb ];then
+# Detect new GSI build early so we can start debug ADB before anything else.
+gsi_fp_cache="/cache/phh-gsi-fingerprint"
+phh_new_build=false
+[ "$(getprop ro.system.build.fingerprint)" != "$(cat "$gsi_fp_cache" 2>/dev/null)" ] && phh_new_build=true
+
+if [ -f /cache/phh-adb ] || [ "$phh_new_build" = true ];then
+    getprop ro.system.build.fingerprint > "$gsi_fp_cache"
+    resetprop_phh ro.adb.secure 0
     setprop ctl.stop adbd
     setprop ctl.stop adbd_apex
     mount -t configfs none /config
@@ -818,11 +825,13 @@ if [ -n "$gsi_fp" ] && [ "$gsi_fp" != "$prev_gsi_fp" ]; then
     echo "$gsi_fp" > "$gsi_fp_file"
     # Signal PMS that this is a new build so it runs post-upgrade steps.
     resetprop_phh -n persist.pm.mock-upgrade true
+
 else
     # Same build as last boot; clear the flag so normal boots are not affected.
     resetprop_phh -n persist.pm.mock-upgrade false
 fi
 
+
 if [ ! -f /metadata/securize_disable ]; then
     copyprop ro.build.device ro.vendor.build.device
     copyprop ro.system.build.fingerprint ro.vendor.build.fingerprint
-- 
2.53.0

