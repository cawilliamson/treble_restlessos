From 0b3fbe129afb8d7066250cbdb973b6e171f4e3d9 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:35:49 +0300
Subject: [PATCH 50/53] vndk: hand the samsung battery cycle and type nodes to
 system

stock init.rc gives battery_cycle and batt_type to system, the gsi
leaves them root owned. system_server then cannot write the cycle count
and the health hal cannot set the battery type. chown them on samsung
vendors before the health hal starts.
---
 vndk.rc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/vndk.rc b/vndk.rc
index c61e712..424938f 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -179,3 +179,10 @@ on property:init.svc.wifidisplayhalservice=running && property:ro.product.device
 
 on property:persist.sys.phh.lmk_tweaks=*
     exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.lmk_tweaks"
+
+# stock init.rc hands these to system on samsung, the gsi does not. without it
+# system_server cannot write battery_cycle and the health hal cannot set batt_type.
+on post-fs-data && property:ro.product.vendor.manufacturer=samsung
+    chown system radio /sys/class/power_supply/battery/battery_cycle
+    chown system radio /sys/class/power_supply/battery/batt_type
+    chmod 0660 /sys/class/power_supply/battery/batt_type
-- 
