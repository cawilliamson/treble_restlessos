From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 24 Oct 2026 17:08:26 +0300
Subject: [PATCH 3/4] quickstep: request the contextual search permission for
 circle to search

---
 quickstep/AndroidManifest.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/quickstep/AndroidManifest.xml b/quickstep/AndroidManifest.xml
index 789e0a5..2017102 100644
--- a/quickstep/AndroidManifest.xml
+++ b/quickstep/AndroidManifest.xml
@@ -42,6 +42,7 @@
     <uses-permission android:name="android.permission.ACCESS_SHORTCUTS"/>
     <uses-permission android:name="android.permission.READ_REMOTE_TASKS"/>
     <uses-permission android:name="android.permission.REQUEST_TASK_HANDOFF"/>
+    <uses-permission android:name="android.permission.ACCESS_CONTEXTUAL_SEARCH"/>
 
     <uses-permission android:name="android.permission.REPORT_UI_LATENCY_STATS"
                      android:featureFlag="com.android.server.ui_latency_stats.ui_latency_stats_service" />
