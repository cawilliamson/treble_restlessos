From 8a85266b769e50abe515b66008761c7cf5918d46 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 28 Sep 2026 16:49:27 +0100
Subject: [PATCH 1/2] settings: drop the vm capability check from the linux
 terminal controller

the terminal feature cannot run without the virtualization framework,
which the gsi does not ship, and the controller is constructed
unconditionally when developer options opens, so resolving
VirtualMachineManager crashed settings once the virtualization
service registration was removed. check memory and storage only; the
terminal app is not installed on the gsi so the preference stays
hidden either way.
---
 .../LinuxTerminalPreferenceController.java       |  9 +--------
 tests/robotests/Android.bp                       |  1 -
 .../LinuxTerminalPreferenceControllerTest.java   | 16 ----------------
 3 files changed, 1 insertion(+), 25 deletions(-)

diff --git a/src/com/android/settings/development/linuxterminal/LinuxTerminalPreferenceController.java b/src/com/android/settings/development/linuxterminal/LinuxTerminalPreferenceController.java
index c3e1a03..a4d25d7 100644
--- a/src/com/android/settings/development/linuxterminal/LinuxTerminalPreferenceController.java
+++ b/src/com/android/settings/development/linuxterminal/LinuxTerminalPreferenceController.java
@@ -16,14 +16,12 @@
 
 package com.android.settings.development.linuxterminal;
 
-import static android.system.virtualmachine.VirtualMachineManager.CAPABILITY_NON_PROTECTED_VM;
 
 import android.content.ContentResolver;
 import android.content.Context;
 import android.content.pm.PackageManager;
 import android.os.Process;
 import android.os.storage.StorageManager;
-import android.system.virtualmachine.VirtualMachineManager;
 import android.provider.Settings;
 import android.text.TextUtils;
 import android.util.DataUnit;
@@ -60,16 +58,11 @@ public class LinuxTerminalPreferenceController extends DeveloperOptionsPreferenc
                 isPackageInstalled(context.getPackageManager(), packageName) ? packageName : null;
 
         StorageManager storageManager = context.getSystemService(StorageManager.class);
-        VirtualMachineManager virtualMachineManager =
-                context.getSystemService(VirtualMachineManager.class);
 
         mIsDeviceCapable =
                 getTotalMemory() >= MEMORY_MIN_BYTES
                         && storageManager != null
-                        && storageManager.getPrimaryStorageSize() >= STORAGE_MIN_BYTES
-                        && virtualMachineManager != null
-                        && ((virtualMachineManager.getCapabilities() & CAPABILITY_NON_PROTECTED_VM)
-                                != 0);
+                        && storageManager.getPrimaryStorageSize() >= STORAGE_MIN_BYTES;
     }
 
     public boolean mIsInSystemSettings;
