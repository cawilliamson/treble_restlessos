From 0a555e893e247d5a834af528fc836c31690a0761 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:50:41 +0300
Subject: [PATCH 2/2] keystore2: pass the qti fbe ice tag through km_compat

vold tags v0 wrapped storage keys with the qti vendor KM_TAG_FBE_ICE so
that qti keymaster 4.0 allows their raw export. km_compat drops it
twice on the way to the hidl hal: isKeyCreationParameter does not list
it and convertKeyParameterToLegacy maps unknown tags to INVALID.

accept the tag as a creation parameter and forward it as a boolean
legacy parameter. only vold can generate storage keys, so no other
caller is affected.

Change-Id: I35244677f76210f24d5733ea64ad2b647e7a5ded
---
 keystore2/src/km_compat/km_compat.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/keystore2/src/km_compat/km_compat.cpp b/keystore2/src/km_compat/km_compat.cpp
index b1d1383..5313031 100644
--- a/keystore2/src/km_compat/km_compat.cpp
+++ b/keystore2/src/km_compat/km_compat.cpp
@@ -85,6 +85,9 @@ bool isAttestationParameter(const KMV1::KeyParameter& param) {
     }
 }
 
+// qti keymaster only allows the raw export of storage keys generated with this vendor tag.
+constexpr int32_t KM_TAG_FBE_ICE = static_cast<int32_t>(7u << 28) | 16201;
+
 // Returns true if this parameter may be passed to generate/importKey.
 bool isKeyCreationParameter(const KMV1::KeyParameter& param) {
     switch (param.tag) {
@@ -130,7 +133,7 @@ bool isKeyCreationParameter(const KMV1::KeyParameter& param) {
     case Tag::MAC_LENGTH:
         return true;
     default:
-        return false;
+        return static_cast<int32_t>(param.tag) == KM_TAG_FBE_ICE;
     }
 }
 
@@ -298,6 +301,13 @@ convertKeyParametersToLegacy(const std::vector<KeyParameter>& kps) {
     std::vector<V4_0::KeyParameter> legacyKps;
     legacyKps.reserve(kps.size());
     for (const auto& kp : kps) {
+        if (static_cast<int32_t>(kp.tag) == KM_TAG_FBE_ICE) {
+            V4_0::KeyParameter p;
+            p.tag = static_cast<V4_0::Tag>(KM_TAG_FBE_ICE);
+            p.f.boolValue = true;
+            legacyKps.push_back(std::move(p));
+            continue;
+        }
         auto p = convertKeyParameterToLegacy(kp);
         if (p.tag != V4_0::Tag::INVALID) {
             legacyKps.push_back(std::move(p));
