From 9de09813ebc3d5cc0397d89c1c3d5b3a2ceab253 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 27 Sep 2026 21:32:33 +0100
Subject: [PATCH 1/1] keystore2: wait for the keymint backend instead of aborting

keystore2_main aborts when the /default Keymaster or KeyMint security
level cannot be constructed. on gsi devices with legacy vendors the
backend is a hidl keymaster hal that lazy-starts through
hwservicemanager and can only link once the vndk apexes are activated
and the vendor linker namespace is configured; until then getService
fails. keystore2 is a critical service, so the abort turns into a
reboot to bootloader before sys.boot_completed, observed as
bootloops or a stuck oem logo on 4.x-kernel devices.

retry the service construction every 5 seconds instead of panicking.
the km_compat service registration and the legacy importer
initializer are both idempotent, so repeated attempts are safe. a
device whose hal never appears now stalls at the same point it
previously reboot-looped, which is no worse and gives a slow hal the
chance to come up.

Change-Id: I76539535dd97fe32717a7093cc85de53265800b9
---
 keystore2/src/keystore2_main.rs | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/keystore2/src/keystore2_main.rs b/keystore2/src/keystore2_main.rs
index 8093fb0..b25a074 100644
--- a/keystore2/src/keystore2_main.rs
+++ b/keystore2/src/keystore2_main.rs
@@ -25,7 +25,7 @@ use keystore2::{authorization::AuthorizationManager, id_rotation::IdRotationStat
 use legacykeystore::LegacyKeystore;
 use log::{error, info};
 use rusqlite::trace as sqlite_trace;
-use std::{os::raw::c_int, panic, path::Path, sync::mpsc::channel};
+use std::{os::raw::c_int, panic, path::Path, sync::mpsc::channel, time::Duration};
 
 static KS2_SERVICE_NAME: &str = "android.system.keystore2.IKeystoreService/default";
 static APC_SERVICE_NAME: &str = "android.security.apc";
@@ -109,9 +109,24 @@ fn main() {
     binder::ProcessState::set_thread_pool_max_thread_count(20);
     binder::ProcessState::start_thread_pool();
 
-    let ks_service = KeystoreService::new_native_binder(id_rotation_state).unwrap_or_else(|e| {
-        panic!("Failed to create service {KS2_SERVICE_NAME} because of {e:?}.");
-    });
+    // the /default Keymaster or KeyMint backend may take a long time to
+    // appear on gsi devices: on legacy vendors it is a hidl keymaster hal
+    // that lazy-starts through hwservicemanager, and can only link once
+    // the vndk apexes are activated and the vendor linker namespace is
+    // configured. aborting here feeds the critical-service reboot path
+    // (reboot to bootloader before sys.boot_completed), so wait for the
+    // backend instead of dying.
+    let ks_service = loop {
+        match KeystoreService::new_native_binder(id_rotation_state.clone()) {
+            Ok(service) => break service,
+            Err(e) => {
+                error!(
+                    "Failed to create service {KS2_SERVICE_NAME} ({e:?}); retrying in 5 seconds."
+                );
+                std::thread::sleep(Duration::from_secs(5));
+            }
+        }
+    };
     binder::add_service(KS2_SERVICE_NAME, ks_service.as_binder()).unwrap_or_else(|e| {
         panic!("Failed to register service {KS2_SERVICE_NAME} because of {e:?}.");
     });
