@@ -2820,6 +2828,7 @@ status_t Camera3Device::configureStreamsLocked(int operatingMode,
     }
 
     mRequestThread->setComposerSurface(mComposerOutput);
+    mRequestThread->setSamsungVideoFps(samsungVideoFps);
 
