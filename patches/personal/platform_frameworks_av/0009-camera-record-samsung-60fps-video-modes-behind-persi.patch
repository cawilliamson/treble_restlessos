@@ -3309,6 +3318,7 @@ Camera3Device::RequestThread::RequestThread(wp<Camera3Device> parent,
         mRotateAndCropOverride(ANDROID_SCALER_ROTATE_AND_CROP_NONE),
         mAutoframingOverride(ANDROID_CONTROL_AUTOFRAMING_OFF),
         mComposerOutput(false),
+        mSamsungVideoFps(0),
         mCameraMute(ANDROID_SENSOR_TEST_PATTERN_MODE_OFF),
         mSettingsOverride(ANDROID_CONTROL_SETTINGS_OVERRIDE_OFF),
         mRepeatingLastFrameNumber(
@@ -3970,6 +3980,7 @@ bool Camera3Device::RequestThread::threadLoop() {
                                      && !mCompatInfo.shouldOverrideSensorOrientation())) ?
                         false : overrideAutoRotateAndCrop(captureRequest);
         captureRequest->mAutoframingChanged = overrideAutoframing(captureRequest);
+        overrideSamsungVideoFps(captureRequest);
         injectSessionParams(captureRequest, mInjectedSessionParams);
     }
 
@@ -4749,6 +4760,20 @@ status_t Camera3Device::RequestThread::setComposerSurface(bool composerSurfacePr
     return OK;
 }
 
+status_t Camera3Device::RequestThread::setSamsungVideoFps(int32_t fps) {
+    ATRACE_CALL();
+    Mutex::Autolock l(mTriggerMutex);
+    mSamsungVideoFps = fps;
+    return OK;
+}
+
+void Camera3Device::RequestThread::overrideSamsungVideoFps(const sp<CaptureRequest> &request) {
+    Mutex::Autolock l(mTriggerMutex);
+    if (mSamsungVideoFps == 0) return;
+    int32_t range[2] = {mSamsungVideoFps, mSamsungVideoFps};
+    request->mSettingsList.begin()->metadata.update(ANDROID_CONTROL_AE_TARGET_FPS_RANGE, range, 2);
+}
+
 status_t Camera3Device::RequestThread::setCameraMute(int32_t muteMode) {
     ATRACE_CALL();
     Mutex::Autolock l(mTriggerMutex);
