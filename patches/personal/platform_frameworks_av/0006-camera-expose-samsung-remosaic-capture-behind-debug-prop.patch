     dst = std::move(filteredParams);
 }
 
+bool getVendorTagByName(const CameraMetadata& info, const char* name, uint32_t* tag) {
+    sp<VendorTagDescriptorCache> cache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+    if (cache.get() == nullptr) return false;
+    sp<VendorTagDescriptor> vTags;
+    cache->getVendorTagDescriptor(info.getVendorId(), &vTags);
+    if (vTags.get() == nullptr) return false;
+    return CameraMetadata::getTagFromName(name, vTags.get(), tag) == OK;
+}
+
+static int64_t findBlobDuration(const std::vector<int64_t>& durations, int32_t width,
+        int32_t height) {
+    for (size_t i = 0; i + 3 < durations.size(); i += 4) {
+        if (durations[i] == HAL_PIXEL_FORMAT_BLOB && durations[i + 1] == width &&
+                durations[i + 2] == height) {
+            return durations[i + 3];
+        }
+    }
+    return -1;
+}
+
+void addSamsungRemosaicJpegSizes(CameraMetadata* info) {
+    uint32_t pictureTag;
+    if (!getVendorTagByName(*info, "samsung.android.scaler.availablePictureStreamConfigurations",
+            &pictureTag)) {
+        return;
+    }
+    const CameraMetadata& constInfo = *info;
+    camera_metadata_ro_entry picture = constInfo.find(pictureTag);
+    camera_metadata_ro_entry activeArray = constInfo.find(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+    camera_metadata_ro_entry configsEntry =
+            constInfo.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS);
+    camera_metadata_ro_entry minEntry =
+            constInfo.find(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS);
+    camera_metadata_ro_entry stallEntry =
+            constInfo.find(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS);
+    if (picture.count == 0 || activeArray.count != 4 || configsEntry.count == 0) return;
+
+    int32_t activeW = activeArray.data.i32[2];
+    int32_t activeH = activeArray.data.i32[3];
+    std::vector<int32_t> configs(configsEntry.data.i32, configsEntry.data.i32 + configsEntry.count);
+    std::vector<int64_t> minDurations(minEntry.data.i64, minEntry.data.i64 + minEntry.count);
+    std::vector<int64_t> stallDurations(stallEntry.data.i64,
+            stallEntry.data.i64 + stallEntry.count);
+    int64_t refMin = findBlobDuration(minDurations, activeW, activeH);
+    int64_t refStall = findBlobDuration(stallDurations, activeW, activeH);
+    if (refMin < 0 || refStall < 0) return;
+
+    bool added = false;
+    for (size_t i = 0; i + 3 < picture.count; i += 4) {
+        int32_t format = picture.data.i32[i];
+        int32_t width = picture.data.i32[i + 1];
+        int32_t height = picture.data.i32[i + 2];
+        int32_t direction = picture.data.i32[i + 3];
+        if (format != HAL_PIXEL_FORMAT_BLOB ||
+                direction != ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT) {
+            continue;
+        }
+        int64_t area = static_cast<int64_t>(width) * height;
+        int64_t activeArea = static_cast<int64_t>(activeW) * activeH;
+        if (area <= activeArea ||
+                static_cast<int64_t>(width) * activeH != static_cast<int64_t>(height) * activeW) {
+            continue;
+        }
+        if (findBlobDuration(minDurations, width, height) >= 0) continue;
+
+        double scale = static_cast<double>(area) / activeArea;
+        configs.insert(configs.end(), {format, width, height, direction});
+        minDurations.insert(minDurations.end(),
+                {format, width, height, static_cast<int64_t>(refMin * scale)});
+        stallDurations.insert(stallDurations.end(),
+                {format, width, height, static_cast<int64_t>(refStall * scale)});
+        ALOGI("%s: exposing %dx%d jpeg from samsung picture configurations", __FUNCTION__,
+                width, height);
+        added = true;
+    }
+    if (!added) return;
+
+    info->update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS, configs.data(), configs.size());
+    info->update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS, minDurations.data(),
+            minDurations.size());
+    info->update(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS, stallDurations.data(),
+            stallDurations.size());
+}
+
+void setSamsungRemosaicCameraClient(const CameraMetadata& deviceInfo, int64_t maxOutputArea,
+        CameraMetadata& sessionParams) {
+    camera_metadata_ro_entry activeArray = deviceInfo.find(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+    if (activeArray.count != 4 ||
+            maxOutputArea <= static_cast<int64_t>(activeArray.data.i32[2]) *
+                    activeArray.data.i32[3]) {
+        return;
+    }
+    uint32_t clientTag;
+    if (!getVendorTagByName(deviceInfo, "samsung.android.control.cameraClient", &clientTag)) {
+        return;
+    }
+    int32_t client = property_get_int32("debug.phh.samsung.remosaic_client", 1);
+    status_t res = sessionParams.update(clientTag, &client, 1);
+    ALOGI("%s: output larger than the active array, samsung cameraClient %d: %s (%d)",
+            __FUNCTION__, client, strerror(-res), res);
+}
+
 status_t overrideDefaultRequestKeys(CameraMetadata *request) {
     // Override the template request with ZoomRatioMapper
     status_t res = ZoomRatioMapper::initZoomRatioInTemplate(request);
