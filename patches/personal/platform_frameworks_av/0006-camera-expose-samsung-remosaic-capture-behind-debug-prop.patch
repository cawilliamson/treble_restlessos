+++ b/services/camera/libcameraservice/common/CameraProviderManager.cpp
@@ -3289,6 +3289,10 @@ status_t CameraProviderManager::ProviderInfo::DeviceInfo3::getCameraCharacterist
         *characteristics = mCameraCharacteristics;
     }
 
+    if (property_get_bool("debug.phh.samsung.remosaic", false)) {
+        SessionConfigurationUtils::addSamsungRemosaicJpegSizes(characteristics);
+    }
+
     if (compatInfo.shouldRotateAndCrop() && compatInfo.shouldOverrideSensorOrientation()) {
         const auto &lensFacingEntry = characteristics->find(ANDROID_LENS_FACING);
         const auto &sensorOrientationEntry = characteristics->find(ANDROID_SENSOR_ORIENTATION);
diff --git a/services/camera/libcameraservice/device3/Camera3Device.cpp b/services/camera/libcameraservice/device3/Camera3Device.cpp
index 32e4d40..60dd866 100644
--- a/services/camera/libcameraservice/device3/Camera3Device.cpp
+++ b/services/camera/libcameraservice/device3/Camera3Device.cpp
@@ -1492,6 +1492,16 @@ status_t Camera3Device::filterParamsAndConfigureLocked(const CameraMetadata& par
         filteredParams = request->mSettingsList.begin()->metadata;
     }
 
+    if (property_get_bool("debug.phh.samsung.remosaic", false)) {
+        int64_t maxOutputArea = 0;
+        for (size_t i = 0; i < mOutputStreams.size(); i++) {
+            sp<Camera3OutputStreamInterface> stream = mOutputStreams[i];
+            maxOutputArea = std::max(maxOutputArea,
+                    static_cast<int64_t>(stream->getWidth()) * stream->getHeight());
+        }
+        setSamsungRemosaicCameraClient(mDeviceInfo, maxOutputArea, filteredParams);
+    }
+
     return configureStreamsLocked(operatingMode, filteredParams);
 }
 
