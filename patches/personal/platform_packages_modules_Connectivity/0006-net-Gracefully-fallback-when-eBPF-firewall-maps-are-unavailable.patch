From 7d3564c3308c31d8044eb87e25c896a8e4537bb9 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 28 May 2026 15:57:33 +0100
Subject: [PATCH 6/6] net: Gracefully fallback when eBPF firewall maps are
 unavailable

Many devices running GSIs or legacy/vendor-modified kernels do not
fully support Android's modern eBPF networking stack.

On these devices, accessing BPF maps may fail with:
- EINVAL / ENOENT (ErrnoException)
- null return from getValue() on stale/invalid maps
- RuntimeException from map wrapper on broken implementations

Previously each of these would throw from system_server, causing
firewall failures, Data Saver crashes, and NetworkStatsService restarts.

Compromise approach
=================

For BpfNetMapsUtils:
- Keep ErrnoException-first catch with Log.w() + strerror.
  This is the normal expected failure mode on broken BPF.

- Add a broader Exception catch with Log.e() + stack trace.
  This catches non-errno failures (NPE, IllegalStateException,
  IllegalArgumentException from unexpected map states) without
  crashing system_server. Still returns safe defaults:
  firewall disabled, uid rule ALLOW, data saver disabled.
  Log.e() ensures the failure is visible in bugreports.

- Add null guards for getValue() return values.
  Some broken devices return null instead of throwing.

For NetworkStatsService:
- Per-map try/catch with Log.e() instead of single blanket catch.
  This lets some BPF maps work even if others fail.
- SkDestroyListener null-guards mCookieTagMap.
- Dependencies Log.wtf() -> Log.e() so map open failures are non-fatal.
- Sets persist.sys.phh.bpf_broken via reflection so Settings UI can
  read it and warn users that per-app network blocking won't work.

This gives the debug-builds' fallback coverage (all device-breaking
conditions handled) while avoiding the too-broad Throwable swallow
that might mask real framework bugs on working devices.
---
 .../src/android/net/BpfNetMapsUtils.java      | 67 +++++++++++++++++--
 .../server/net/NetworkStatsService.java       | 57 ++++++++++++++--
 2 files changed, 111 insertions(+), 13 deletions(-)

diff --git a/framework/src/android/net/BpfNetMapsUtils.java b/framework/src/android/net/BpfNetMapsUtils.java
index 287116a..2c79f25 100644
--- a/framework/src/android/net/BpfNetMapsUtils.java
+++ b/framework/src/android/net/BpfNetMapsUtils.java
@@ -68,6 +68,7 @@ import static android.system.OsConstants.EINVAL;
 import android.os.Build;
 import android.os.Process;
 import android.os.ServiceSpecificException;
+import android.os.SystemProperties;
 import android.os.UserHandle;
 import android.system.ErrnoException;
 import android.system.Os;
@@ -95,6 +96,20 @@ import java.util.StringJoiner;
 // Note that NetworkStack can not use this before U due to b/326143935
 @RequiresApi(Build.VERSION_CODES.TIRAMISU)
 public class BpfNetMapsUtils {
+
+    private static volatile boolean sBpfBrokenLogged;
+
+    private static void markBpfBroken() {
+        if (sBpfBrokenLogged) return;
+        sBpfBrokenLogged = true;
+        android.util.Log.e("BpfNetMapsUtils",
+                "BPF maps are unavailable on this device; per-app network blocking (firewall) will not work.");
+    }
+
+    public static boolean isBpfBroken() {
+        return "true".equals(SystemProperties.get("persist.sys.phh.bpf_broken", ""));
+    }
+
     // Bitmaps for calculating whether a given uid is blocked by firewall chains.
     private static final long sMaskDropIfSet;
     private static final long sMaskDropIfUnset;
@@ -218,10 +233,23 @@ public class BpfNetMapsUtils {
         final long match = getMatchByFirewallChain(chain);
         try {
             final U32 config = configurationMap.getValue(UID_RULES_CONFIGURATION_KEY);
+            if (config == null) {
+                markBpfBroken();
+                android.util.Log.w("BpfNetMapsUtils",
+                        "getValue returned null for firewall chain status");
+                return false;
+            }
             return (config.val & match) != 0;
         } catch (ErrnoException e) {
-            throw new ServiceSpecificException(e.errno,
+            markBpfBroken();
+            android.util.Log.w("BpfNetMapsUtils",
                     "Unable to get firewall chain status: " + Os.strerror(e.errno));
+            return false;
+        } catch (Exception e) {
+            markBpfBroken();
+            android.util.Log.e("BpfNetMapsUtils",
+                    "Unexpected error reading firewall chain status", e);
+            return false;
         }
     }
 
@@ -246,11 +274,24 @@ public class BpfNetMapsUtils {
         final boolean isAllowList = isFirewallAllowList(chain);
         try {
             final UidOwnerValue uidMatch = uidOwnerMap.getValue(new S32(uid));
-            final boolean isMatchEnabled = uidMatch != null && (uidMatch.rule & match) != 0;
+            if (uidMatch == null) {
+                markBpfBroken();
+                android.util.Log.w("BpfNetMapsUtils",
+                        "getValue returned null for uid rule status");
+                return isAllowList ? FIREWALL_RULE_ALLOW : FIREWALL_RULE_DENY;
+            }
+            final boolean isMatchEnabled = (uidMatch.rule & match) != 0;
             return isMatchEnabled == isAllowList ? FIREWALL_RULE_ALLOW : FIREWALL_RULE_DENY;
         } catch (ErrnoException e) {
-            throw new ServiceSpecificException(e.errno,
+            markBpfBroken();
+            android.util.Log.w("BpfNetMapsUtils",
                     "Unable to get uid rule status: " + Os.strerror(e.errno));
+            return FIREWALL_RULE_ALLOW;
+        } catch (Exception e) {
+            markBpfBroken();
+            android.util.Log.e("BpfNetMapsUtils",
+                    "Unexpected error reading uid rule status", e);
+            return FIREWALL_RULE_ALLOW;
         }
     }
 
@@ -372,10 +413,24 @@ public class BpfNetMapsUtils {
 
         if (dataSaverEnabledMap == null) return false;
         try {
-            return dataSaverEnabledMap.getValue(DATA_SAVER_ENABLED_KEY).val == DATA_SAVER_ENABLED;
+            final U8 val = dataSaverEnabledMap.getValue(DATA_SAVER_ENABLED_KEY);
+            if (val == null) {
+                markBpfBroken();
+                android.util.Log.w("BpfNetMapsUtils",
+                        "getValue returned null for data saver status");
+                return false;
+            }
+            return val.val == DATA_SAVER_ENABLED;
         } catch (ErrnoException e) {
-            throw new ServiceSpecificException(e.errno, "Unable to get data saver: "
-                    + Os.strerror(e.errno));
+            markBpfBroken();
+            android.util.Log.w("BpfNetMapsUtils",
+                    "Unable to get data saver: " + Os.strerror(e.errno));
+            return false;
+        } catch (Exception e) {
+            markBpfBroken();
+            android.util.Log.e("BpfNetMapsUtils",
+                    "Unexpected error reading data saver status", e);
+            return false;
         }
     }
 }
