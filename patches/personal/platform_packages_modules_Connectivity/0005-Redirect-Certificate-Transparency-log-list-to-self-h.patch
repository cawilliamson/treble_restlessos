From 0d722b45895270b2d5460303f6e70fe6dc2fb281 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 10 Mar 2026 16:36:44 +0000
Subject: [PATCH 5/5] Redirect Certificate Transparency log list to self-hosted
 proxy

The CT log list downloader unconditionally contacts www.gstatic.com to
fetch the Android certificate transparency log list. Redirect to a
self-hosted Cloudflare Worker proxy at gstatic-ct.chrisaw.io which
fetches the same signed data from Google and serves it cached without
exposing device IPs directly to Google infrastructure. The CT list
data is publicly available and cryptographically signed, so proxying
does not compromise its integrity.
---
 .../service/src/com/android/server/net/ct/Config.java           | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/networksecurity/service/src/com/android/server/net/ct/Config.java b/networksecurity/service/src/com/android/server/net/ct/Config.java
index 398ecd1..5b5d975 100644
--- a/networksecurity/service/src/com/android/server/net/ct/Config.java
+++ b/networksecurity/service/src/com/android/server/net/ct/Config.java
@@ -24,7 +24,7 @@ final class Config {

     // CT paths
     static final String CT_ROOT_DIRECTORY_PATH = "/data/misc/keychain/ct/";
-    static final String URL_PREFIX = "https://www.gstatic.com/android/certificate_transparency/";
+    static final String URL_PREFIX = "https://gstatic-ct.chrisaw.io/";

     // Phenotype flags
     static final String NAMESPACE_NETWORK_SECURITY = "network_security";
