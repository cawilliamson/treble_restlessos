From de987f19611e2be086f404c7dee91f2b044a4632 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 28 Sep 2026 09:16:30 +0100
Subject: [PATCH 1/4] connectivity: tolerate BPF-less legacy kernels

the eBPF networking stack assumes modern kernels across the loader,
clat, bpfhandler, netbpfload and the firewall maps. every patch here
relaxes one fatal assumption for kernels without working bpf support,
and later patches depend on the earlier ones' relaxed behaviour, so
they are merged into one change.
---
 bpf/headers/include/bpf/BpfUtils.h            |   5 +-
 bpf/headers/include/bpf/KernelUtils.h         |   6 +
 bpf/loader/NetBpfLoad.cpp                     | 108 +++++++++------
 bpf/netd/BpfHandler.cpp                       | 128 ++++++++++--------
 .../src/android/net/BpfNetMapsUtils.java      |  67 ++++++++-
 .../server/net/NetworkStatsService.java       |  57 +++++++-
 ...id_server_connectivity_ClatCoordinator.cpp |  16 +--
 .../src/com/android/server/BpfNetMaps.java    |  18 +++
 8 files changed, 286 insertions(+), 119 deletions(-)

diff --git a/bpf/headers/include/bpf/BpfUtils.h b/bpf/headers/include/bpf/BpfUtils.h
index 5ca52c6..86fe01e 100644
--- a/bpf/headers/include/bpf/BpfUtils.h
+++ b/bpf/headers/include/bpf/BpfUtils.h
@@ -152,7 +152,10 @@ const bool isAtLeastS    = (api_level_full >= 3100);  // 31
 const bool isAtLeastT    = (api_level_full >= 3300);  // 33
 const bool isAtLeastU    = (api_level_full >= 3400);  // 34
 const bool isAtLeastV    = (api_level_full >= 3500);  // 35
-const bool isAtLeast25Q2 = (api_level_full >= 3600);  // 36.0
+// GSI: 25Q2 BPF features need a 5.4+ kernel, and api_level_full says nothing about
+// the kernel actually running, so gate on the kernel too. isAtLeastKernelVersion()
+// cannot be used here: it short-circuits to true against minSupportedKernelVer.
+const bool isAtLeast25Q2 = (api_level_full >= 3600) && (kernelVersion() >= KVER(5, 4, 0));
 const bool isAtLeast25Q4 = (api_level_full >= 3610);  // 36.1
 const bool isAtLeast26Q2 = (api_level_full >= 3700);  // 37.0
 const bool isAtLeast26Q3 = (api_level_full >= 3702);  // 37.0+
diff --git a/bpf/headers/include/bpf/KernelUtils.h b/bpf/headers/include/bpf/KernelUtils.h
index add20c5..7ec3f3a 100644
--- a/bpf/headers/include/bpf/KernelUtils.h
+++ b/bpf/headers/include/bpf/KernelUtils.h
@@ -20,6 +20,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/personality.h>
+#include <sys/system_properties.h>
 #include <sys/utsname.h>
 
 namespace android {
@@ -34,6 +35,11 @@ static inline unsigned uncachedKernelVersion() {
     unsigned kver_major = 0;
     unsigned kver_minor = 0;
     unsigned kver_sub = 0;
+    char kver_override[PROP_VALUE_MAX];
+    if (__system_property_get("ro.bpf.kver_override", kver_override) > 0) {
+        if (sscanf(kver_override, "%u.%u.%u", &kver_major, &kver_minor, &kver_sub) >= 2)
+            return KVER(kver_major, kver_minor, kver_sub);
+    }
     if (sscanf(buf.release, "%u.%u.%u", &kver_major, &kver_minor, &kver_sub) < 2) abort();
     return KVER(kver_major, kver_minor, kver_sub);
 }
