@@ -1512,6 +1519,19 @@ static int libbpfPrint(enum libbpf_print_level lvl, const char *const formatStr,
 static int doLoad(char** argv, char * const envp[]) {
     libbpf_set_print(libbpfPrint);
 
+    // [GSI] Fail-safe for the loader hand-off chain: the property is set by the
+    // final 'done' re-exec, and any stage dying before that leaves init's
+    // wait_for_prop hung forever. A forked one-shot watchdog force-releases the
+    // wait; this is a no-op if the chain completed within the window.
+    pid_t watchdog = fork();
+    if (watchdog == 0) {
+        sleep(45);
+        if (!GetIntProperty("bpf.progs_loaded", 0)) {
+            SetProperty("bpf.progs_loaded", "1");
+        }
+        _exit(0);
+    }
+
     bool failed = false;
 
