From 710926dd6198286f0960f86d8a2cfd6897b53e75 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 27 Feb 2026 11:59:53 +0000
Subject: [PATCH] Fix agolddaemon cmd() AIDL: use IAgoldDaemonCallback
 parameter

The cmd() method was incorrectly declared as taking IAgoldDaemon
(the service interface itself) instead of IAgoldDaemonCallback.
The vendor daemon implementation actually expects IAgoldDaemonCallback,
as confirmed by the V2-ndk symbol: BpAgoldDaemon::cmd(string,
shared_ptr<IAgoldDaemonCallback>).

This fixes the AIDL-generated Java binding so TrebleApp can call
cmd() directly with a proper callback (or null) instead of shelling
out to agold-cmd.
---
 .../1/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl    | 2 +-
 .../vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl      | 2 +-
 .../vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl      | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/1/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl b/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/1/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
index 84be174..c93a070 100644
--- a/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/1/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
+++ b/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/1/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
@@ -28,7 +28,7 @@ interface IAgoldDaemon {
   void WriteStringDataToIoCtrl(String a, int b);
   boolean checkGoogleKey();
   boolean checkTeeKey();
-  void cmd(String a, vendor.mediatek.hardware.agolddaemon.IAgoldDaemon cb);
+  void cmd(String a, vendor.mediatek.hardware.agolddaemon.IAgoldDaemonCallback cb);
   String getCameraClientPackageName();
   String getNotGsi();
   String readSysFile(String path);
diff --git a/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/current/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl b/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/current/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
index 84be174..c93a070 100644
--- a/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/current/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
+++ b/aidl/vendor/mediatek/hardware/agolddaemon/aidl_api/vendor.mediatek.hardware.agolddaemon/current/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
@@ -28,7 +28,7 @@ interface IAgoldDaemon {
   void WriteStringDataToIoCtrl(String a, int b);
   boolean checkGoogleKey();
   boolean checkTeeKey();
-  void cmd(String a, vendor.mediatek.hardware.agolddaemon.IAgoldDaemon cb);
+  void cmd(String a, vendor.mediatek.hardware.agolddaemon.IAgoldDaemonCallback cb);
   String getCameraClientPackageName();
   String getNotGsi();
   String readSysFile(String path);
diff --git a/aidl/vendor/mediatek/hardware/agolddaemon/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl b/aidl/vendor/mediatek/hardware/agolddaemon/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
index 2f39e9b..4a96b57 100644
--- a/aidl/vendor/mediatek/hardware/agolddaemon/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
+++ b/aidl/vendor/mediatek/hardware/agolddaemon/vendor/mediatek/hardware/agolddaemon/IAgoldDaemon.aidl
@@ -13,7 +13,7 @@ void WriteIntDataToIoCtrl(in byte[] a, int b);
 void WriteStringDataToIoCtrl(String a, int b);
 boolean checkGoogleKey();
 boolean checkTeeKey();
-void cmd(String a, IAgoldDaemon cb);
+void cmd(String a, IAgoldDaemonCallback cb);
 String getCameraClientPackageName();
 String getNotGsi();
 String readSysFile(String path);
-- 
