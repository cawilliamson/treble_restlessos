From 09476ce9ff51cd0d02d4b8d46e112f5c8dde0c54 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 3 Apr 2026 13:27:41 +0100
Subject: [PATCH] ensure ADB is always enabled on debug builds

remove the phh-on-boot.sh block that deletes ro.adb.secure and stops
adbd at boot_completed, and set persist.sys.usb.config=adb in base.mk
so unauthenticated ADB remains available across all boots.

add an early-init poller (phh-early-adb.sh) that detects the USB
controller the instant it appears in sysfs and re-triggers AOSP's USB
property flow.  this covers devices where vendor init never sets
sys.usb.controller or sets it after AOSP's triggers have already fired.
the poller bails out immediately if ADB is already functional, avoiding
a race where re-triggering sys.usb.config tears down a working session.

debug-only patch -- must not be shipped in release builds.
---
 00-early-adb.rc  | 14 ++++++++++
 base.mk          |  5 +++-
 phh-early-adb.sh | 68 ++++++++++++++++++++++++++++++++++++++++++++++++
 phh-on-boot.sh   |  8 ++----
 4 files changed, 88 insertions(+), 7 deletions(-)
 create mode 100644 00-early-adb.rc
 create mode 100755 phh-early-adb.sh

diff --git a/00-early-adb.rc b/00-early-adb.rc
new file mode 100644
index 0000000..cb743e5
--- /dev/null
+++ b/00-early-adb.rc
@@ -0,0 +1,14 @@
+# start early ADB poller at the earliest possible init phase.
+# the service runs in the background and polls for a USB controller
+# to appear in sysfs, then sets the properties AOSP's init.usb.configfs.rc
+# needs to bring up adbd.  this is necessary because many vendor init
+# scripts either don't set sys.usb.controller at all or set it after
+# AOSP's USB triggers have already fired and failed.
+on early-init
+    start phh_early_adb
+
+service phh_early_adb /system/bin/sh /system/etc/phh-early-adb.sh
+    user root
+    oneshot
+    disabled
+    seclabel u:r:phhsu_daemon:s0
diff --git a/base.mk b/base.mk
index 2462c9b..8f9164c 100644
--- a/base.mk
+++ b/base.mk
@@ -42,6 +42,7 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 
 # Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
+    persist.sys.usb.config=adb \
     ro.cust.cdrom=/dev/null
 
 # VNDK config files
@@ -153,10 +154,12 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     device/phh/treble/files/adbd.rc:system/etc/init/adbd.rc \
+    device/phh/treble/00-early-adb.rc:system/etc/init/00-early-adb.rc \
     device/phh/treble/00-fix-metadata.rc:system/etc/init/00-fix-metadata.rc \
     device/phh/treble/00-fix-metadata.sh:system/etc/00-fix-metadata.sh \
     device/phh/treble/8849-proinfo.rc:system/etc/init/8849-proinfo.rc \
-    device/phh/treble/8849-proinfo.sh:system/etc/8849-proinfo.sh
+    device/phh/treble/8849-proinfo.sh:system/etc/8849-proinfo.sh \
+    device/phh/treble/phh-early-adb.sh:system/etc/phh-early-adb.sh
 
 # MTK incoming SMS fix
 PRODUCT_PACKAGES += \
diff --git a/phh-early-adb.sh b/phh-early-adb.sh
new file mode 100755
index 0000000..6f45cb2
--- /dev/null
+++ b/phh-early-adb.sh
@@ -0,0 +1,68 @@
+#!/system/bin/sh
+# early ADB: poll for a USB controller and ensure AOSP's USB triggers
+# can fire successfully.  starts at early-init so it runs concurrently
+# with vendor init, catching the UDC the instant it appears.
+#
+# problems this solves:
+#   - vendor never sets sys.usb.controller → AOSP writes empty UDC
+#   - vendor sets sys.usb.configfs too late → triggers already fired
+#   - AOSP triggers fired before UDC registered → "No such device"
+#   - gadget structure missing when triggers fire
+
+# bail out if ADB is already functional
+if getprop sys.usb.state | grep -q adb; then
+    exit 0
+fi
+
+# poll for UDC — 100ms intervals, 60s timeout
+i=0
+while [ $i -lt 600 ]; do
+    # re-check each iteration in case ADB came up via normal boot flow
+    if getprop sys.usb.state | grep -q adb; then
+        exit 0
+    fi
+    udc="$(ls /sys/class/udc 2>/dev/null | head -1)"
+    [ -n "$udc" ] && break
+    sleep 0.1
+    i=$((i + 1))
+done
+[ -z "$udc" ] && exit 1
+
+# final check before touching anything — ADB may have come up while polling
+if getprop sys.usb.state | grep -q adb; then
+    exit 0
+fi
+
+# ensure configfs is mounted
+mountpoint -q /config || mount -t configfs none /config 2>/dev/null
+
+# create gadget structure if vendor hasn't done it.
+# uses AOSP's expected layout (b.1) and google ADB VID/PID.
+gadget="/config/usb_gadget/g1"
+if [ -d /config ] && [ ! -d "$gadget" ]; then
+    mkdir -p "$gadget/strings/0x409" "$gadget/configs/b.1/strings/0x409"
+    echo 0x18d1 > "$gadget/idVendor"
+    echo 0x4EE7 > "$gadget/idProduct"
+    serial="$(cat /sys/class/android_usb/android0/iSerial 2>/dev/null)"
+    [ -z "$serial" ] && serial="$(getprop ro.serialno)"
+    echo "${serial:-GSI}" > "$gadget/strings/0x409/serialnumber"
+    echo "Android" > "$gadget/strings/0x409/manufacturer"
+    echo "GSI" > "$gadget/strings/0x409/product"
+fi
+
+# ensure ffs.adb function and config dir exist
+[ -d "$gadget/functions/ffs.adb" ] || mkdir -p "$gadget/functions/ffs.adb" 2>/dev/null
+[ -d "$gadget/configs/b.1/strings/0x409" ] || mkdir -p "$gadget/configs/b.1/strings/0x409" 2>/dev/null
+
+# set properties — these are the prerequisites for AOSP's init.usb.configfs.rc
+setprop sys.usb.controller "$udc"
+[ "$(getprop sys.usb.configfs)" != "1" ] && setprop sys.usb.configfs 1
+
+# re-trigger USB config.  AOSP's triggers likely already fired and failed
+# because the UDC wasn't ready.  cycling through "none" then back to the
+# desired config causes the triggers to fire again, now with valid UDC.
+config="$(getprop persist.sys.usb.config)"
+[ -z "$config" ] && config="adb"
+setprop sys.usb.config none
+sleep 0.2
+setprop sys.usb.config "$config"
diff --git a/phh-on-boot.sh b/phh-on-boot.sh
index 0b5f179..b04e5af 100644
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -36,12 +36,8 @@ if [ ! -f /metadata/securize_disable ]; then
   resetprop_phh -n init.svc.flash_recovery stopped
 fi
 
-# End first-boot debug ADB window.
-if [ "$(getprop ro.adb.secure)" = "0" ]; then
-    resetprop_phh --delete ro.adb.secure
-    resetprop_phh --delete persist.sys.usb.config
-    stop adbd
-fi
+# debug build: keep unauthenticated ADB open permanently
+# (the cleanup block that disables ADB at boot_completed is removed)
 
 vndk="$(getprop persist.sys.vndk)"
 [ -z "$vndk" ] && vndk="$(getprop ro.vndk.version |grep -oE '^[0-9]+')"
-- 
2.53.0

