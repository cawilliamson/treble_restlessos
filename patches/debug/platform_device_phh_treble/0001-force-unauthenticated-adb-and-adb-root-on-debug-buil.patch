From a2b2d81284d7d1a8211f1a56c3ac4007a2df56da Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 7 Apr 2026 16:39:11 +0100
Subject: [PATCH] force unauthenticated adb and adb root on debug builds

debug builds must have open, unauthenticated adb with adb root
available for the entire lifetime of every boot. bake
ro.adb.secure=0, ro.debuggable=1 and persist.sys.usb.config=adb
into the default system properties and re-assert them on every
boot in rw-system.sh, independent of release-build gates.
---
 base.mk      | 6 ++++++
 rw-system.sh | 5 +++++
 2 files changed, 11 insertions(+)

diff --git a/base.mk b/base.mk
index 2462c9b..3e7056e 100644
--- a/base.mk
+++ b/base.mk
@@ -44,6 +44,12 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     ro.cust.cdrom=/dev/null
 
+# debug builds: unauthenticated adb + adb root, always.
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
+    persist.sys.usb.config=adb \
+    ro.adb.secure=0 \
+    ro.debuggable=1
+
 # VNDK config files
 PRODUCT_COPY_FILES += \
     device/phh/treble/vndk-detect:system/bin/vndk-detect \
diff --git a/rw-system.sh b/rw-system.sh
index 56317b1..e10a14f 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -806,6 +806,11 @@ else
     resetprop_phh -n persist.pm.mock-upgrade false
 fi
 
+# debug builds: force unauthenticated adb + adb root every boot.
+resetprop_phh ro.adb.secure 0
+resetprop_phh ro.debuggable 1
+resetprop_phh -n persist.sys.usb.config adb
+
 if [ ! -f /metadata/securize_disable ]; then
     copyprop ro.build.device ro.vendor.build.device
     copyprop ro.system.build.fingerprint ro.vendor.build.fingerprint
-- 
