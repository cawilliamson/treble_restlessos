From 21dd49af3c903208f0c20a60481dfa1289042a86 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 28 Mar 2026 17:29:31 +0000
Subject: [PATCH] logd: grant logcat access to all callers unconditionally

bypass all credential and supplementary group checks in
clientHasLogCredentials so that any process can read the full logcat
buffer without authentication.

debug-only patch -- must not be shipped in release builds.
---
 logd/LogPermissions.cpp | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/logd/LogPermissions.cpp b/logd/LogPermissions.cpp
index b8b0bd0..8e17d9e 100644
--- a/logd/LogPermissions.cpp
+++ b/logd/LogPermissions.cpp
@@ -135,14 +135,14 @@ bool clientCanWriteSecurityLog(uid_t uid, gid_t gid, pid_t pid) {
 }
 
 bool clientHasLogCredentials(uid_t uid, gid_t gid, pid_t pid) {
-    if (UserIsPrivileged(uid) || UserIsPrivileged(gid)) {
-        return true;
-    }
-    // FYI We will typically be here for 'adb logcat'
-    return checkSupplementaryGroup(uid, gid, pid, AID_LOG);
+    // debug build: grant logcat access to all callers unconditionally
+    return true;
 }
 
 bool clientHasLogCredentials(SocketClient* cli) {
+    // debug build: grant logcat access to all callers unconditionally
+    return true;
+
     if (UserIsPrivileged(cli->getUid()) || UserIsPrivileged(cli->getGid())) {
         return true;
     }
-- 
2.53.0

