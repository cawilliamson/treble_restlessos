From 8b7b18be978665a55e12a5084c6f4a0f69cbeb30 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 29 Mar 2026 23:35:59 +0100
Subject: [PATCH] Restore permissive su domain for debug builds

Re-add the permissive su declaration that the personal tier removes.
Debug builds use the userdebug variant which includes the su binary
via PRODUCT_PACKAGES_DEBUG, so the domain needs to be permissive for
root shell access to work.
---
 private/su.te | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/private/su.te b/private/su.te
index 9521a74..fae9b98 100644
--- a/private/su.te
+++ b/private/su.te
@@ -23,9 +23,8 @@ userdebug_or_eng(`
   # own domain.
   virtualizationservice_use(su)
 
-  # do not declare su as permissive. the su binary is not included in GSI
-  # builds (treble_arm64_bvN = no su) so the domain is never entered, and
-  # permissive domains are rejected by the build system in user builds.
+  # su is also permissive to permit setenforce.
+  permissive su;
 
   app_domain(su)
 
-- 
