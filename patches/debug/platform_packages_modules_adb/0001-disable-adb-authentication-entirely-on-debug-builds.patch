From 0aee13fafcc68e98f0c6c5d9791661934dc43f95 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 7 Apr 2026 16:45:07 +0100
Subject: [PATCH] disable adb authentication entirely on debug builds

hardcode auth_required = false in adbd instead of gating it on
ro.adb.secure. debug builds have no reason to ever require host
authorisation and this removes any dependency on runtime property
state or boot-script ordering.
---
 daemon/main.cpp | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 5c897b0..1dcb3a0 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -219,9 +219,8 @@ int adbd_main() {
     // descriptor will always be open.
     adbd_cloexec_auth_socket();
 
-    // Allow boot scripts to control authentication via ro.adb.secure.
-    // Default to requiring auth when the property is absent.
-    auth_required = android::base::GetBoolProperty("ro.adb.secure", true);
+    // debug build: adb authentication is compiled out entirely.
+    auth_required = false;
 
     // Our external storage path may be different than apps, since
     // we aren't able to bind mount after dropping root.
-- 
2.53.0

