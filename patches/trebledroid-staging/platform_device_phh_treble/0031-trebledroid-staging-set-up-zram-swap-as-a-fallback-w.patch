From a03b9ee0417645a2c0005edc227e9c241aaf4a5c Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 21 Jun 2026 20:36:41 +0100
Subject: [PATCH 31/31] trebledroid-staging: set up zram swap as a fallback when the
 vendor hasn't

the GSI itself does not configure zram -- AOSP's init.rc only chowns
/sys/block/zram0/{idle,writeback}, expecting the vendor partition to
mkswap + swapon. on devices whose vendor doesn't set up swap, low-RAM
foreground workloads (PDF and WebView renderers in isolated processes,
which carry oom_score_adj ~1000) get OOM-reaped at the slightest memory
pressure, producing blurry or failed renders (#92 and similar).

append a guarded zram fallback to phh-on-boot.sh (runs on
sys.boot_completed, in the phhsu_daemon domain). if no swap is already
active and the kernel exposes a zram device, set up a compressed swap
device at ~half of RAM (lz4 when available). running it at boot_completed
(not during early init) means a vendor that already configured zram is
left untouched -- the guard skips when /proc/swaps already has an entry.

no-op when the kernel has no zram support (/sys/block/zram0 absent) or
/proc/meminfo is unreadable, so devices that can't support zram are
unaffected. no sepolicy companion is needed: phhsu_daemon already holds
rw_file_perms on dev_type:blk_file (covers ram_device, the label of
/dev/block/zram0), rwx_file_perms on sysfs_type:file (covers sysfs_zram),
and capability sys_admin for swapon.

Refs: #92
---
 phh-on-boot.sh | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/phh-on-boot.sh b/phh-on-boot.sh
index 6d7bd02..35d4e32 100644
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -92,6 +92,34 @@ fi
 
 setprop ctl.stop storageproxyd
 
+# zram swap fallback. the GSI itself does not set up zram -- AOSP's init.rc only
+# chowns /sys/block/zram0/{idle,writeback}, expecting the vendor to mkswap +
+# swapon. on devices whose vendor doesn't configure swap, low-RAM foreground
+# workloads (PDF/WebView renderers in isolated processes, which carry
+# oom_score_adj ~1000) get OOM-reaped at the slightest memory pressure,
+# producing blurry or failed renders (#92 and similar). running this at
+# boot_completed (not during early init) means a vendor that already set up
+# zram is left untouched -- the guard skips when any swap is already active.
+# no-op when the kernel has no zram support (/sys/block/zram0 absent) or no
+# RAM read is available. zram is compressed swap in RAM; disksize is half of
+# MemTotal, lz4 when the kernel exposes it (else the zram default, usually
+# lzo). this runs in the phhsu_daemon domain, which already holds rw_file_perms
+# on dev_type:blk_file (ram_device) and rwx_file_perms on sysfs_type:file
+# (sysfs_zram) plus capability sys_admin, so no sepolicy companion is needed.
+if [ -e /sys/block/zram0 ] && ! grep -qE '^/' /proc/swaps 2>/dev/null; then
+    echo 1 > /sys/block/zram0/reset 2>/dev/null || true
+    if grep -qw lz4 /sys/block/zram0/comp_algorithm 2>/dev/null; then
+        echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
+    fi
+    memtotal_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)
+    if [ -n "$memtotal_kb" ]; then
+        echo $((memtotal_kb * 1024 / 2)) > /sys/block/zram0/disksize 2>/dev/null || true
+        mkswap /dev/block/zram0 >/dev/null 2>&1 || true
+        swapon /dev/block/zram0 2>/dev/null || true
+        log -t phh-on-boot "zram swap fallback active (disksize ~half of RAM)"
+    fi
+fi
+
 sleep 10
 
 minijailSrc=/system/system_ext/apex/com.android.vndk.v28/lib/libminijail.so
-- 
2.54.0

