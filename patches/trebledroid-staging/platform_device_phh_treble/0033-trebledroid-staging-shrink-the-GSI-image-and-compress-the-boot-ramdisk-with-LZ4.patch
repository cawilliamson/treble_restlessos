From 167d3c923b536d77ab31c5558153a71079a6f213 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 21 Jun 2026 21:02:46 +0100
Subject: [PATCH 33/33] trebledroid-staging: shrink the GSI image and compress the
 boot ramdisk with LZ4

enable BOARD_RAMDISK_USE_LZ4 so the boot initramfs is LZ4-compressed (faster
decompression at boot than the default gzip), and add build flags that shrink
the system image:

- PRODUCT_ART_TARGET_INCLUDE_DEBUG_BUILD := false  -- drop the ART debug runtime
- PRODUCT_MINIMIZE_JAVA_DEBUG_INFO := true         -- strip Java debug info
- WITH_DEXPREOPT_BOOT_IMG_AND_SYSTEM_SERVER_ONLY := true  -- only dexpreopt the
  boot image + system_server, not every system app
- PRODUCT_DEX_PREOPT_DEFAULT_COMPILER_FILTER := verify    -- minimal pre-compiled
  odex (verify only, no AOT code in the image)

trade-off: with only boot+system_server dexpreopted at the verify filter, the
other system apps dexopt on first boot and run interpreted+JIT until warm, so
first boot and initial app launches are slower -- accepted for a smaller image.
DONT_UNCOMPRESS_PRIV_APPS_DEXFILES is deliberately NOT set: it would keep
priv-app dex compressed (saving image bytes) but force per-app decompression to
RAM at runtime, which costs the memory headroom we are trying to free (#92).

Refs: #92
---
 base.mk                       | 13 +++++++++++++
 tdgsi_arm64_ab/BoardConfig.mk |  5 +++++
 2 files changed, 18 insertions(+)

diff --git a/base.mk b/base.mk
index 432cfb4..f65a18e 100644
--- a/base.mk
+++ b/base.mk
@@ -260,6 +260,19 @@ PRODUCT_PACKAGES += \
     QualifiedNetworksService \
     MtkInCallService \
 
+# image-size reduction: strip the ART debug build + Java debug info, and limit
+# dexpreopt to the boot image + system_server with the verify filter so the
+# system image carries minimal pre-compiled odex. trade-off: apps dexopt on
+# first boot and run interpreted+JIT until warm, so first boot and initial app
+# launches are slower -- accepted for a smaller GSI image. DONT_UNCOMPRESS_
+# PRIV_APPS_DEXFILES is deliberately NOT set: it would keep priv-app dex
+# compressed (saving image bytes) but force per-app decompression to RAM at
+# runtime, costing the very memory headroom we are trying to free (#92).
+PRODUCT_ART_TARGET_INCLUDE_DEBUG_BUILD := false
+PRODUCT_MINIMIZE_JAVA_DEBUG_INFO := true
+WITH_DEXPREOPT_BOOT_IMG_AND_SYSTEM_SERVER_ONLY := true
+PRODUCT_DEX_PREOPT_DEFAULT_COMPILER_FILTER := verify
+
 # Two-pane layout in Settings
 $(call inherit-product, $(SRC_TARGET_DIR)/product/window_extensions.mk)
 PRODUCT_PRODUCT_PROPERTIES += \
diff --git a/tdgsi_arm64_ab/BoardConfig.mk b/tdgsi_arm64_ab/BoardConfig.mk
index 2fddc52..9108b4e 100644
--- a/tdgsi_arm64_ab/BoardConfig.mk
+++ b/tdgsi_arm64_ab/BoardConfig.mk
@@ -6,3 +6,8 @@ BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2147483648
 else
 BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE := 33554432
 endif
+
+# compress the boot initramfs with LZ4 (faster decompression at boot than the
+# default gzip; LZ4's ratio is slightly worse so the ramdisk is marginally
+# larger, but boot-time decompression is the win).
+BOARD_RAMDISK_USE_LZ4 := true
-- 
