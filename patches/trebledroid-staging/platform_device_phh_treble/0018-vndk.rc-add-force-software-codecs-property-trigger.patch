From 6f506377a3a6e93ee6bfe979007577b7fd6d5a0c Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 14 Jun 2026 23:41:41 +0100
Subject: [PATCH 18/26] vndk.rc: add force software codecs property trigger

When persist.sys.phh.force_sw_codecs=true, disable C2.0 entirely, raise
the default OMX rank defensively, and activate the c2inputsurface fallback.

The matching frameworks/av change drops non-OMX.google. nodes from the codec
role list, so only AOSP software codecs remain selectable. This makes the
toggle match its name for devices whose vendor encoders/decoders crash or
fail to create PersistentInputSurface on GSI builds.

Requires reboot after toggling in TrebleApp.

Relates-to: #33
Relates-to: #94

---
 vndk.rc | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/vndk.rc b/vndk.rc
index a965bb6..ff1612a 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -143,13 +143,14 @@ on property:persist.sys.phh.securize=*
 on property:sys.oem_unlock_allowed=*
     exec u:r:magisk:s0 root root -- /system/bin/resetprop_phh -n sys.oem_unlock_allowed 0
 
-# force software codecs: prefer SW/OMX encoders over broken vendor HW encoders.
-# when enabled, c2inputsurface fallback is also activated so that
-# createPersistentInputSurface uses the AIDL buffer source path.
+# force software codecs: disable C2.0 entirely and hide vendor OMX nodes.
+# when the property is set, C2 is disabled, all vendor (non-OMX.google.)
+# OMX nodes are dropped from the media codec list, and c2inputsurface
+# fallback is activated. this forces AOSP software codecs on GSI builds
+# whose vendor encoders/decoders crash or refuse PersistentInputSurface.
 # uses resetprop_phh -n to patch property area directly before media
 # services read them, matching the timing of CodecFix magisk module.
 on property:persist.sys.phh.force_sw_codecs=true
+    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh -n debug.stagefright.ccodec 0
+    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh -n debug.stagefright.omx_default_rank 512
     exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh -n debug.stagefright.c2inputsurface -1
-    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh -n debug.stagefright.ccodec 1
-    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh -n debug.stagefright.omx_default_rank 0
-    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh -n media.c2.hal.selection hidl
