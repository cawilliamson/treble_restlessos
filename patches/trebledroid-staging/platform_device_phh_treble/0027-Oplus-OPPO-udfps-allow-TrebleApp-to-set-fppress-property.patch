From dcbde97e6d25127ffe05ce2c4c243e8336f166ef Mon Sep 17 00:00:00 2001
From: Doze-off <viniciussadxxx@gmail.com>
Date: Mon, 15 Jun 2026 00:10:00 +0100
Subject: [PATCH 27/27] OPPO UDFPS: allow TrebleApp to set oplus fingerprint press
 property

---
 sepolicy/oppo.te           | 6 ++++++
 sepolicy/property_contexts | 1 +
 2 files changed, 7 insertions(+)

diff --git a/sepolicy/oppo.te b/sepolicy/oppo.te
index e43887c..a62bb63 100644
--- a/sepolicy/oppo.te
+++ b/sepolicy/oppo.te
@@ -8,3 +8,9 @@ allow hal_fingerprint_oplus vendor_default_prop:property_service set;
 get_prop(hal_fingerprint_oplus, default_prop);
 get_prop(system_server, vendor_default_prop);
 
+
+# allow TrebleApp (system_app/platform_app) to report OPPO/Realme/OnePlus
+# fingerprint-on-display press events via sys.phh.oplus.fppress.
+type phh_oplus_prop, property_type;
+set_prop(system_app, phh_oplus_prop);
+set_prop(platform_app, phh_oplus_prop);
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index 185a08b..6caee05 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -1,2 +1,3 @@
 persist.sys.sf.hs_mode         u:object_r:sf_hs_mode_prop:s0
 hwc.exynos.vsync_mode      u:object_r:vendor_hwc_prop:s0
+sys.phh.oplus.fppress    u:object_r:phh_oplus_prop:s0
-- 
2.54.0

