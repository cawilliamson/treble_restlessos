From 6eaada66eac21553df6d3b1e1bdc5265e4c9dad3 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 10 Apr 2026 00:38:55 +0100
Subject: [PATCH 16/29] base: disable C2 input surface by default for GSI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

set debug.stagefright.c2inputsurface=-1 as a build-time default via
PRODUCT_SYSTEM_DEFAULT_PROPERTIES so camera video recording uses the
AIDL GraphicBufferSource fallback instead of the OMX fallback.

on GSI builds, Codec2Client::CreateInputSurface() returns null (disabled
by the NO_C2_INPUT_SURFACE build flag). without c2inputsurface=-1, the
code falls through to the OMX fallback in MediaCodec::CreatePersistentInputSurface,
which has a bug: it creates a PersistentSurface with a null surface pointer
(surface=0x0) because the OMX createInputSurface fills igbp/bufferSource
but never populates the surface variable. the JNI then fails to convert
the null surface to a Java Surface, returns null, and CameraX's
setInputSurface(null) throws 'not a PersistentSurface' — error code 7.

with c2inputsurface=-1, the AIDL GraphicBufferSource fallback is used
instead, which creates a valid PersistentSurface with a non-null surface.
this is what LineageOS-based GSIs do (the property is set in their build
defaults) and is what makes camera video recording work on their builds
but not on GrapheneOS-based GSIs where the property was never actually
set despite the original commit message claiming it was.

add power-mode-monitor.sh: a logcat monitor that runs for 90 seconds
after boot to detect vendor power HAL modes that log 'unknown type'
errors. discovered mode IDs are written to the persist property
persist.sys.phh.blocked_power_modes so the framework can skip them
on subsequent boots.
---
 base.mk               |  2 ++
 power-mode-monitor.sh | 40 ++++++++++++++++++++++++++++++++++++++++
 vndk.rc               |  5 +++++
 3 files changed, 47 insertions(+)
 create mode 100644 power-mode-monitor.sh

diff --git a/base.mk b/base.mk
index 86f179f..432cfb4 100644
--- a/base.mk
+++ b/base.mk
@@ -72,6 +72,7 @@ PRODUCT_COPY_FILES += \
 PRODUCT_COPY_FILES += \
     device/phh/treble/rw-system.sh:system/bin/rw-system.sh \
     device/phh/treble/phh-on-boot.sh:system/bin/phh-on-boot.sh \
+    device/phh/treble/power-mode-monitor.sh:system/bin/power-mode-monitor.sh \
     device/phh/treble/phh-on-data.sh:system/bin/phh-on-data.sh \
     device/phh/treble/phh-prop-handler.sh:system/bin/phh-prop-handler.sh \
     device/phh/treble/fixSPL/getSPL.arm:system/bin/getSPL
@@ -210,6 +211,7 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     debug.fdsan=warn_once \
+    debug.stagefright.c2inputsurface=-1 \
     persist.sys.fflag.override.settings_provider_model=false \
     ro.setupwizard.mode=OPTIONAL \
 
diff --git a/power-mode-monitor.sh b/power-mode-monitor.sh
new file mode 100644
index 0000000..47deea9
--- /dev/null
+++ b/power-mode-monitor.sh
@@ -0,0 +1,40 @@
+#!/system/bin/sh
+# discover unsupported vendor power HAL modes by watching for "unknown type"
+# errors in logcat.  runs briefly after boot and populates a persist property
+# so the framework can skip those modes on subsequent boots.
+# currently only supports MTK devices (mtkpower@impl log format).
+
+# only run on mediatek devices
+hw="$(getprop ro.hardware)"
+if ! echo "$hw" | grep -qi mt; then
+    exit 0
+fi
+PROP="persist.sys.phh.blocked_power_modes"
+TIMEOUT=90
+last_type=""
+
+existing="$(getprop "$PROP")"
+
+# monitor the main log buffer for vendor power HAL errors.
+# the pattern covers MTK's mtkpower@impl and similar vendor tags.
+timeout "$TIMEOUT" logcat -b main -v raw 2>/dev/null | while IFS= read -r line; do
+    case "$line" in
+        *"[setMode] type:"*)
+            last_type="$(echo "$line" | sed -n 's/.*type:\([0-9]*\).*/\1/p')"
+            ;;
+        *"[setMode] unknown"*|*"[setMode] unsupported"*|*"setMode: unknown"*)
+            if [ -n "$last_type" ]; then
+                if ! echo ",$existing," | grep -q ",$last_type,"; then
+                    if [ -z "$existing" ]; then
+                        existing="$last_type"
+                    else
+                        existing="$existing,$last_type"
+                    fi
+                    setprop "$PROP" "$existing"
+                    log -t power-mode-monitor "blocked unsupported power mode $last_type (prop=$existing)"
+                fi
+                last_type=""
+            fi
+            ;;
+    esac
+done
diff --git a/vndk.rc b/vndk.rc
index 9e9f4a5..94c7583 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -16,8 +16,13 @@ service phh_on_boot /system/bin/phh-on-boot.sh
     oneshot
     disabled
 
+service power_mode_monitor /system/bin/power-mode-monitor.sh
+    oneshot
+    disabled
+    seclabel u:r:phhsu_daemon:s0
 on property:sys.boot_completed=1
     start phh_on_boot
+    start power_mode_monitor
     chown wifi system /data/misc/wifi
     chown system wifi /data/misc/wifi/hostapd.conf
 
