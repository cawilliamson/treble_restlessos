From b7575cd5823976c5a2513e4063f052d512884312 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 30 May 2026 20:52:32 +0100
Subject: [PATCH 18/19] Bitmap: tolerate F_SEAL_FUTURE_WRITE EINVAL on legacy kernels
 (< 5.1)

GrapheneOS added F_SEAL_FUTURE_WRITE to the ashmem sealing path in
Bitmap.cpp for memfd-backed blobs. Kernels below Linux 5.1 return
EINVAL because the seal bit is unrecognised, causing every
Bitmap.writeToParcel call to fail with:

  java.lang.RuntimeException: Could not copy bitmap to parcel blob.
  at android.graphics.Bitmap.nativeWriteToParcel(Native Method)

This affects all apps that parcel bitmaps (Chrome, YouTube, Messenger,
media players) on kernel 4.9 devices such as the Galaxy Note 9.

Retry the seal operation without F_SEAL_FUTURE_WRITE when the kernel
rejects it with EINVAL. The write protection is best-effort on these
kernels; skipping it is acceptable for legacy device compatibility.
Kernels >= 5.1 continue to get the full seal set unchanged.

Fixes: #67, #73
---
 libs/hwui/jni/Bitmap.cpp | 31 ++++++++++++++++++++-----------
 1 file changed, 20 insertions(+), 11 deletions(-)

diff --git a/libs/hwui/jni/Bitmap.cpp b/libs/hwui/jni/Bitmap.cpp
index 1d4576156..d5dc1bfb1 100644
--- a/libs/hwui/jni/Bitmap.cpp
+++ b/libs/hwui/jni/Bitmap.cpp
@@ -5,6 +5,7 @@
 #ifdef __linux__
 #include <com_android_graphics_hwui_flags.h>
 #endif
+#include <cerrno>
 #include <fcntl.h>
 #include <hwui/Bitmap.h>
 #include <hwui/Paint.h>
@@ -795,17 +796,25 @@ static binder_status_t writeBlob(AParcel* parcel, uint64_t bitmapId, const SkBit
                 return STATUS_NO_MEMORY;
             }
 
-            if (fcntl(fd, F_ADD_SEALS,
-                      // Disallow growing / shrinking.
-                      F_SEAL_GROW | F_SEAL_SHRINK
-                      // If immutable, disallow writing.
-                      // Use F_SEAL_FUTURE_WRITE instead of F_SEAL_WRITE to work around a bug in
-                      // pre-6.7 kernels.
-                      // There are no writable mappings made prior to this, so both seals are
-                      // functionally equivalent.
-                      // See: b/409846908#comment39
-                      | (immutable ? F_SEAL_FUTURE_WRITE : 0))) {
-                return STATUS_UNKNOWN_ERROR;
+            int seals = F_SEAL_GROW | F_SEAL_SHRINK;
+            if (immutable) {
+                seals |= F_SEAL_FUTURE_WRITE;
+            }
+            if (fcntl(fd, F_ADD_SEALS, seals) < 0) {
+                // F_SEAL_FUTURE_WRITE was added in Linux 5.1. Kernels
+                // below 5.1 (e.g. 4.9 on legacy devices) return EINVAL
+                // because the seal bit is unrecognised. Retry without
+                // F_SEAL_FUTURE_WRITE to keep ashmem blobs working on
+                // these kernels. The write protection is best-effort;
+                // skipping it on legacy kernels is acceptable.
+                if (errno == EINVAL && (seals & F_SEAL_FUTURE_WRITE)) {
+                    if (fcntl(fd, F_ADD_SEALS,
+                              F_SEAL_GROW | F_SEAL_SHRINK) < 0) {
+                        return STATUS_UNKNOWN_ERROR;
+                    }
+                } else {
+                    return STATUS_UNKNOWN_ERROR;
+                }
             }
 
         } else {
