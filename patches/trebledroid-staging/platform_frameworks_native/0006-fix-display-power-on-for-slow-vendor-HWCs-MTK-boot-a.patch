From d4deb430f362ef4fef03285992d5300180ccdfda Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 3 Apr 2026 17:51:51 +0100
Subject: [PATCH 6/6] fix display power-on for slow vendor HWCs (MTK boot and wake)

two related fixes for vendor HWCs that take 300-500ms to complete
setPowerMode transitions (notably MTK devices like the blackview
shark 8 with MT6789):

1. reset HWC state during initializeDisplays():
   the bootloader leaves the display powered (HWC mode 2) but the
   kernel's disable_unused clock framework kills the DSI clocks before
   userspace starts.  SF's internal state defaults to OFF, so
   setPhysicalDisplayPowerMode(OFF) early-returns without reaching
   HWC.  the subsequent ON request sees current=2 requested=2 in
   HWC and takes a no-op shortcut.  fix by sending OFF directly to
   HWC before the normal SF path, resetting its internal state from
   2 to 0 so the ON request triggers a full power-on sequence.

2. defer applyOptimizationPolicy until after HWC power transition:
   applyOptimizationPolicy() disables synthetic vsync when it sees a
   powered-on display.  the current code calls it BEFORE HWC
   setPowerMode, killing synthetic vsync while the hardware is still
   physically off.  on slow HWCs this creates a 300-500ms vsync gap
   where the scheduler has no vsync source, stalling composition and
   leaving the display blank after both boot and wake from sleep.
   move the call to after all power transition branches so synthetic
   vsync remains available during the HWC power-on.
---
 services/surfaceflinger/SurfaceFlinger.cpp | 27 ++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index eb481b1e1c..0639ced8b0 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -6060,7 +6060,15 @@ void SurfaceFlinger::initializeDisplays() {
         ftl::FakeGuard guard(mStateLock);
 
         // In case of a restart, ensure all displays are off.
+        // on some vendor HALs (notably MTK) the bootloader leaves the
+        // display powered (HWC mode 2) but the kernel's disable_unused
+        // clock framework kills the DSI clocks before userspace starts.
+        // SF's internal state defaults to OFF, so the call below would
+        // early-return without reaching HWC.  send OFF directly to HWC
+        // first to reset its internal state, then let the normal ON
+        // loop do a proper full 0->2 power-on through DRM/KMS.
         for (const auto& [id, display] : mPhysicalDisplays) {
+            getHwComposer().setPowerMode(id, hal::PowerMode::OFF);
             setPhysicalDisplayPowerMode(getDisplayDeviceLocked(id), hal::PowerMode::OFF);
         }
 
@@ -6110,10 +6118,11 @@ void SurfaceFlinger::setPhysicalDisplayPowerMode(const sp<DisplayDevice>& displa
     const bool shouldApplyOptimizationPolicy =
             FlagManager::getInstance().disable_synthetic_vsync_for_performance() &&
             FlagManager::getInstance().correct_virtual_display_power_state();
-    if ((isInternalDisplay || FlagManager::getInstance().pacesetter_selection()) &&
-        shouldApplyOptimizationPolicy) {
-        applyOptimizationPolicy(__func__);
-    }
+    // defer applyOptimizationPolicy until after the HWC power transition
+    // completes.  calling it here kills synthetic vsync before HWC has
+    // physically powered on, creating a vsync gap on slow HWCs (MTK
+    // takes 300-500ms) that stalls the scheduler and leaves the display
+    // blank after wake.
 
     if (mScheduler->setDisplayPowerMode(displayId, mode)) {
         onNewPacesetterDisplay();
@@ -6221,6 +6230,16 @@ void SurfaceFlinger::setPhysicalDisplayPowerMode(const sp<DisplayDevice>& displa
         getHwComposer().setPowerMode(displayId, mode);
     }
 
+    // apply optimization policy after the HWC power transition so that
+    // synthetic vsync remains available as a fallback during the (potentially
+    // slow) HWC setPowerMode call.  this is safe for all branches: OFF gets
+    // synthetic vsync enabled after HWC is off, ON gets it disabled after
+    // hardware vsync has been requested.
+    if ((isInternalDisplay || FlagManager::getInstance().pacesetter_selection()) &&
+        shouldApplyOptimizationPolicy) {
+        applyOptimizationPolicy(__func__);
+    }
+
     if (displayId == mFrontInternalDisplayId) {
         mTimeStats->setPowerMode(mode);
         mScheduler->setActiveDisplayPowerModeForRefreshRateStats(mode);
