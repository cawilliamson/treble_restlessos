From b2ee7d1bc77e1a2429f1ef2e91e8618cf261f9fd Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 3 Apr 2026 08:28:09 +0100
Subject: [PATCH 7/7] also defer setDesiredMode calls until boot is finished

the existing guard on initiateDisplayModeChanges blocks mode switches
from being executed, but setDesiredMode still queues a mode change
request during processDisplayAdded.  on multi-rate MTK displays
(e.g. blackview shark 8 at 60/90/144 Hz) SF requests 144Hz during
initializeDisplays, before the display pipeline is stable.  the
queued mode switch triggers DRM atomic commits that fail, vsync
reconfiguration that breaks frame scheduling, and leaves the display
with no composited output (permanent black screen with backlight on).

block setDesiredMode entirely before boot is finished.  the display
stays at whatever mode the bootloader/HWC initialised (typically
60Hz).  after boot completes, DisplayManager re-requests the
preferred mode through the normal setDesiredDisplayModeSpecs path.
---
 services/surfaceflinger/SurfaceFlinger.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 0bfb590b27..203d5ab205 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -1426,6 +1426,19 @@ status_t SurfaceFlinger::getDisplayStats(const sp<IBinder>& displayToken,
 }
 
 void SurfaceFlinger::setDesiredMode(display::DisplayModeRequest desiredMode) {
+    // [GSI] block mode change requests before boot is finished.  on
+    // multi-rate MTK displays (e.g. 60/90/144 Hz) SF tries to switch
+    // to the highest refresh rate during initializeDisplays, before
+    // the display pipeline is stable.  the HWC and DRM driver reject
+    // the mode switch, leaving the display in a broken state with no
+    // frame output.  defer all mode requests to post-boot when
+    // DisplayManager will re-request the preferred mode.
+    if (mBootStage != BootStage::FINISHED) [[unlikely]] {
+        ALOGW("[GSI] setDesiredMode: deferring mode change request "
+              "(boot stage not FINISHED)");
+        return;
+    }
+
     const auto mode = desiredMode.mode;
     const auto displayId = mode.modePtr->getPhysicalDisplayId();
 
