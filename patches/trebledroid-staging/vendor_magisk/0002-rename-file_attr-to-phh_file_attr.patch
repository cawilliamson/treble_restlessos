From a54808e09abb2b898fb43eb220df61dcc705ef93 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 20 Sep 2026 21:23:19 +0100
Subject: [PATCH 2/2] rename file_attr to phh_file_attr

bionic's linux/fs.h uapi header now declares struct file_attr, so the
local copy in utils/files.h needs a distinct tag. Both headers are
included in the same translation unit, which makes the plain duplicate
a hard error.
---
 Magisk/native/jni/utils/file.cpp | 26 +++++++++++++-------------
 Magisk/native/jni/utils/files.h  | 14 +++++++-------
 2 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/Magisk/native/jni/utils/file.cpp b/Magisk/native/jni/utils/file.cpp
index 42f8463..a3c6f57 100644
--- a/Magisk/native/jni/utils/file.cpp
+++ b/Magisk/native/jni/utils/file.cpp
@@ -104,7 +104,7 @@ void mv_f(const char *source, const char *destination) {
 	struct stat st;
 	xlstat(source, &st);
 	int src, dest;
-	struct file_attr a;
+	struct phh_file_attr a;
 
 	if (S_ISDIR(st.st_mode)) {
 		xmkdirs(destination, st.st_mode & 0777);
@@ -127,7 +127,7 @@ void mv_dir(int src, int dest) {
 	struct dirent *entry;
 	DIR *dir;
 	int newsrc, newdest;
-	struct file_attr a;
+	struct phh_file_attr a;
 
 	dir = xfdopendir(src);
 	while ((entry = xreaddir(dir))) {
@@ -156,7 +156,7 @@ void mv_dir(int src, int dest) {
 
 void cp_afc(const char *source, const char *destination) {
 	int src, dest;
-	struct file_attr a;
+	struct phh_file_attr a;
 	getattr(source, &a);
 
 	if (S_ISDIR(a.st.st_mode)) {
@@ -188,7 +188,7 @@ void clone_dir(int src, int dest, bool overwrite) {
 	DIR *dir;
 	int srcfd, destfd, newsrc, newdest;
 	char buf[PATH_MAX];
-	struct file_attr a;
+	struct phh_file_attr a;
 
 	dir = xfdopendir(src);
 	while ((entry = xreaddir(dir))) {
@@ -229,7 +229,7 @@ void link_dir(int src, int dest) {
 	struct dirent *entry;
 	DIR *dir;
 	int newsrc, newdest;
-	struct file_attr a;
+	struct phh_file_attr a;
 
 	dir = xfdopendir(src);
 	while ((entry = xreaddir(dir))) {
@@ -250,7 +250,7 @@ void link_dir(int src, int dest) {
 	}
 }
 
-int getattr(const char *path, struct file_attr *a) {
+int getattr(const char *path, struct phh_file_attr *a) {
 	if (xlstat(path, &a->st) == -1)
 		return -1;
 	char *con;
@@ -261,13 +261,13 @@ int getattr(const char *path, struct file_attr *a) {
 	return 0;
 }
 
-int getattrat(int dirfd, const char *name, struct file_attr *a) {
+int getattrat(int dirfd, const char *name, struct phh_file_attr *a) {
 	char path[4096];
 	fd_pathat(dirfd, name, path, sizeof(path));
 	return getattr(path, a);
 }
 
-int fgetattr(int fd, struct file_attr *a) {
+int fgetattr(int fd, struct phh_file_attr *a) {
 	if (xfstat(fd, &a->st) < 0)
 		return -1;
 	char *con;
@@ -278,7 +278,7 @@ int fgetattr(int fd, struct file_attr *a) {
 	return 0;
 }
 
-int setattr(const char *path, struct file_attr *a) {
+int setattr(const char *path, struct phh_file_attr *a) {
 	if (chmod(path, a->st.st_mode & 0777) < 0)
 		return -1;
 	if (chown(path, a->st.st_uid, a->st.st_gid) < 0)
@@ -288,13 +288,13 @@ int setattr(const char *path, struct file_attr *a) {
 	return 0;
 }
 
-int setattrat(int dirfd, const char *name, struct file_attr *a) {
+int setattrat(int dirfd, const char *name, struct phh_file_attr *a) {
 	char path[4096];
 	fd_pathat(dirfd, name, path, sizeof(path));
 	return setattr(path, a);
 }
 
-int fsetattr(int fd, struct file_attr *a) {
+int fsetattr(int fd, struct phh_file_attr *a) {
 	if (fchmod(fd, a->st.st_mode & 0777) < 0)
 		return -1;
 	if (fchown(fd, a->st.st_uid, a->st.st_gid) < 0)
@@ -305,13 +305,13 @@ int fsetattr(int fd, struct file_attr *a) {
 }
 
 void clone_attr(const char *source, const char *target) {
-	struct file_attr a;
+	struct phh_file_attr a;
 	getattr(source, &a);
 	setattr(target, &a);
 }
 
 void fclone_attr(int sourcefd, int targetfd) {
-	struct file_attr a;
+	struct phh_file_attr a;
 	fgetattr(sourcefd, &a);
 	fsetattr(targetfd, &a);
 }
diff --git a/Magisk/native/jni/utils/files.h b/Magisk/native/jni/utils/files.h
index e38a5e8..f03d3e8 100644
--- a/Magisk/native/jni/utils/files.h
+++ b/Magisk/native/jni/utils/files.h
@@ -3,7 +3,7 @@
 #define do_align(p, a)  (((p) + (a) - 1) / (a) * (a))
 #define align_off(p, a) (do_align(p, a) - (p))
 
-struct file_attr {
+struct phh_file_attr {
 	struct stat st;
 	char con[128];
 };
@@ -20,12 +20,12 @@ void mv_f(const char *source, const char *destination);
 void mv_dir(int src, int dest);
 void cp_afc(const char *source, const char *destination);
 void link_dir(int src, int dest);
-int getattr(const char *path, struct file_attr *a);
-int getattrat(int dirfd, const char *name, struct file_attr *a);
-int fgetattr(int fd, struct file_attr *a);
-int setattr(const char *path, struct file_attr *a);
-int setattrat(int dirfd, const char *name, struct file_attr *a);
-int fsetattr(int fd, struct file_attr *a);
+int getattr(const char *path, struct phh_file_attr *a);
+int getattrat(int dirfd, const char *name, struct phh_file_attr *a);
+int fgetattr(int fd, struct phh_file_attr *a);
+int setattr(const char *path, struct phh_file_attr *a);
+int setattrat(int dirfd, const char *name, struct phh_file_attr *a);
+int fsetattr(int fd, struct phh_file_attr *a);
 void fclone_attr(int sourcefd, int targetfd);
 void clone_attr(const char *source, const char *target);
 void fd_full_read(int fd, void **buf, size_t *size);
-- 
2.55.0

