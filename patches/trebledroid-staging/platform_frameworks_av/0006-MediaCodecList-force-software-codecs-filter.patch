From 686296dbcaef6aa95ed73b4ed1963910b400634b Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 20 Jun 2026 16:46:16 +0100
Subject: [PATCH] MediaCodecList: force software codecs by filtering vendor HW
 from selection

the force_sw_codecs toggle is meant to make the framework use AOSP software
codecs instead of broken vendor hardware codecs on GSI builds. the previous
implementation disabled C2 entirely (debug.stagefright.ccodec=0), which was
self-defeating because the AOSP software encoders such as c2.android.avc.encoder
are themselves C2 components and fail to allocate when C2 is disabled
(createComponent -> OMITTED), leaving no usable encoder.

instead, keep C2 enabled and filter at codec-selection time: when
persist.sys.phh.force_sw_codecs is set, findMatchingCodecs() drops every
non-software codec (vendor OMX HW and vendor C2 HW) using the existing
isSoftwareCodec() helper, so only OMX.google.* / c2.android.* remain
selectable. this covers both the OMX and C2 vendor paths in one place and
complements the OmxStore vendor-node filter.

Relates-to: #33
Relates-to: #94
---
 media/libstagefright/MediaCodecList.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/media/libstagefright/MediaCodecList.cpp b/media/libstagefright/MediaCodecList.cpp
index daad2c6..111ac75 100644
--- a/media/libstagefright/MediaCodecList.cpp
+++ b/media/libstagefright/MediaCodecList.cpp
@@ -435,6 +435,18 @@ void MediaCodecList::findMatchingCodecs(
             continue;
         }
 
+        // force software codecs: when persist.sys.phh.force_sw_codecs is set,
+        // drop every non-software codec (vendor OMX HW and vendor C2 HW) so only
+        // AOSP software codecs (OMX.google.* / c2.android.*) remain selectable.
+        // C2 is intentionally left enabled, since the AOSP software encoders are
+        // themselves C2 components and would fail to allocate if C2 were disabled.
+        if (property_get_bool("persist.sys.phh.force_sw_codecs", false)
+                && !isSoftwareCodec(componentName)) {
+            ALOGV("force_sw_codecs: skipping non-SW codec '%s'",
+                  componentName.c_str());
+            continue;
+        }
+
         matches->push(componentName);
         ALOGV("matching '%s'", componentName.c_str());
     }
