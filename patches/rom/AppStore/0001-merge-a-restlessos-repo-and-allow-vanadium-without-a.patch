 package app.grapheneos.apps.core;
 
+import android.util.Log
 import app.grapheneos.apps.BuildConfig
 import app.grapheneos.apps.util.AtomicFile2
 import app.grapheneos.apps.util.openConnection
@@ -20,45 +21,76 @@ import java.nio.charset.StandardCharsets.UTF_8
 import java.security.GeneralSecurityException
 
 private const val METADATA_VERSION = 1
-private const val CACHE_FILE_VERSION = 1
+private const val CACHE_FILE_VERSION = 2
 
 private const val MIN_TIMESTAMP = 1_770_000_000L
 private const val PUBLIC_KEY = BuildConfig.REPO_PUBLIC_KEY
 private const val KEY_VERSION = BuildConfig.REPO_KEY_VERSION
 
+private const val RESTLESS_REPO_BASE_URL = BuildConfig.RESTLESS_REPO_BASE_URL
+private const val RESTLESS_PUBLIC_KEY = BuildConfig.RESTLESS_REPO_PUBLIC_KEY
+private const val RESTLESS_KEY_VERSION = BuildConfig.RESTLESS_REPO_KEY_VERSION
+private const val RESTLESS_MIN_TIMESTAMP = 0L
+
+private val restlessRepoEnabled = RESTLESS_REPO_BASE_URL.isNotEmpty() && RESTLESS_PUBLIC_KEY.isNotEmpty()
+
 private val cacheFile = AtomicFile2("repo")
 
+private class RepoData(val eTag: String, val json: ByteArray) {
+    val timestamp: Long = JSONObject(json.toString(UTF_8)).getLong("time")
+}
+
+private class RepoSource(val baseUrl: String, val publicKey: String, val keyVersion: String,
+                         val minTimestamp: Long) {
+    val url = "$baseUrl/metadata.$METADATA_VERSION.$keyVersion.sjson"
+}
+
+private val mainSource = RepoSource(REPO_BASE_URL, PUBLIC_KEY, KEY_VERSION, MIN_TIMESTAMP)
+private val restlessSource = RepoSource(RESTLESS_REPO_BASE_URL, RESTLESS_PUBLIC_KEY,
+    RESTLESS_KEY_VERSION, RESTLESS_MIN_TIMESTAMP)
+
 fun fetchRepo(currentRepo: Repo): Repo {
-    val url = "$REPO_BASE_URL/metadata.$METADATA_VERSION.$KEY_VERSION.sjson"
-
-    return if (!currentRepo.isDummy) {
-        openConnection(null, url) {
-            setRequestProperty("If-None-Match", currentRepo.eTag)
-        }.use { conn ->
-            when (conn.v.responseCode) {
-                HTTP_OK -> {
-                    fetchInner(conn.v,
-                        // in case MIN_TIMESTAMP was updated
-                        maxOf(currentRepo.timestamp, MIN_TIMESTAMP))
-                }
-                HTTP_NOT_MODIFIED -> {
-                    currentRepo
-                }
-                else -> throwResponseCodeException(conn.v)
-            }
+    val cached = if (currentRepo.isDummy) null else readCache()
+
+    val main = fetchSource(mainSource, cached?.first)
+
+    val restless = if (restlessRepoEnabled) {
+        try {
+            fetchSource(restlessSource, cached?.second)
+        } catch (e: Exception) {
+            Log.w("RepoRetriever", "unable to fetch restlessos repo", e)
+            cached?.second
         }
     } else {
-        openConnection(null, url, {}).use { conn ->
-            if (conn.v.responseCode != HTTP_OK) {
-                throwResponseCodeException(conn.v)
-            }
+        null
+    }
+
+    if (cached != null && main === cached.first && restless === cached.second) {
+        return currentRepo
+    }
+
+    val repo = buildRepo(main, restless)
+    writeCache(main, restless)
+    return repo
+}
 
-            fetchInner(conn.v, MIN_TIMESTAMP)
+private fun fetchSource(source: RepoSource, current: RepoData?): RepoData {
+    openConnection(null, source.url) {
+        if (current != null) {
+            setRequestProperty("If-None-Match", current.eTag)
+        }
+    }.use { conn ->
+        return when (conn.v.responseCode) {
+            HTTP_OK -> fetchInner(conn.v, source,
+                // in case minTimestamp was updated
+                maxOf(current?.timestamp ?: 0L, source.minTimestamp))
+            HTTP_NOT_MODIFIED -> current ?: throwResponseCodeException(conn.v)
+            else -> throwResponseCodeException(conn.v)
         }
     }
 }
 
-private fun fetchInner(conn: HttpURLConnection, minTimestamp: Long): Repo {
+private fun fetchInner(conn: HttpURLConnection, source: RepoSource, minTimestamp: Long): RepoData {
     val eTag = conn.getHeaderField("ETag") ?: ""
 
     val unverifiedBytes = conn.inputStream.use {
@@ -76,41 +108,79 @@ private fun fetchInner(conn: HttpURLConnection, minTimestamp: Long): Repo {
         unverifiedBytes.copyOfRange(unverifiedBytes.size - 101, unverifiedBytes.size - 1)
             .toString(UTF_8)
 
-    FileVerifier(PUBLIC_KEY).verifySignature(unverifiedJson, signature)
+    FileVerifier(source.publicKey).verifySignature(unverifiedJson, signature)
 
-    val verifiedJson = unverifiedJson
+    val data = RepoData(eTag, unverifiedJson)
 
-    val repo = Repo(JSONObject(verifiedJson.toString(UTF_8)), eTag)
-
-    if (repo.timestamp < minTimestamp) {
+    if (data.timestamp < minTimestamp) {
         throw GeneralSecurityException("repo downgrade")
     }
 
-    val baos = ByteArrayOutputStream(verifiedJson.size + 100)
+    return data
+}
+
+// packages of the restlessos repo are added only if the main repo doesn't have them
+private fun buildRepo(main: RepoData, restless: RepoData?): Repo {
+    val json = JSONObject(main.json.toString(UTF_8))
+    val packages = json.getJSONObject("packages")
+
+    for (name in packages.keys()) {
+        packages.getJSONObject(name).remove("baseUrl")
+    }
+
+    if (restless != null) {
+        val restlessPackages = JSONObject(restless.json.toString(UTF_8)).getJSONObject("packages")
+        for (name in restlessPackages.keys()) {
+            if (packages.has(name)) {
+                continue
+            }
+            val pkg = restlessPackages.getJSONObject(name)
+            pkg.put("baseUrl", RESTLESS_REPO_BASE_URL)
+            pkg.put("source", PackageSource.RestlessOS.name)
+            packages.put(name, pkg)
+        }
+    }
+
+    return Repo(json, main.eTag)
+}
+
+private fun writeCache(main: RepoData, restless: RepoData?) {
+    val baos = ByteArrayOutputStream(main.json.size + (restless?.json?.size ?: 0) + 200)
     DataOutputStream(baos).let {
         it.writeInt(CACHE_FILE_VERSION)
-        it.writeString(eTag)
-        it.writeByteArray(verifiedJson)
+        it.writeString(main.eTag)
+        it.writeByteArray(main.json)
+        it.writeBoolean(restless != null)
+        if (restless != null) {
+            it.writeString(restless.eTag)
+            it.writeByteArray(restless.json)
+        }
     }
 
     cacheFile.write(baos.toByteArray())
-
-    return repo
 }
 
-fun getCachedRepo(): Repo {
-    val bytes = cacheFile.read() ?: return createDummy()
+private fun readCache(): Pair<RepoData, RepoData?>? {
+    val bytes = cacheFile.read() ?: return null
 
     val dis = DataInputStream(ByteArrayInputStream(bytes))
     val fileVersion = dis.readInt()
     check(fileVersion <= CACHE_FILE_VERSION)
 
-    val eTag = dis.readString()
-
-    val json = dis.readByteArray().toString(UTF_8)
+    val main = RepoData(dis.readString(), dis.readByteArray())
+    val restless = if (fileVersion >= 2 && dis.readBoolean()) {
+        RepoData(dis.readString(), dis.readByteArray())
+    } else {
+        null
+    }
     check(dis.available() == 0)
 
-    return Repo(JSONObject(json), eTag)
+    return Pair(main, restless)
+}
+
+fun getCachedRepo(): Repo {
+    val cached = readCache() ?: return createDummy()
+    return buildRepo(cached.first, cached.second)
 }
 
