@@ -573,7 +581,11 @@ private fun checkStaticDeps(json: JSONObject, dependentManifestPkgName: String,
             // there's currently no certificate checks for static dependencies, require them to
             // be a system package instead, unless it's our own package
             val enforceSystemPkg = dep.lhs != selfPkgName
-            if (!checkPackageDep(dep, dependentManifestPkgName, repo, enforceSystemPkg)) {
+            // gates updates of a preinstalled package on its preinstalled version; the package is
+            // not preinstalled on restlessos, so allow installing it as a regular app
+            val isSelfDep = dep.lhs == dependentManifestPkgName
+            if (!checkPackageDep(dep, dependentManifestPkgName, repo,
+                    enforceSystemPkg && !isSelfDep, allowMissing = isSelfDep)) {
                 return false
             }
         }
@@ -588,10 +600,11 @@ private fun checkSystemFeatureDep(dep: ComplexDependency): Boolean {
 }
 
 private fun checkPackageDep(dep: ComplexDependency, dependentManifestPkgName: String,
-                            repo: Repo, enforceSystemPkg: Boolean = false): Boolean {
+                            repo: Repo, enforceSystemPkg: Boolean = false,
+                            allowMissing: Boolean = false): Boolean {
     val manifestPackageName = dep.lhs
     val packageName = repo.translateManifestPackageName(manifestPackageName)
-    val pi = pkgManager.getPackageInfoOrNull(packageName) ?: return false
+    val pi = pkgManager.getPackageInfoOrNull(packageName) ?: return allowMissing
     val appInfo = pi.applicationInfo ?: return false
     if (!appInfo.enabled && manifestPackageName != dependentManifestPkgName) {
         return false
diff --git a/app/src/main/java/app/grapheneos/apps/core/RepoRetriever.kt b/app/src/main/java/app/grapheneos/apps/core/RepoRetriever.kt
