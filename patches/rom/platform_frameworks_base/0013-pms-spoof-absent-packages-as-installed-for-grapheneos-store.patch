From a5645ca7f07b7041acbc31739bdf9fd12b3013aa Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 10 Oct 2026 14:17:14 +0100
Subject: [PATCH 13/21] pms: spoof absent packages as installed for the grapheneos store

the store drops a package from its repo view when a self-referential
static dependency (pkg >= version per the store metadata) is
unsatisfied, and that check requires the package to be installed as a
system package. on images shipping without e.g. the vanadium apk this
hides the entry and the store never offers the initial install, and
once the store installed it as a user app the entry disappears again
and updates stop.

report a minimal installed-package state to the store uid alone for
the packages on the spoof list while they are absent, so the entries
stay listed and the store proceeds with a normal install, and flag the
real package as a system one to the store once it is installed.
---
 .../com/android/server/pm/ComputerEngine.java | 58 ++++++++++++++++++-
 1 file changed, 57 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/pm/ComputerEngine.java b/services/core/java/com/android/server/pm/ComputerEngine.java
index bf15b7c5e..6b4571f77 100644
--- a/services/core/java/com/android/server/pm/ComputerEngine.java
+++ b/services/core/java/com/android/server/pm/ComputerEngine.java
@@ -179,6 +179,7 @@ import java.util.Arrays;
 import java.util.Collections;
 import java.util.Comparator;
 import java.util.List;
+import java.util.Map;
 import java.util.Objects;
 import java.util.Optional;
 import java.util.Set;
@@ -1714,7 +1715,15 @@ public class ComputerEngine implements Computer {
                 return null;
             }
 
-            return generatePackageInfo(ps, flags, userId);
+            final PackageInfo pi = generatePackageInfo(ps, flags, userId);
+            maybeMarkSpoofedPackageSystem(pi, filterCallingUid);
+            return pi;
+        }
+        if (p == null) {
+            PackageInfo spoofed = maybeGetSpoofedPackageInfo(packageName, filterCallingUid);
+            if (spoofed != null) {
+                return spoofed;
+            }
         }
         if (!matchFactoryOnly && (flags & (MATCH_KNOWN_PACKAGES | MATCH_ARCHIVED_PACKAGES)) != 0) {
             final PackageStateInternal ps = mSettings.getPackage(packageName);
@@ -1730,6 +1739,53 @@ public class ComputerEngine implements Computer {
         return null;
     }
 
+    // RestlessOS: the grapheneos store drops a package from its repo view when a
+    // self-referential static dependency (pkg >= version, declared in the store
+    // metadata) is unsatisfied, and that check requires the package to be
+    // installed as a system package. for packages stripped from the image to
+    // save space this hides the entry entirely, so the store never offers the
+    // initial install, and once installed as a user app it stops offering
+    // updates. the packages below are reported to the store as minimal
+    // installed packages while absent and flagged as system once installed.
+    private static final String GOS_STORE_PKG = "app.grapheneos.apps";
+    private static final Map<String, Long> SPOOFED_STORE_PACKAGES = Map.of(
+            "app.vanadium.browser", 548106100L);
+
+    private PackageInfo maybeGetSpoofedPackageInfo(String packageName, int filterCallingUid) {
+        if (packageName == null) {
+            return null;
+        }
+        final Long version = SPOOFED_STORE_PACKAGES.get(packageName);
+        if (version == null || !isGosStoreCaller(filterCallingUid)) {
+            return null;
+        }
+        final PackageInfo pi = new PackageInfo();
+        pi.packageName = packageName;
+        pi.setLongVersionCode(version);
+        final ApplicationInfo ai = new ApplicationInfo();
+        ai.packageName = packageName;
+        ai.flags |= ApplicationInfo.FLAG_SYSTEM;
+        ai.enabled = true;
+        pi.applicationInfo = ai;
+        return pi;
+    }
+
+    private void maybeMarkSpoofedPackageSystem(PackageInfo pi, int filterCallingUid) {
+        if (pi == null || pi.applicationInfo == null
+                || !SPOOFED_STORE_PACKAGES.containsKey(pi.packageName)
+                || !isGosStoreCaller(filterCallingUid)) {
+            return;
+        }
+        pi.applicationInfo = new ApplicationInfo(pi.applicationInfo);
+        pi.applicationInfo.flags |= ApplicationInfo.FLAG_SYSTEM;
+    }
+
+    private boolean isGosStoreCaller(int filterCallingUid) {
+        final var storeState = mSettings.getPackage(GOS_STORE_PKG);
+        return storeState != null
+                && UserHandle.getAppId(filterCallingUid) == storeState.getAppId();
+    }
+
     @Override
     public String[] getAllAvailablePackageNames() {
         return mPackages.keySet().toArray(new String[0]);
