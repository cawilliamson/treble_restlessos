From 564c6f6f04d9dfad426cb5686f8acbf396365852 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 12 Oct 2026 19:58:05 +0100
Subject: [PATCH 16/21] layoutinflater: degrade gracefully when included layout params are unusable

parseInclude falls back to the included layout's own attributes when the
include tag carries no usable layout_ attributes, but treats a failure
there as fatal. on vendors whose resource overlays leave a dimen
reference resolving to a non-dimension (seen on a galaxy note 9 one ui 5
vendor: systemui crash-looping in
androidx.constraintlayout.widget.ConstraintLayout.generateLayoutParams
with "You must supply a layout_height" while inflating
super_notification_shade -> status_bar_expanded -> keyguard_status_bar)
this aborts the entire shade inflate and crash-loops systemui forever.

mirror the existing include-tag fallback: catch the runtime exception,
log it, and degrade to the parent's default layout params so the window
still inflates.
---
 core/java/android/view/LayoutInflater.java | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/core/java/android/view/LayoutInflater.java b/core/java/android/view/LayoutInflater.java
index f91ef7416..fc82e830b 100644
--- a/core/java/android/view/LayoutInflater.java
+++ b/core/java/android/view/LayoutInflater.java
@@ -1140,7 +1140,17 @@ public abstract class LayoutInflater {
                     // Ignore, just fail over to child attrs.
                 }
                 if (params == null) {
-                    params = group.generateLayoutParams(context, childAttrs);
+                    try {
+                        params = group.generateLayoutParams(context, childAttrs);
+                    } catch (RuntimeException e) {
+                        // vendor resource overlays can leave a dimen reference
+                        // resolving to a non-dimension, which previously aborted
+                        // the whole inflate and crash-looped the caller (seen as
+                        // a systemui bootloop on some vendor builds). degrade to
+                        // the parent defaults instead of dying here.
+                        android.util.Log.wtf(TAG, "include params unusable, falling back to defaults", e);
+                        params = group.generateDefaultLayoutParams();
+                    }
                 }
                 view.setLayoutParams(params);
 
