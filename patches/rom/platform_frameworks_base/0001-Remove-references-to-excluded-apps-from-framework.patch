 core/res/res/values/config_ext.xml            |  2 --
 data/etc/hiddenapi-package-whitelist.xml      |  1 -
 data/etc/privapp-permissions-platform.xml     |  4 ----
 .../android/server/ext/SystemServerExt.java   | 23 -------------------
 .../DefaultPermissionGrantPolicy.java         |  1 -
 6 files changed, 32 deletions(-)

