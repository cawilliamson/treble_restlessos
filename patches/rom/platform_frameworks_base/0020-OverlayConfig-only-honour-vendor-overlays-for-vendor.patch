+    private static boolean isVendorPolicy(@NonNull String policy) {
+        return OverlayPartition.POLICY_VENDOR.equals(policy)
+                || OverlayPartition.POLICY_ODM.equals(policy)
+                || OverlayPartition.POLICY_OEM.equals(policy);
+    }
+
+    private static void removeUnsupportedVendorOverlays(
+            @NonNull ArrayList<ParsedConfiguration> overlays,
+            @NonNull List<OverlayPartition> partitions,
+            @Nullable Map<String, ParsedOverlayInfo> packageManagerOverlayInfos,
+            @Nullable PackageProvider packageProvider) {
+        final HashSet<String> vendorPackages = new HashSet<>();
+        if (packageProvider != null) {
+            packageProvider.forEachPackage((PackageProvider.Package p, Boolean isSystem,
+                    @Nullable File preInstalledApexPath) -> {
+                final File path = new File(p.getBaseApkPath());
+                for (int i = 0, n = partitions.size(); i < n; i++) {
+                    final OverlayPartition partition = partitions.get(i);
+                    if (isVendorPolicy(partition.policy) && partition.containsFile(path)) {
+                        vendorPackages.add(p.getPackageName());
+                        return;
+                    }
+                }
+            });
+        }
+
+        for (int i = overlays.size() - 1; i >= 0; i--) {
+            final ParsedConfiguration config = overlays.get(i);
+            if (!isVendorPolicy(config.policy)) {
+                continue;
+            }
+            ParsedOverlayInfo info = config.parsedInfo;
+            if (info == null && packageManagerOverlayInfos != null) {
+                info = packageManagerOverlayInfos.get(config.packageName);
+            }
+            if (info == null || VENDOR_OVERLAY_TARGETS.contains(info.targetPackageName)
+                    || vendorPackages.contains(info.targetPackageName)) {
+                continue;
+            }
+            Log.i(TAG, "ignoring vendor overlay " + config.packageName + " targeting "
+                    + info.targetPackageName);
+            overlays.remove(i);
+        }
+    }
+
