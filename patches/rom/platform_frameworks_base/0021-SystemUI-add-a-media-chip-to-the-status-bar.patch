+/** Compact media controls: artwork, title, seek bar and previous / play-pause / next buttons. */
+@Composable
+fun MediaChipPopup(
+    session: StateFlow<MediaChipSessionModel?>,
+    bgDispatcher: CoroutineDispatcher,
+    onOpenApp: (PendingIntent) -> Unit,
+    onDismiss: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val current by session.collectAsStateWithLifecycle()
+    val media = current
+    if (media == null) {
+        LaunchedEffect(Unit) { onDismiss() }
+        return
+    }
+
+    Column(
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+        modifier = modifier.fillMaxWidth().padding(start = 20.dp, top = 20.dp, end = 20.dp),
+    ) {
+        Header(media, bgDispatcher, onOpenApp)
+        SeekBar(media)
+        Controls(media, bgDispatcher)
+    }
+}
+
+@Composable
+private fun Header(
+    media: MediaChipSessionModel,
+    bgDispatcher: CoroutineDispatcher,
+    onOpenApp: (PendingIntent) -> Unit,
+) {
+    val context = LocalContext.current
+    val sessionArtwork = media.artworkBitmap
+    val pipelineArtwork = media.data.artwork
+    val artwork by
+        produceState<Drawable?>(initialValue = null, sessionArtwork, pipelineArtwork) {
+            value =
+                if (sessionArtwork != null) {
+                    BitmapDrawable(context.resources, sessionArtwork)
+                } else {
+                    withContext(bgDispatcher) { pipelineArtwork?.loadDrawable(context) }
+                }
+        }
+    val clickIntent = media.data.clickIntent
+
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(16.dp),
+        modifier =
+            Modifier.fillMaxWidth()
+                .clip(RoundedCornerShape(16.dp))
+                .then(
+                    if (clickIntent != null) {
+                        Modifier.clickable { onOpenApp(clickIntent) }
+                    } else {
+                        Modifier
+                    }
+                ),
+    ) {
+        Box(
+            contentAlignment = Alignment.Center,
+            modifier =
+                Modifier.size(64.dp)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(MaterialTheme.colorScheme.surfaceContainerHighest),
+        ) {
+            val art = artwork
+            if (art != null) {
+                Image(
+                    painter = rememberDrawablePainter(art),
+                    contentDescription = null,
+                    contentScale = ContentScale.Crop,
+                    modifier = Modifier.fillMaxSize(),
+                )
+            } else {
+                Icon(
+                    painter = painterResource(R.drawable.ic_music_note),
+                    contentDescription = null,
+                    tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.size(28.dp),
+                )
+            }
+        }
+        Column(modifier = Modifier.weight(1f)) {
+            media.data.app?.let {
+                Text(
+                    text = it,
+                    style = MaterialTheme.typography.labelMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+            Text(
+                text = media.title.orEmpty(),
+                style = MaterialTheme.typography.titleMedium,
+                color = MaterialTheme.colorScheme.onSurface,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            media.artist?.let {
+                Text(
+                    text = it,
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun SeekBar(media: MediaChipSessionModel) {
+    val state = media.playbackState ?: return
+    val durationMs = media.durationMs
+    if (durationMs <= 0L) return
+
+    val isPlaying = state.state == PlaybackState.STATE_PLAYING
+    val now by
+        produceState(SystemClock.elapsedRealtime(), state) {
+            value = SystemClock.elapsedRealtime()
+            while (isPlaying) {
+                delay(POSITION_TICK_MS)
+                value = SystemClock.elapsedRealtime()
+            }
+        }
+    var dragFraction by remember { mutableStateOf<Float?>(null) }
+    // Hold a finished seek until the session reports the new position.
+    var seekTargetMs by remember(state) { mutableStateOf<Long?>(null) }
+
+    val positionMs = seekTargetMs ?: state.positionAt(now, durationMs)
+    val fraction = dragFraction ?: (positionMs.toFloat() / durationMs)
+    val elapsedText = formatTime((fraction * durationMs).toLong())
+    val totalText = formatTime(durationMs)
+    val description =
+        stringResource(R.string.controls_media_seekbar_description, elapsedText, totalText)
+
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        TimeText(elapsedText)
+        Slider(
+            value = fraction.coerceIn(0f, 1f),
+            onValueChange = { dragFraction = it },
+            onValueChangeFinished = {
+                dragFraction?.let {
+                    val target = (it * durationMs).toLong()
+                    media.controller?.transportControls?.seekTo(target)
+                    seekTargetMs = target
+                }
+                dragFraction = null
+            },
+            enabled = (state.actions and PlaybackState.ACTION_SEEK_TO) != 0L,
+            modifier = Modifier.weight(1f).semantics { stateDescription = description },
+        )
+        TimeText(totalText)
+    }
+}
+
+@Composable
+private fun TimeText(text: String) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.labelMedium,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        modifier = Modifier.widthIn(min = 36.dp),
+    )
+}
+
+@Composable
+private fun Controls(media: MediaChipSessionModel, bgDispatcher: CoroutineDispatcher) {
+    val context = LocalContext.current
+    val pipelineActions = media.data.semanticActions
+    val controller = media.controller
+    val playbackState = media.playbackState
+    // The carousel rebuilds these actions only after its own copy of the playback state updates,
+    // so build them from the session as soon as its state changes.
+    val actions by
+        produceState<MediaButton?>(pipelineActions, pipelineActions, controller, playbackState) {
+            if (pipelineActions != null && controller != null && playbackState != null) {
+                value =
+                    withContext(bgDispatcher) {
+                        createActionsFromState(
+                            context,
+                            media.data.packageName,
+                            controller,
+                            media.data.userId,
+                        )
+                    } ?: pipelineActions
+            }
+        }
+    val buttons = actions ?: return
+
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(24.dp, Alignment.CenterHorizontally),
+        modifier = Modifier.fillMaxWidth().padding(bottom = 12.dp),
+    ) {
+        buttons.prevOrCustom?.let { ActionButton(it) }
+        PlayPauseButton(media, buttons.playOrPause)
+        buttons.nextOrCustom?.let { ActionButton(it) }
+    }
+}
+
+/**
+ * The play / pause button. It stays in place with its own icon, since the session's action is
+ * missing for a moment on song changes and shows a progress drawable in the accent color while
+ * buffering, which the button background hides.
+ */
+@Composable
+private fun PlayPauseButton(media: MediaChipSessionModel, fallback: MediaAction?) {
+    val isPlaying = media.isPlaying == true
+    val controls = media.controller?.transportControls
+    val onClick: (() -> Unit)? =
+        if (controls != null) {
+            { if (isPlaying) controls.pause() else controls.play() }
+        } else {
+            fallback?.action?.let { action -> { action.run() } }
+        }
+    Surface(
+        onClick = { onClick?.invoke() },
+        enabled = onClick != null,
+        shape = RoundedCornerShape(16.dp),
+        color = MaterialTheme.colorScheme.primary,
+        contentColor = MaterialTheme.colorScheme.onPrimary,
+        modifier = Modifier.size(width = 64.dp, height = 48.dp),
+    ) {
+        Box(contentAlignment = Alignment.Center) {
+            Icon(
+                painter =
+                    painterResource(
+                        if (isPlaying) R.drawable.ic_media_chip_paused
+                        else R.drawable.ic_media_chip_play
+                    ),
+                contentDescription =
+                    stringResource(
+                        if (isPlaying) R.string.controls_media_button_pause
+                        else R.string.controls_media_button_play
+                    ),
+                modifier = Modifier.size(24.dp),
+            )
+        }
+    }
+}
+
+@Composable
+private fun ActionButton(action: MediaAction) {
+    IconButton(
+        onClick = { action.action?.run() },
+        enabled = action.action != null,
+        modifier = Modifier.size(48.dp),
+    ) {
+        ActionIcon(action)
+    }
+}
+
+@Composable
+private fun ActionIcon(action: MediaAction) {
+    val icon = action.icon ?: return
+    // The media card draws the same drawable, so use a separate copy to keep its callback intact.
+    val copy = remember(icon) { icon.constantState?.newDrawable()?.mutate() ?: icon }
+    Icon(
+        painter = rememberDrawablePainter(copy),
+        contentDescription = action.contentDescription?.toString(),
+        modifier = Modifier.size(24.dp),
+    )
+}
+
+private fun PlaybackState.positionAt(nowElapsedMs: Long, durationMs: Long): Long {
+    var positionMs = position
+    if (state == PlaybackState.STATE_PLAYING && lastPositionUpdateTime > 0L) {
+        positionMs += (playbackSpeed * (nowElapsedMs - lastPositionUpdateTime)).toLong()
+    }
+    return positionMs.coerceIn(0L, durationMs)
+}
+
+private fun formatTime(millis: Long): String = DateUtils.formatElapsedTime(millis / 1000)
+
+private const val POSITION_TICK_MS = 1000L
