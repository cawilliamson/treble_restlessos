 libc/bionic/heap_tagging.cpp      |  14 +--
 libc/bionic/libc_init_dynamic.cpp |  86 ----------------
 libc/bionic/libc_init_mte.cpp     |  45 ++++----
 libc/bionic/malloc_common.h       |  20 ----
 libc/bionic/pthread_create.cpp    | 164 +++++++++++++++++++-----------
 libc/bionic/pthread_internal.h    |  12 +--
 libc/libc.map.txt                 |   1 -
 8 files changed, 128 insertions(+), 231 deletions(-)

