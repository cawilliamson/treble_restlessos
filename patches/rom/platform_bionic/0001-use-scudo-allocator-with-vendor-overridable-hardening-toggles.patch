+// Check once whether GrapheneOS stack hardening is enabled.
+static bool __gos_stack_hardening_enabled() {
+  static int cached = -1;
+  if (cached == -1) {
+    char value[PROP_VALUE_MAX] = {};
+    __system_property_get("persist.sys.phh.hardening.stack_hardening", value);
+    cached = (strcmp(value, "true") == 0) ? 1 : 0;
+  }
+  return cached == 1;
+}
