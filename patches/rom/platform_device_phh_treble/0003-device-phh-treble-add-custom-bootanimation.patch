diff --git a/bootanimation/Android.mk b/bootanimation/Android.mk
new file mode 100644
index 0000000..739f068
--- /dev/null
+++ b/bootanimation/Android.mk
@@ -0,0 +1,29 @@
+# custom boot animation for restlessos
+# builds bootanimation.zip from source frames at build time and installs it
+# to /system/media, where the bootanimation binary reads it by default.
+# the trebledroid dynamic-resize patch (0025) scales the animation to the
+# device screen, so a single 448x605 source set covers all targets.
+
+local_dir := $(LOCAL_PATH)
+# generate the archive as bootanimation.src.zip under the module intermediates
+# dir, then let BUILD_PREBUILT copy it to bootanimation.zip. generating straight
+# to bootanimation.zip collides with the prebuilt copy rule that targets the
+# same path, producing "overriding commands for target" kati failures.
+generated_zip := $(call intermediates-dir-for,ETC,bootanimation.zip)/bootanimation.src.zip
+
+source_files := \
+    $(local_dir)/desc.txt \
+    $(shell find $(local_dir)/part0 $(local_dir)/part1 $(local_dir)/part2 -type f 2>/dev/null)
+
+$(generated_zip): $(source_files) $(LOCAL_PATH)/Android.mk
+	@echo "Generate bootanimation.zip from source frames"
+	$(hide) rm -f $@
+	$(hide) mkdir -p $(dir $@)
+	$(hide) cd $(local_dir) && zip -q -X -0 -r -D $(abspath $@) desc.txt part0 part1 part2
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := bootanimation.zip
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/media
+LOCAL_PREBUILT_MODULE_FILE := $(generated_zip)
+include $(BUILD_PREBUILT)
\ No newline at end of file
